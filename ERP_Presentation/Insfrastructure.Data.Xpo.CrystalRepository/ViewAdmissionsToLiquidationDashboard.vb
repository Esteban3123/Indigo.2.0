    ''' <summary>
    ''' Propiedad calculada para obtener el tercero efectivo a validar para mayoría de edad.
    ''' Prioridad: 1) Responsable Cuota Paciente, 2) Tercero del Folio (particulares), 3) Tercero Paciente
    ''' </summary>
    <NonPersistent()>
    Public ReadOnly Property ThirdPartyIdForAgeValidation As Integer?
        Get
            'Responsable Cuota Paciente
            If PatientQuotaResponsibleThirdPartyId.HasValue AndAlso PatientQuotaResponsibleThirdPartyId.Value > 0 Then
                Return PatientQuotaResponsibleThirdPartyId.Value
            End If
            'Tercero del folio (para particulares FolioType = 3)
            If FolioType = 3 AndAlso ThirdPartyId.HasValue AndAlso ThirdPartyId.Value > 0 Then
                Return ThirdPartyId.Value
            End If
            'Tercero paciente
            Return ThirdPartyPatientId
        End Get
    End Property

