    Dim fPatientBalance As Decimal
    <NonPersistent()>
    Public Property PatientBalance() As Decimal
        Get
            If fPortfolioAdvanceConcat IsNot Nothing Then
                Dim portfolioBalance As Decimal = CDec(fPortfolioAdvanceConcat.Split(";")(2) _
                    .Replace(".", ",").Trim())
                If fTotalPatientWithDiscount > portfolioBalance Then
                    Return fTotalPatientWithDiscount - portfolioBalance
                Else
                    Return 0
                End If
            Else
                Return fTotalPatientWithDiscount
            End If
        End Get
        Set(value As Decimal)
            fPatientBalance = value
        End Set
    End Property

