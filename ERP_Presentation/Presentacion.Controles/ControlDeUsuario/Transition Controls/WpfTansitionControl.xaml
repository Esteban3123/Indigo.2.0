<UserControl x:Class="WpfTansitionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:pageTransitions="clr-namespace:WpfPageTransitions;assembly=WpfPageTransitions"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <Storyboard x:Key="SlideRigthIn" >
            <ThicknessAnimation Duration="0:0:.75" Storyboard.TargetProperty="Margin" From="-300,0,300,0" To="0" />
        </Storyboard>

        <Storyboard x:Key="SlideRigthOut">
            <ThicknessAnimation Duration="0:0:.5" Storyboard.TargetProperty="Margin" To="300,0,-300,0" AccelerationRatio=".9"/>
        </Storyboard>
    </UserControl.Resources>
    <Grid >
        <WindowsFormsHost Name="Host" Margin="-300,0,300,0"/>
    </Grid>
</UserControl>

