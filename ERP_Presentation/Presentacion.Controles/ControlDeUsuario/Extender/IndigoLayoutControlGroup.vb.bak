#Region "Librerias"
Imports System.ComponentModel
Imports System.Collections
Imports System.Diagnostics
Imports DevExpress.XtraEditors
Imports System.Drawing
Imports DevExpress.XtraLayout
#End Region

''' <summary>
''' Clase con toda la funcionalidad del control extendido LayoutControlGroup
''' </summary>
<ProvideProperty("CampoObligatorio", GetType(LayoutControlGroup))>
Public Class IndigoLayoutControlGroup
    Inherits System.ComponentModel.Component
    Implements IExtenderProvider
    Implements ISupportInitialize

#Region "Variables Globales"
    ''' <summary>
    ''' Variable hashtable que contiene los controles de tipo LayoutControlGroup
    ''' </summary>
    Private Hashtable As Hashtable
    ''' <summary>
    ''' The contenedor
    ''' </summary>
    Private Contenedor As System.ComponentModel.Container = Nothing
#End Region

#Region "Propiedades"
    ''' <summary>
    ''' Clase que contiene las propiedades que se agregan al control
    ''' </summary>
    Private Class Propiedades
        ''' <summary>
        ''' propiedad que contiene si el Campo tiene diseño metro
        ''' </summary>
        Public CampoObligatorio As Boolean
    End Class

    ''' <summary>
    ''' Funcion para agregar las propiedades a los controles
    ''' </summary>
    ''' <param name="key">The key.</param>
    ''' <returns></returns>
    Private Function EnsurePropertiesExists(ByVal key As Object) As Propiedades
        Dim p As Propiedades = DirectCast(Hashtable(key), Propiedades)
        If p Is Nothing Then
            p = New Propiedades()
            Hashtable(key) = p
        End If
        Return p
    End Function

#Region "CampoObligatorio"
    ''' <summary>
    ''' Funcion para obtener si el Campo tiene diseño metro
    ''' </summary>
    ''' <param name="p">The p.</param>
    ''' <returns></returns>
    <Description("Propiedad para establecer el control como Diseño Metro")>
    <Category("Appearance")>
    <DefaultValue(True)>
    Public Function GetCampoObligatorio(ByVal p As LayoutControlGroup) As Boolean
        Return EnsurePropertiesExists(p).CampoObligatorio
    End Function

    ''' <summary>
    ''' Metodo para establecer si el Campo tiene diseño metro
    ''' </summary>
    ''' <param name="p">The p.</param>
    ''' <param name="value">if set to <c>true</c> [value].</param>
    Public Sub SetCampoObligatorio(ByVal p As LayoutControlGroup, ByVal value As Boolean)
        EnsurePropertiesExists(p).CampoObligatorio = value
        p.Invalidate()
    End Sub

    ''' <summary>
    ''' Resets the campo Diseño Metro.
    ''' </summary>
    ''' <param name="p">The p.</param>
    Private Sub ResetCampoObligatorio(ByVal p As LayoutControlGroup)
        SetCampoObligatorio(p, CBool(System.Environment.Version.ToString()))
    End Sub


#End Region

#End Region

#Region "Eventos"

    ''' <summary>
    ''' Indica al objeto que se ha completado la inicialización.
    ''' en este evento asigno la mascara correspondiente y la apariencia del control
    ''' </summary>
    Public Sub EndInit() Implements System.ComponentModel.ISupportInitialize.EndInit
        For Each de As DictionaryEntry In Hashtable
            Dim p As LayoutControlGroup = TryCast(de.Key, LayoutControlGroup)
            Dim Layout As LayoutControl = TryCast(p.Owner, LayoutControl)
            If Layout IsNot Nothing Then
                Layout.Dock = DockStyle.Fill
            End If
            'If DesignMode Then
            p.AppearanceGroup.Font = New System.Drawing.Font("Segoe UI", 15.75!, System.Drawing.FontStyle.Regular, System.Drawing.GraphicsUnit.Point, CType(0, Byte))
            'p.AppearanceGroup.ForeColor = System.Drawing.Color.FromArgb(CType(CType(0, Byte), Integer), CType(CType(148, Byte), Integer), CType(CType(223, Byte), Integer))
            p.AppearanceGroup.Options.UseFont = True
            'p.AppearanceGroup.Options.UseForeColor = True
            p.AppearanceItemCaption.Font = New System.Drawing.Font("Segoe UI Light", 10.0!, System.Drawing.FontStyle.Bold, System.Drawing.GraphicsUnit.Point, CType(0, Byte))
            p.AppearanceItemCaption.Options.UseFont = True
            p.AppearanceTabPage.Header.Font = New System.Drawing.Font("Segoe UI Light", 12.0!)
            p.AppearanceTabPage.Header.Options.UseFont = True
            p.AppearanceTabPage.HeaderActive.Font = New System.Drawing.Font("Segoe UI", 12.0!)
            'p.AppearanceTabPage.HeaderActive.ForeColor = System.Drawing.Color.FromArgb(CType(CType(0, Byte), Integer), CType(CType(148, Byte), Integer), CType(CType(223, Byte), Integer))
            p.AppearanceTabPage.HeaderActive.Options.UseFont = True
            'p.AppearanceTabPage.HeaderActive.Options.UseForeColor = True
            p.AppearanceTabPage.HeaderDisabled.Font = New System.Drawing.Font("Segoe UI Light", 12.0!)
            p.AppearanceTabPage.HeaderDisabled.Options.UseFont = True
            p.AppearanceTabPage.HeaderHotTracked.Font = New System.Drawing.Font("Segoe UI Light", 12.0!)
            'p.AppearanceTabPage.HeaderHotTracked.ForeColor = System.Drawing.Color.FromArgb(CType(CType(0, Byte), Integer), CType(CType(148, Byte), Integer), CType(CType(223, Byte), Integer))
            p.AppearanceTabPage.HeaderHotTracked.Options.UseFont = True
            'p.AppearanceTabPage.HeaderHotTracked.Options.UseForeColor = True
            p.AppearanceTabPage.PageClient.Font = New System.Drawing.Font("Segoe UI Light", 12.0!)
            p.AppearanceTabPage.PageClient.Options.UseFont = True
            'End If
            AddHandler p.Hidden, AddressOf Hiden
            AddHandler p.Shown, AddressOf Shown
        Next
    End Sub

