        'End If


        If Not String.IsNullOrEmpty(Me.productType.Code) Then
            Try
                Using model As New MProductType(Me.Tag)
                    AsyncLoader(True)
                    Dim state As Boolean = Not productType.Status
                    Dim result As ActionResult(Of ProductType) = Await model.ChangeState(Me.productType.Code, state)
                    If result.StatusCode = eStatusResult.SUCCESS Then
                        Me.productType = result.ObjectEmbbeded
                        Me.UpdateIndexedDocument(Me.BarraBotones._listDocuments)
                        AsyncLoader(False)
                    Else
                        AsyncLoader(False)
                        INDbtnCode.Enabled = False
                    End If
                    ShowMessage(result.StatusCode) = result.Message
                End Using
            Catch ex As Exception
                AsyncLoader(False)
                INDbtnCode.Enabled = False
                Throw ex
            End Try
        Else
            Me.Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("CodeEmpty")
        End If
