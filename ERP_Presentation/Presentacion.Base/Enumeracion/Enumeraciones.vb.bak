''' <summary>
''' Enumeracion que contiene las acciones que se permiten sobre un registro
''' </summary>
''' <remarks></remarks>
Public Enum eActionsStatusRecords
    ''' <summary>
    ''' Marca un estado como inactivo
    ''' </summary>
    ''' <remarks></remarks>
    Inactive
    ''' <summary>
    ''' Marca un estado como activo
    ''' </summary>
    ''' <remarks></remarks>
    Active
    ''' <summary>
    ''' Marca un estado como liquidado
    ''' </summary>
    ''' <remarks></remarks>
    Liquidated
    ''' <summary>
    ''' Marca un estado como Anulado
    ''' </summary>
    ''' <remarks></remarks>
    Invalidate
    ''' <summary>
    ''' Marca un estado como reemplazado
    ''' </summary>
    ''' <remarks></remarks>
    Replaced
    ''' <summary>
    ''' Marca un estado como confirmado
    ''' </summary>
    ''' <remarks></remarks>
    Confirmed
    ''' <summary>
    ''' Marca un estado como suspendido
    ''' </summary>
    ''' <remarks></remarks>
    Suspended
