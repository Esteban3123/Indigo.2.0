    End Function

#End Region

#Region "List"

    ''' <summary>
    ''' confirmar los documentos de glosas
    ''' </summary>
    ''' <param name="processId"></param>
    ''' <param name="listDocuments"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function ConfirmDocumentsGlosas(processId As Integer, listDocuments As List(Of String), Optional operativeUnitId As Integer = 0) As ActionResult(Of List(Of Tuple(Of String, Integer)))
        Me._indigoSessionValues.AuditMessageWcf.Functional = "1754"
        Return IndigoConecta.Instancia.CurrentCloud.IndigoGlosas.ConfirmGlosasDocuments(processId, listDocuments, Me._indigoSessionValues, operativeUnitId)
    End Function

    ''' <summary>
    ''' confirmar documnetos de contabilidad
    ''' </summary>
    ''' <param name="processId"></param>
    ''' <param name="listDocuments"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function ConfirmDocumentsAccounting(listDocuments As List(Of String)) As ActionResult(Of List(Of Tuple(Of String, Integer)))
        Using scope As New OperationContextScope(IndigoConecta.Instancia.CurrentCloud.IndigoAccounting.InnerChannel)
            Me._indigoSessionValues.AuditMessageWcf.Functional = "1695"
            Dim mess As New MessageHeader(Of AuditMessage)(Me._indigoSessionValues.AuditMessageWcf)
            Dim header As System.ServiceModel.Channels.MessageHeader = mess.GetUntypedHeader(ConfigurationFile.SESS_AUDITMESSAGE, ConfigurationFile.SESS_NAME_SPACE)
            OperationContext.Current.OutgoingMessageHeaders.Add(header)
            Return IndigoConecta.Instancia.CurrentCloud.IndigoAccounting.ConfirmAccountingDocuments(listDocuments)
        End Using
    End Function

    ''' <summary>
    ''' confirmar documnetos de cuentas por pagar
    ''' </summary>
    ''' <param name="processId"></param>
    ''' <param name="listDocuments"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function ConfirmDocumentsPayments(processId As Integer, listDocuments As List(Of String)) As ActionResult(Of List(Of Tuple(Of String, Integer)))
        Return IndigoConecta.Instancia.CurrentCloud.IndigoPayments.ConfirmPaymentsDocuments(processId, listDocuments, Me._indigoSessionValues.AuditMessageWcf)
    End Function

    ''' <summary>
