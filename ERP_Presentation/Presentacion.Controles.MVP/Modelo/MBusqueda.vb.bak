    Overloads Function ConsultarEntidades(ByVal origen As eDataSource, ByVal ParamArray Filtro() As String) As Object
        Try
            Select Case origen
                Case Is = eDataSource.ContractTypeByContractClass
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetContractTypeByContractClass(Filtro)
                Case Is = eDataSource.ListBudgetItems
                    'Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListBudgetCategoryByStatusAndBudgetaryValidityIdAndItemType(Filtro)
                Case Else
                    Return Nothing
            End Select
        Catch ex As Exception
            Infrastructure.CrossCutting.Exceptions.IndigoManagementExceptions.HandleExceptionUI(ex, "UIPolicy")
            Return Nothing
        End Try
    End Function

    Overloads Function ConsultarEntidades(ByVal origen As eDataSource, ByVal Filtro As List(Of String)) As Object
        Try
            Select Case origen
                'Portfolio
                Case Is = eDataSource.ListPortfolioAccountReceivableValidation
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListPortfolioAccountReceivableValidation(CType(Filtro, List(Of String)))
                Case Else
                    Return Nothing
            End Select
        Catch ex As Exception
            Infrastructure.CrossCutting.Exceptions.IndigoManagementExceptions.HandleExceptionUI(ex, "UIPolicy")
            Return Nothing
        End Try
    End Function


    ''' <summary>
    ''' Lista los patrones de secuencia
    ''' </summary>
    ''' <returns>Lista de secuencias</returns>
    Public Function ListSequencePatterns() As List(Of Domain.Entities.Sequense)
        Return IndigoConecta.Instancia.CurrentCloud.IndigoCommonERP.ListSequences(IndigoSessionValues)
    End Function

