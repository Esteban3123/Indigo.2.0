''' <summary>
''' Clase Modelo del funcional de busquedas
''' </summary>
Public Class MBusqueda
    Implements IDisposable

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance
    ''' <summary>
    ''' Consultar el servicio de busqueda de entidades en la capa de infraestrucutra XPO
    ''' </summary>
    ''' <returns></returns>
    ''' 
    Overloads Function ConsultarEntidades(ByVal origen As eDataSource) As Object
        Try
            Select Case origen
                Case eDataSource.ListLogisticsProductionCenterRecord
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InteropCostService.ListLogisticsProductionCenterRecord()
                Case eDataSource.ListCostLogisticsProductionCenterRecord
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).CostService.ListCostLogisticsProductionCenterRecord()
                Case Is = eDataSource.ListSequencePatterns
                    Return Me.ListSequencePatterns()

                    '********SEGURIDAD********
                Case Is = eDataSource.UsersCRUD
                    Return XpoServiceEx.Instance(IndigoSessionValues.SecurityContainer).SecurityService.ListUserByPersonName(String.Empty, String.Empty)
                Case Is = eDataSource.ListUserContainer
                    Return XpoServiceEx.Instance(IndigoSessionValues.SecurityContainer).SecurityService.ListUserByContainer(IndigoSessionValues.IndigoContainerId)
                Case Is = eDataSource.ListUserTenant
                    Return XpoServiceEx.Instance(IndigoSessionValues.SecurityContainer).SecurityService.ListUserByTenant(IndigoSessionValues.TenantId)
                Case Is = eDataSource.GroupsCRUD
                    Return XpoServiceEx.Instance(IndigoSessionValues.SecurityContainer).SecurityService.GetGroups()
                Case Is = eDataSource.RolesCRUD
                    Return XpoServiceEx.Instance(IndigoSessionValues.SecurityContainer).SecurityService.GetRoles()

                    '********GLOSAS********
                Case Is = eDataSource.Customers
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).GlosasService.GetCustomers()
                Case Is = eDataSource.DetailedConcepts
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).GlosasService.GetDetailedConcepts()
