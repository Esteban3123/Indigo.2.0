                    '************ Payments *************
                Case Is = eDataSource.ListPaymentsAccountPayableReportByFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PaymentsService.ListPaymentsAccountPayableReportByFilter(Filtro)
                Case Is = eDataSource.ListPaymentsNotesReportFilter
