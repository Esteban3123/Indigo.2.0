                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).GlosasService.GetCompany()
                Case Is = eDataSource.SpecificConcepts
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).GlosasService.GetSpecificConcepts()
                Case Is = eDataSource.Country
