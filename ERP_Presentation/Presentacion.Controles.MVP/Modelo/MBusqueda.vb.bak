            Case eDataSource.ListMainAccountSupply
                Dim serviceArea As XPCollection(Of GENARESERXpo) = XpoServiceEx.Instance(IndigoSessionValues.InteropCostContainer).InteropCostService.ListServiceAreaByListId(CType(filter(0), List(Of Integer)))
                Return XpoServiceEx.Instance(IndigoSessionValues.InteropCostContainer).InteropCostService.ListMainAccountByOIDAccountList(serviceArea.Select(Function(x) x.CTNCUENTA2).Cast(Of Integer).ToList().Distinct().ToList())
            Case eDataSource.ListMainAccountDeprecation
                Dim _responsible As XPCollection(Of Infrastructure.Data.Xpo.InteropCostRepository.AFNRESPONXpo) = XpoServiceEx.Instance(IndigoSessionValues.InteropCostContainer).InteropCostService.ListResponsibleByCostCenterId({CInt(filter(0))}.ToList)
                Dim _listMainAccountsId As List(Of Integer) = (From r In _responsible Select r).Select(Function(x) x.CTNCUENTA).ToList().Distinct().ToList()
                Return XpoServiceEx.Instance(IndigoSessionValues.InteropCostContainer).InteropCostService.ListMainAccountByOIDAccountList(_listMainAccountsId)
