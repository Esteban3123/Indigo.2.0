                    '************ Portfolio *************
                Case Is = eDataSource.ListRadicateInvoice
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListRadicateInvoice(Filtro)
                Case Is = eDataSource.ListNoteReportPortfolioByFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListNoteReportPortfolioByFilter(Filtro)
                Case Is = eDataSource.ListAdvanceTransfers
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListAdvanceTransfers(CInt(Filtro))
                Case Is = eDataSource.ListBillsTransfers
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListBillsTransfers(CInt(Filtro))
                Case Is = eDataSource.ListInvoiceReportPortfolioFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListInvoiceReportPortfolioFilter(Filtro)
                Case Is = eDataSource.ListAdvancesReportPortfolioFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListAdvancesReportPortfolioFilter(Filtro)
                Case Is = eDataSource.ListPortfolioTransferReportFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListPortfolioTransferReportFilter(Filtro)
                Case Is = eDataSource.ListDemandStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PortfolioService.ListDemandStatusFilter(Filtro)
                    '************ Inventario *************
                Case Is = eDataSource.ListTransferOrderByFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListTransferOrderByFilter(Filtro)
                Case Is = eDataSource.ListRemissionDevolutionByTypeReport
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListRemissionDevolutionByTypeReport(Filtro)
                Case Is = eDataSource.ListPurchaseOrderReportByFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListPurchaseOrderReportByFilter(Filtro)
                Case Is = eDataSource.ListRemissionEntranceReportFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListRemissionEntranceReportFilter(Filtro)
                Case Is = eDataSource.ListEntranceVoucherReportByFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListEntranceVoucherReportByFilter(Filtro)
                Case Is = eDataSource.ListDCI
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListDCI(Filtro)
                Case Is = eDataSource.ListInventoryContractByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListInventoryContractByStatus(CByte(Filtro))
                Case Is = eDataSource.ListInventoryAdjustmentByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListInventoryAdjustmentByStatus(CByte(Filtro))
                Case Is = eDataSource.ListInventoryControlByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListInventoryControlByStatus(CByte(Filtro))
                Case Is = eDataSource.ListEntranceVoucherByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListEntranceVoucherByStatus(CByte(Filtro))
                Case Is = eDataSource.ListEntranceVoucherDevolutionByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListEntranceVoucherDevolutionByStatus(CByte(Filtro))
                Case Is = eDataSource.ListInventoryControlByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListEntranceVoucherByStatus(CByte(Filtro))
                Case Is = eDataSource.ListAllRemissionEntrance
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListAllRemissionEntrance()
                Case Is = eDataSource.ListAllLoanMerchandise
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListAllLoanMerchandise()
                Case Is = eDataSource.ListAllConsignmentInventoryRemission
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListAllConsignmentInventoryRemission()
                Case Is = eDataSource.ListAllRemissionOutput
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListAllRemissionOutput()
                Case Is = eDataSource.ListAllLoanMerchandiseDevolutions
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListAllLoanMerchandiseDevolutions()
                Case Is = eDataSource.ListInventoryProductByProductType
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.ListInventoryProductByProductType(CInt(Filtro))
                    '********************************* Taxes ********************************
                Case Is = eDataSource.ListLowTaxesLiquidation
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).TaxesService.ListTaxesLowTaxLiquidation()
                    '**********billing************************
                Case Is = eDataSource.ListAllServiceOrder
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).BillingService.ListAllServiceOrder()
                Case Is = eDataSource.ListGroupers
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).ContractService.ListGroupers()
                Case Else
                    Return Nothing
            End Select
        Catch ex As Exception
            Infrastructure.CrossCutting.Exceptions.IndigoManagementExceptions.HandleExceptionUI(ex, "UIPolicy")
            Return Nothing
        End Try
    End Function

    Overloads Function ConsultarEntidades(ByVal origen As eDataSource, ByVal ParamArray filter() As Object) As Object
        Select Case origen
            Case Is = eDataSource.ListAccountsByLevel
                If filter.Length > 2 Then
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.ListAccountsByLevel(CInt(filter.ElementAt(0)), CBool(filter.ElementAt(1)), CInt(filter.ElementAt(2)))
                ElseIf filter.Length = 1 Then
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.ListAccountsByClass(CInt(filter.ElementAt(0)))
                Else
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.ListAccountsByLevel(CInt(filter.ElementAt(0)), CBool(filter.ElementAt(1)), 0)
                End If
            Case Is = eDataSource.ListAccountsByRetentionAndFreelancerCategory
                Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.ListAccountsByRetentionAndFreelancerCategory(CInt(filter.ElementAt(0)), CBool(filter.ElementAt(1)), CBool(filter.ElementAt(2)))
            Case Is = eDataSource.ListAccountsByRetention
                Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.ListAccountsByRetention(CBool(filter.ElementAt(0)), CBool(filter.ElementAt(1)))
