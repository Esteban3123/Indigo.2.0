    Overloads Function ConsultarEntidades(ByVal origen As eDataSource, ByVal Filtro As String) As Object
        Try
            Select Case origen
                '**********GLOSAS*********
                Case Is = eDataSource.ListEvaluationInvoiceByResponsible
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).GlosasService.ListEvaluationInvoiceByResponsible(Filtro)
                    '********SEGURIDAD********

                    '********COMMON********
                Case Is = eDataSource.Department
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).CommonService.GetDepartment(Filtro) 'Enviar filtro por parametro
                Case Is = eDataSource.City
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).CommonService.GetCities(Int32.Parse(Filtro.Trim())) 'Enviar filtro por parametro
                Case Is = eDataSource.ThirdPartyByPersonId
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).CommonService.GetThirdPartyByPersonId(Int32.Parse(Filtro.Trim()))
                Case Is = eDataSource.GroupByCompany
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetGroupByCompany(Filtro.Trim())
                Case Is = eDataSource.BranchOfficeByCompany
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetBranchOfficeByCompany(Int32.Parse(Filtro.Trim()))
                Case Is = eDataSource.FunctionalUnitByBranchOffice
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetFunctionalUnitByBranchOffice(Int32.Parse(Filtro.Trim()))
                    '**************PAYROLL**************
                Case Is = eDataSource.GroupByContractClass
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetGroupByContractClass(CType(Filtro, Byte))
                Case Is = eDataSource.FunctionalUnitByCompany
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetFunctionalUnitByCompany(CType(Filtro, Byte))
                Case Is = eDataSource.ListEmployeeByFunctionalUnitId
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetEmployeeByFunctionalUnitIdOrGroupId(functionalUnitId:=CInt(Filtro))
                Case Is = eDataSource.ListEmployeeByGroupId
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetEmployeeByFunctionalUnitIdOrGroupId(groupId:=CInt(Filtro))
                Case Is = eDataSource.ListPositionByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.GetPositionByStatus(CType(Filtro, Boolean))
                Case Is = eDataSource.ListSportPractice
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).PayrollService.ListSportPracticeByState(CType(Filtro, Boolean))
                    '*********BUDGET*************'
                Case Is = eDataSource.ListValidityByEntity
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).BudgetService.ListValidityByBudgetEntityId(CInt(Filtro))
                Case Is = eDataSource.ListFinancialSource
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).BudgetService.GetFinancialSource(Filtro)
                Case Is = eDataSource.ListCategoryByBudgetaryValidityIdAndItemType
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).BudgetService.ListCategoryByBudgetaryValidityIdAndItemType(Filtro)

                    '**************Fixed Asset ***************
                Case Is = eDataSource.GetAllGroupByStateFixedAsset
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).FixedAsset.GetAllGroupByState(Boolean.Parse(Filtro.Trim()))
                Case Is = eDataSource.ListFixedAssetLocationTypeParent
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).FixedAsset.ListFixedAssetLocationTypeParent(Filtro)
                Case Is = eDataSource.ListFixedAssetEquipmentByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).FixedAsset.ListFixedAssetEquipmentByStatus(CBool(Filtro))
                    'retencion
                Case Is = eDataSource.ListRetentionConceptByStatus
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.ListRetentionConceptByState(CBool(Filtro))
                Case Is = eDataSource.GetAllClassificationByState
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).FixedAsset.GetAllClassificationByState(CBool(Filtro))
                    '************Treasury*****************              
                Case Is = eDataSource.ListVoucherTranscationCheckReportTreasuryByFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).TreasuryService.ListVoucherTranscationCheckReportTreasuryByFilter(Filtro)
                Case Is = eDataSource.ListRefundsReportTreasuryByFilter
                    Return XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).TreasuryService.ListRefundsReportTreasuryByFilter(Filtro)
                Case Is = eDataSource.ListNoteReportTreasuryByFilter
