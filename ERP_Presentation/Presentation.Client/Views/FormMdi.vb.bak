        Me.CtrSearching = New Presentation.Controls.CtrSearching()
        Me.PccV12.Size = New Size(My.Computer.Screen.Bounds.Width, My.Computer.Screen.Bounds.Height - 45)
        Me.PccV12.Controls.Add(Me.CtrSearching)
