    Private Sub LoadSettingsHIS()
        Dim ValoresSesion As IndigoSingleton.IndigoValoresSesion = IndigoSingleton.IndigoValoresSesion.Instancia
        Dim ConfigFile As Infrastructure.CrossCutting.Base.ConfigurationFile = Infrastructure.CrossCutting.Base.ConfigurationFile.Instance
        Dim ApplicationSetting As Infrastructure.CrossCutting.Base.ApplicationSetting = Infrastructure.CrossCutting.Base.ApplicationSetting.Instance
        ValoresSesion.ProtocoloWebServices = CType(ConfigFile.EHRWebServiceProtocol.GetHashCode, IndigoSingleton.IndigoValoresSesion.eProtocolos)
        ValoresSesion.UriWebServices = ConfigFile.EHRWebServiceURL
        ValoresSesion.UrlWebServicesNoti = ConfigFile.UrlNotificationWebServer
        ValoresSesion.ProtocoloWebServicesXPO = CType(ConfigFile.EHREntityServiceProtocol.GetHashCode, IndigoSingleton.IndigoValoresSesion.eProtocolos)
        ValoresSesion.UriWebServicesXPO = ConfigFile.EHREntityServiceURL
        'ValoresSesion.TimeBloqueoSesion
        'se usar para validar si actualiza o no la aplicación
        ValoresSesion.TipoEjecucionSesion = IndigoSingleton.IndigoValoresSesion.EIndigoTipoEjecucionSesion.Local
        'ValoresSesion.RutaActualizacion
        ValoresSesion.RutadeReportes = ConfigFile.ReportsPath
        ValoresSesion.CacheLocal = If(String.IsNullOrEmpty(ApplicationSetting.CacheServerName), False, True)
        ValoresSesion.RutaArchivosComunes = String.Concat(Infrastructure.CrossCutting.Base.Window.Utils.LocalFolder(), "\HealtTech\Indigo Vie EHR")
        ValoresSesion.RutaArchivosPorUsuario = String.Concat(Infrastructure.CrossCutting.Base.Utils.UserFolder(), "\HealtTech\Indigo Vie EHR")
        ValoresSesion.EmpresaAplicacionCalidad = String.Empty
        ValoresSesion.VersionDGH = IndigoSingleton.IndigoValoresSesion.eVersionDGH.Nativo
        ValoresSesion.VersionIndigoCrystal = "1.0.0.0" 'Application.ProductVersion.ToString()
        ValoresSesion.EmpresaIndigoFundamentales = SessionValues.Instance.FoundationalContainer.Trim().Replace("INDIGO", "")
        ValoresSesion.EmpresaIndigo = SessionValues.Instance.HisContainer.Trim().Replace("INDIGO", "")
        ValoresSesion.EmpresaDGH = SessionValues.Instance.TransactionalContainer 'Obsoleto, si lo utiliza el his
        ValoresSesion.NuevoManejoMensaje = If(ApplicationSetting.ChangeMessageBox = "1", True, False)
        ValoresSesion.ReporteadorActivo = ApplicationSetting.ReporteadorActivo
    End Sub

    Private Sub SetValuesUsuarioEHR()
        Dim ValoresSesion As IndigoSingleton.IndigoValoresSesion = IndigoSingleton.IndigoValoresSesion.Instancia
        If ValoresSesion.UsuarioTipo = IndigoSingleton.IndigoValoresSesion.EIndigoTipoUsuario.Asistencial Or
            ValoresSesion.UsuarioAdministrador Then
            ValoresSesion.ProfesionalCentroAtencion = ConfigurationFile.Instance.CenterAttention.Trim
            ValoresSesion.ProfesionalUnidadFuncional = ConfigurationFile.Instance.FunctionalUnit.Trim
        End If
    End Sub

    Private Sub SetValuesProfesional(profesional As Domain.Crystal.Entities.SP_SEG_AutenticarDatosProfesional_Result)
        Dim ValoresSesion As IndigoSingleton.IndigoValoresSesion = IndigoSingleton.IndigoValoresSesion.Instancia
        If profesional Is Nothing Then
            ValoresSesion.Profesional = Nothing
            ValoresSesion.ProfesionalNombre = Nothing
            ValoresSesion.ProfesionalTipo = IndigoSingleton.IndigoValoresSesion.eIndigoTipoProfesional.Otros
            ValoresSesion.ProfesionalTarjetaProfesional = Nothing
            ValoresSesion.ProfesionalPerfilCirugia = IndigoSingleton.IndigoValoresSesion.EIndigoTipoPerfilCirugia.Ayudantes
            ValoresSesion.EspecialidadMedico1 = Nothing
            ValoresSesion.EspecialidadMedico2 = Nothing
            ValoresSesion.EspecialidadMedico3 = Nothing
            ValoresSesion.ProfesionalDashboardDefault = IndigoSingleton.IndigoValoresSesion.EIndigoTipoDashboardDefault.DashBoard_ServiciosApoyo
        Else
            ValoresSesion.Profesional = profesional.CODIGO.Trim
            ValoresSesion.ProfesionalNombre = profesional.NOMBREPROFESIONAL.Trim
            ValoresSesion.ProfesionalTipo = CType(profesional.TIPOPROFESIONAL, IndigoSingleton.IndigoValoresSesion.eIndigoTipoProfesional)
            ValoresSesion.ProfesionalTarjetaProfesional = profesional.TARJETAPROFESIONAL.Trim
            If Not String.IsNullOrEmpty(profesional.PERFILCIRUGIA) Then
                ValoresSesion.ProfesionalPerfilCirugia = CType(profesional.PERFILCIRUGIA, IndigoSingleton.IndigoValoresSesion.EIndigoTipoPerfilCirugia)
            End If
            ValoresSesion.EspecialidadMedico1 = profesional.ESPECIALIDAD1.Trim
            ValoresSesion.EspecialidadMedico2 = profesional.ESPECIALIDAD2.Trim
            ValoresSesion.EspecialidadMedico3 = profesional.ESPECIALIDAD3.Trim
            If ConfigurationFile.Instance.Dashboard.HasValue Then
                ValoresSesion.ProfesionalDashboardDefault = CType(ConfigurationFile.Instance.Dashboard.GetValueOrDefault(),
                    IndigoSingleton.IndigoValoresSesion.EIndigoTipoDashboardDefault)
            End If
        End If
    End Sub

    ''' <summary>
    ''' Inicializa los Valores de sesion (Singleton ERP)
    ''' </summary>
    Public Sub InitSesionValues()
        Dim Indigo As SessionValues = SessionValues.Instance
        Dim MensajeAuditoria As AuditMessage = New AuditMessage() With
        {
            .Company = Indigo.IndigoCompany,
            .CodeUser = Indigo.UserIndigo,
            .ComputerName = Utils.GetHostname(),
            .WindowsUser = Utils.GetOSUsername(),
            .IdUser = Indigo.UserIndigoId,
            .NameUser = Indigo.UserIndigoName,
            .CompanyType = Indigo.IndigoCompanyType,
            .DispensingIntegration = CByte(Indigo.IndigoDispensingIntegration)
        }
        Indigo.AuditMessageWcf = MensajeAuditoria
    End Sub
