<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="FrmLoginWPF"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" Height="768" Width="1024" >
    <UserControl.Resources>
        <Style x:Key="ButtonStyle1" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Rectangle Margin="2" SnapsToDevicePixels="True" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#FFDDDDDD"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FFAAAAAA"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FFAAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FF555555"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF555555"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#FFBCDDEE"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FF245A83"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" TargetName="border" Value="#FFF4F4F4"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="#FFADB2B5"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="#FF838383"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="White" Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="1" Visibility="Visible" x:Name="INDpcImages" d:IsHidden="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="INDGVideo" Visibility="Hidden"  >
            <MediaElement Grid.Row="0" Grid.Column="0" x:Name="WeatherVideo"
				FlowDirection="LeftToRight" LoadedBehavior="Manual" Stretch="UniformToFill" ScrubbingEnabled="True"/>
            </Grid>
            <Grid x:Name="INDGImagen" Visibility="Visible"  > 
                <Image x:Name="INDicImagenVideo" Stretch="UniformToFill"  />
            </Grid>

            <Grid x:Name="INDpcButtonText" Height="240" VerticalAlignment="Bottom" Background="#7F000000">
                <StackPanel>
                    <TextBlock x:Name="INDtxtTitleDay"  Text="" Foreground="White" FontSize="50" Margin="20,10,20,0" VerticalAlignment="Top" FontFamily="Segoe UI Light" TextWrapping="Wrap"/>
                    <TextBlock x:Name="INDtxtDescriptionDay" Text="" Foreground="White" FontSize="36" Margin="20,10,20,0" VerticalAlignment="Top" FontFamily="Segoe UI Light" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" x:Name="INDpcWeather" Visibility="Collapsed"   Background="Transparent" >
            <StackPanel HorizontalAlignment="Left"  VerticalAlignment="Top">
                <TextBlock x:Name="INDCity"  Foreground="White" FontFamily="Segoe UI Light" FontSize="85" TextWrapping="Wrap" Text="Bogota" Margin="20,20,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Grid Height="240" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal"  >
                    <StackPanel Orientation="Vertical"  VerticalAlignment="Top"  HorizontalAlignment="Left" Margin="20,5,0,-20" >
                        <StackPanel VerticalAlignment="top" HorizontalAlignment="Left"  Orientation="Horizontal"  Margin="10,10,10,4">
                            <TextBlock x:Name="INDImgWeatherIcon"  FontFamily="/Indigo Vie ERP;component/Resources/#Weather Icons"  Text="&#xF013;" Foreground="White"  VerticalAlignment="Center"   TextAlignment="Center" HorizontalAlignment="Center" FontSize="40" />
                            <TextBlock x:Name="INDWeather" Foreground="White" FontWeight="Bold" Margin="20,0,0,0" FontFamily="Segoe UI Light" FontSize="25" TextWrapping="Wrap" Text="Parcialmente nublado"  VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="top" HorizontalAlignment="Left" Orientation="Horizontal"   Margin="10,0,0,0">
                            <TextBlock   FontFamily="Segoe UI Symbol" Text="&#x10323;" Foreground="White"  VerticalAlignment="Center" Margin="13,0,14,0"  TextAlignment="Center" HorizontalAlignment="Center" FontSize="27" />
                            <TextBlock x:Name="INDTemHigh" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="32" TextWrapping="Wrap" Text="46°"  Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock   FontFamily="Segoe UI Symbol" Text="&#x10c38;" Foreground="White" VerticalAlignment="Center"  Margin="0,0,14,0" TextAlignment="Center" HorizontalAlignment="Center" FontSize="27" />
                            <TextBlock x:Name="INDTemLow" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="32" TextWrapping="Wrap" Text="35°" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="top" HorizontalAlignment="Left" Orientation="Horizontal"   Margin="10,-27,0,0">
                            <TextBlock x:Name="INDTempNow" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="120" TextWrapping="Wrap" Text="46°"  Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="INDUnit" Foreground="White"  FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="40" TextWrapping="Wrap" Text="C" Margin="0,0,9,52" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Vertical"  VerticalAlignment="Top"  HorizontalAlignment="Left">
                        <TextBlock x:Name="INDHum" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="25" TextWrapping="Wrap" Text="Humedad         25%"  Margin="40,90,0,0" VerticalAlignment="Center"/>
                        <Line X1="40" Y1="0" X2="348" Y2="0" Stroke="White" StrokeThickness="0.4"    />
                        <TextBlock x:Name="INDVis" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="25" TextWrapping="Wrap" Text="Visibilidad         20 miles"  Margin="40,0,0,0" VerticalAlignment="Center"/>
                        <Line X1="40" Y1="0" X2="348" Y2="0" Stroke="White" StrokeThickness="0.4"    />
                        <TextBlock x:Name="INDPres" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="25" TextWrapping="Wrap" Text="Presion             20 inches"  Margin="40,0,0,0" VerticalAlignment="Center"/>
                        <Line X1="40" Y1="0" X2="348" Y2="0" Stroke="White" StrokeThickness="0.4"    />
                        <TextBlock x:Name="INDWind" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI Light" FontSize="25" TextWrapping="Wrap" Text="Viento              20 mph"  Margin="40,0,0,0" VerticalAlignment="Center"/>
                    
                    </StackPanel>

                </StackPanel>
            </Grid>

        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="INDgcContainer"  Grid.Row="0" Margin="20" Width="310" Height="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#4C000000" BorderThickness="0,0,1,0"/>
                <Rectangle Grid.Row="1" Grid.Column="2" >
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <LinearGradientBrush.RelativeTransform>
                                <TransformGroup>
                                    <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                    <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                    <RotateTransform Angle="90" CenterY="0.5" CenterX="0.5"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#66000000" Offset="1"/>
                            <GradientStop/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#4C000000" BorderThickness="0,0,0,1" />
                <Rectangle Grid.Row="2" Grid.Column="1">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#66000000" Offset="0"/>
                            <GradientStop Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,20,0">
                        <Button x:Name="INDbtnHome"  Height="20" Width="20" BorderBrush="{x:Null}" Margin="0,0,10,0" Background="{x:Null}" FontFamily="Segoe UI Symbol" Content="&#xE10F;" Foreground="#FF8D8D8D" Click="Click_home" ToolTip="www.indigo.ms"/>
                        <Button x:Name="INDbtnConfiguration" Height="20" Width="20" BorderBrush="{x:Null}" Background="{x:Null}" FontFamily="Segoe UI Symbol" Content="&#xE115;" Foreground="#FF8D8D8D" ToolTip="Cambiar de empresa" Click="Click_companies"/>
                    </StackPanel>

					<Image x:Name="INDpeImageLogin" Margin="0,10,10,0" VerticalAlignment="Center" Width="100" Source="pack://siteoforigin:,,,/Resources/Login_OnPremise.png" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                    <Grid x:Name="INDgcLoad" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Vertical" >
                            <fa:ImageAwesome Name="INDLoader" Icon="Spinner" Spin="True" SpinDuration="10" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible" MaxHeight="38" Foreground="#FF00466D"/>
                            <TextBlock x:Name="INDtxtTitle"  Foreground="#FF00466D"  FontFamily="Segoe UI Light" FontSize="20" TextWrapping="Wrap" Text="Validando Usuario..."  Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="INDgcControls" Height="250" Margin="0,20,0,0" Visibility="Visible" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="INDborderFocusUsurio" BorderBrush="#FF00466D" BorderThickness="5,0,0,0" Background="#FFF4F2F2" Grid.Row="0" Visibility="Collapsed"/>
                        <Border x:Name="INDborderFocusContraseña" BorderBrush="#FF00466D" BorderThickness="5,0,0,0" Background="#FFF4F2F2" Grid.Row="1" Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" Margin="30,0" Grid.Row="0">
                            <TextBlock   FontFamily="Segoe UI Symbol" Text="&#xE13D;" Foreground="#FF8D8D8D" VerticalAlignment="Center"  Margin="0,24" TextAlignment="Center" HorizontalAlignment="Center" FontSize="20" />
                            <TextBox x:Name="INDtxtUsuario" VerticalAlignment="Center" Background="White" Width="180" BorderThickness="1.5" ToolTip="Usuario" Height="30" FontSize="16" Padding="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="30,0" Grid.Row="1">
                            <TextBlock   FontFamily="Segoe UI Symbol" Text="&#xE192;" Foreground="#FF8D8D8D" VerticalAlignment="Center"  Margin="0,24" TextAlignment="Center" HorizontalAlignment="Center" FontSize="20" />
                            <PasswordBox x:Name="INDtxtContraseña" VerticalAlignment="Center" Background="White" Width="180" BorderThickness="1.5" ToolTip="Contraseña" Height="30" FontSize="16" Padding="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,20,47,30" HorizontalAlignment="Right" Grid.Row="3" >
                            <Button x:Name="INDbtnAceptar" Height="30" Width="80" Content="Login" Foreground="White" BorderBrush="#FF00466D" Background="#FF00466D" Click="Click_login" Style="{DynamicResource ButtonStyle1}" VerticalAlignment="Bottom"/>
                            <Button Height="30" Width="30"  Foreground="White" BorderBrush="#FF00466D" Margin="5,0,0,0" FontFamily="Segoe UI Symbol" Content="&#xE07D;" Click="Click_exit" Style="{DynamicResource ButtonStyle1}" Background="#FF00466D"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

            </Grid>
            <Grid x:Name="INDpcButton" Height="240" VerticalAlignment="Bottom" Background="#7F000000" Grid.Row="1">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,10" >
                    <TextBlock x:Name="INDtxtHora" Foreground="White"  FontSize="120"  VerticalAlignment="Center" FontFamily="Segoe UI Light" HorizontalAlignment="Center"  />
                    <TextBlock x:Name="INDtxtFecha" Foreground="White" Text="" FontSize="30"  VerticalAlignment="Center" FontFamily="Segoe UI Light" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
