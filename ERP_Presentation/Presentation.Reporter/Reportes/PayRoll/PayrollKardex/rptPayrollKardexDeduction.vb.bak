Public Class rptPayrollKardexDeduction
    Implements IReport
    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance

    ''' <summary>
    ''' Variable par obtener la tabla de Trazabilidad
    ''' </summary>
    Dim dtReportPayrollKardes As DataTable

    Dim ParametrosFilter As ParameterCollection = Me.Parameters


    Public Sub CargarDataSource() Implements IReport.CargarDataSource
        'CargarDataSource1()
    End Sub

    Public Sub CargarDataSource1()
        Try
            Dim ds As DataSet = IndigoConecta.Instancia.CurrentCloud.IndigoPayroll.GetListReportPayrollReportKardex(2, ParametrosReporte(2), ParametrosReporte(1), Me.IndigoSessionValues)
            'Dim ds As DataSet = IndigoConecta.Instancia.CurrentCloud.IndigoPayroll.GetListReportPayrollReportKardex(1, 2016, 1, Me.IndigoSessionValues)
            If ds IsNot Nothing Then
                dtReportPayrollKardes = ds.Tables("ReportPayrollKardes")
                'For Each row As DataRow In dtReportPayrollKardes.Rows
                '    MessageBox.Show(row(0).ToString())
                'Next
                Me.DataSource = dtReportPayrollKardes
                Me.DataMember = "ReportPayrollKardes"
            Else
                Me.DataSource = Nothing
            End If
            Application.DoEvents()
        Catch ex As Exception
            MessageIndigo.Show(GetExceptionDetails(ex), MessageType.Errores, Me.Text, Botones.Aceptar, "")
        End Try
    End Sub
    Public Function GetExceptionDetails(exception As Exception) As String
        Dim properties = exception.[GetType]().GetProperties()
        Dim fields = properties.[Select](Function([property]) New With { _
            Key .Name = [property].Name, _
            Key .Value = [property].GetValue(exception, Nothing) _
        }).[Select](Function(x) [String].Format("{0} : {1}", x.Name, If(x.Value IsNot Nothing, x.Value.ToString(), [String].Empty)))
        Return [String].Join(vbLf, fields)
    End Function
    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Private Sub Detail_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles Detail.BeforePrint

    End Sub

    Private Sub rptPayrollKardexAccrual_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles MyBase.BeforePrint

        If Me.Parameters.Count > 0 And Me.Parameters(0).Value > 0 And Me.Parameters(1).Value > 0 And Me.Parameters(2).Value > 0 Then
            Dim ParametrosFilter As ParameterCollection = Me.Parameters
            ParametrosReporte = New Object() {ParametrosFilter.GetByName("INDParamConceptTypea").Value, ParametrosFilter.GetByName("INDParamEmployeeIda").Value, ParametrosFilter.GetByName("INDParamStatusa").Value}
            CargarDataSource1()
        End If
    End Sub

End Class