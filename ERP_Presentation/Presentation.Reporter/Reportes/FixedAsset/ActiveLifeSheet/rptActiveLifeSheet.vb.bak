Public Class rptActiveLifeSheet
    Implements IReport

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance

    ''' <summary>
    ''' Variable par obtener la tabla de Trazabilidad
    ''' </summary>
    Dim dtFixedAssetPhysicalAsset As DataTable

    ''' <summary>
    ''' Variable para darle formato de decimales a los valores del reporte
    ''' </summary>
    Private _decimalFormat As Integer

    ''' <summary>
    ''' Diccionario con libros contables
    ''' </summary>
    Private _dictionaryBooks As New Dictionary(Of String, BookXpo)

    Public Sub CargarDataSource() Implements IReport.CargarDataSource

    End Sub

    Public Async Function CargarDataSource1() As Task
        Try
            Dim ds As DataSet = Await IndigoConecta.Instancia.CurrentCloud.IndigoFixedAssets.GetListFixedAssetPhysicalAssetAsync(ParametrosReporte(0), Me.ParametrosReporte(1), Me.ParametrosReporte(2), ParametrosReporte(3), ParametrosReporte(4), ParametrosReporte(5), ParametrosReporte(6), ParametrosReporte(7), ParametrosReporte(8), ParametrosReporte(9), ParametrosReporte(10), ParametrosReporte(11), ParametrosReporte(12), Me.IndigoSessionValues)
            If ds IsNot Nothing Then
                dtFixedAssetPhysicalAsset = ds.Tables("FixedAssetPhysicalAsset")
                Me.DataSource = dtFixedAssetPhysicalAsset
                Me.DataMember = "FixedAssetPhysicalAsset"
                GetDecimals()
            Else
                Me.DataSource = Nothing
            End If

        Catch ex As Exception
            MessageIndigo.Show(GetExceptionDetails(ex), MessageType.Errores, Me.Text, Botones.Aceptar, "")
        End Try
    End Function
    Public Function GetExceptionDetails(exception As Exception) As String
        Dim properties = exception.[GetType]().GetProperties()
        Dim fields = properties.[Select](Function([property]) New With {
            Key .Name = [property].Name,
            Key .Value = [property].GetValue(exception, Nothing)
        }).[Select](Function(x) [String].Format("{0} : {1}", x.Name, If(x.Value IsNot Nothing, x.Value.ToString(), [String].Empty)))
        Return [String].Join(vbLf, fields)
    End Function

    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Private Sub rptActiveLifeSheet_BeforePrint(sender As Object, e As PrintEventArgs) Handles MyBase.BeforePrint
        INDLblCompany.Text = IndigoSessionValues.IndigoCompanyName
        INDLblNitCompany.Text = "Nit:" & IndigoSessionValues.IndigoCompanyNit
        INDLblUserPrint.Text = "Usuario Impresión : " & IndigoSessionValues.UserIndigo & " - " & IndigoSessionValues.UserIndigoName
    End Sub


#Region "Cambio Símbolo Moneda"
    ''' <summary>
    ''' Obtiene los decimales para los valores
    ''' </summary>
    Private Sub GetDecimals()
        'Obtenemos los parámetros de activos fijos
        Dim filter = "OperatingUnitId = " & IndigoSessionValues.IndigoOperatingUnitId
        Dim settingFixedAsset = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).FixedAsset.GetXPOObject(Of SettingFixedAssetXpo)(filter)

        If settingFixedAsset.CurrencyId?.RoundingType IsNot Nothing Then
            FormatValueWithDecimals(settingFixedAsset.CurrencyId.RoundingType)
        End If
    End Sub

    ''' <summary>
    ''' Método para formatear los valores del reporte según el tipo de redondeo parametrizado a la moneda
    ''' </summary>
    ''' <param name="roundingType"></param>
    Private Sub FormatValueWithDecimals(roundingType As Integer)
        Select Case roundingType
            Case 1
                _decimalFormat = 2
            Case 2
                _decimalFormat = 1
            Case >= 3
                _decimalFormat = 0
        End Select
    End Sub
    ''' <summary>
    ''' Asigna el símbolo de moneda de las celdas acorde a la moneda del libro
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    Private Sub SetCurrencyFormat(sender As Object, e As PrintEventArgs) Handles XrTableCell4.BeforePrint, XrTableCell5.BeforePrint, XrTableCell8.BeforePrint, XrTableCell10.BeforePrint, XrTableCell11.BeforePrint, XrTableCell41.BeforePrint, XrTableCell13.BeforePrint, XrTableCell26.BeforePrint
        Dim currentRow As DataRowView = TryCast(GetCurrentRow(), DataRowView)

        If currentRow IsNot Nothing Then
            'Obtenemos el nombre del libro para consultar la moneda oficial del mismo
            Dim bookName As String = currentRow("Name").ToString
            Dim BookTmp As BookXpo = Nothing

            If _dictionaryBooks.Any(Function(x) x.Key = bookName) Then
                BookTmp = _dictionaryBooks.Item(bookName)
            Else
                Dim filter As String = $"Name = '{bookName}'"
                BookTmp = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.GetXPOObject(Of BookXpo)(filter)
                _dictionaryBooks.Add(bookName, BookTmp)
            End If

            sender.Text = Utils.GetMoneyWithISO4217(sender.Text, BookTmp.OfficialCurrencyId.Abbreviation, _decimalFormat)
        End If
    End Sub

#End Region
End Class