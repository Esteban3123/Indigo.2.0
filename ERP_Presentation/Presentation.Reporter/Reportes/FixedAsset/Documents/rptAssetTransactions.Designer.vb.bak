        '
        'INDTotal
        '
        Me.INDTotal.Expression = "sum([Neto]) -  [ValueDiscount] + [IVA] - [RetentionSource] -  [WithholdingICA] - " &
    "[WithholdingTax] - [RetentionOther] - [DeductionOther]"
        Me.INDTotal.Name = "INDTotal"
        '
        'INDRetefte
        '
        Me.INDRetefte.Expression = "Iif((sum([Neto]) - sum([ValueDiscount])) >= [RetefteMinBase], ((sum([Neto]) - sum" &
    "([ValueDiscount])) * [RetefteRate]) / 100, 0)"
        Me.INDRetefte.Name = "INDRetefte"
        '
        'INDReteica
        '
        Me.INDReteica.Expression = "Iif((sum([Neto]) - sum([ValueDiscount])) >= [ReteicaMinBase], ((sum([Neto]) - sum" &
    "([ValueDiscount])) * [ReteicaRate]) / 100, 0)"
        Me.INDReteica.Name = "INDReteica"
        '
        'INDReteiva
        '
        Me.INDReteiva.Expression = "Iif((sum([Neto]) - sum([ValueDiscount])) >= [ReteivaMinBase], ((sum([Neto]) - sum" &
    "([ValueDiscount])) * [ReteivaRate]) / 100, 0)"
        Me.INDReteiva.Name = "INDReteiva"
        '
        'INDSubtotal
        '
        Me.INDSubtotal.Expression = "sum([Neto]) - [ValueDiscount] + [IVA]"
        Me.INDSubtotal.Name = "INDSubtotal"
        '
        'INDCfStatus
        '
        Me.INDCfStatus.Expression = "Iif([Status]=1,'Registrado',Iif([Status]=2,'Confirmado', 'Anulado'))"
        Me.INDCfStatus.Name = "INDCfStatus"
