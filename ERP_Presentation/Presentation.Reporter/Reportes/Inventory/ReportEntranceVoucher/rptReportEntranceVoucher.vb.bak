    Private Sub XrTableCell14_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles XrTableCell14.BeforePrint
        Dim row = GetCurrentRow()

        Dim Value = DirectCast(row, InventoryEntranceVoucherReportXpo)?.Value
        Dim CurrencyAbbreviation = DirectCast(row, InventoryEntranceVoucherReportXpo)?.CurrencyAbbreviation
        If Value >= 0 AndAlso Not String.IsNullOrEmpty(CurrencyAbbreviation) Then
            XrTableCell14.Text = Utils.GetMoneyWithISO4217(Value, CurrencyAbbreviation)
        End If
    End Sub

