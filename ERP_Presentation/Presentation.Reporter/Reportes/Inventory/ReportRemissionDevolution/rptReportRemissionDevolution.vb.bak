#Region "Imports"

Imports DevExpress.Xpo
Imports DevExpress.XtraReports.UI
Imports Infrastructure.CrossCutting.Base
Imports Infrastructure.Data.Xpo
Imports Infrastructure.Data.Xpo.InventoryRepository
Imports Presentation.Base

#End Region

Public Class rptReportRemissionDevolution
    Implements IReport
    Implements IReportAsync

#Region "Properties"

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

#End Region

#Region "Load Data"

    Public Sub CargarDataSource() Implements IReport.CargarDataSource
        Try
            Me.DataSource = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).InventoryService.LoadDataSourceReportRemissionDevolution(ParametrosReporte(0), ParametrosReporte(1), ParametrosReporte(2), ParametrosReporte(3), ParametrosReporte(5), ParametrosReporte(6))
        Catch ex As Exception
            MessageIndigo.Show(GetExceptionDetails(ex), MessageType.Errores, Me.Text, Botones.Aceptar, "")
        End Try
    End Sub

    Public Function CargarDataSourceAsync() As Task Implements IReportAsync.CargarDataSourceAsync
        Return Task.Factory.StartNew(AddressOf CargarDataSource)
    End Function

#End Region

#Region "Methods"

    Private Sub rptTraceabilityInvoice_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles MyBase.BeforePrint
        Me.INDLblNameCompany.Text = IndigoSessionValues.IndigoCompanyName
        Me.INDLblNitCompany.Text = "Nit : " & IndigoSessionValues.IndigoCompanyNit
        Me.INDUserImp.Text = "Usuario Impresión : " & IndigoSessionValues.UserIndigo & " - " & IndigoSessionValues.UserIndigoName

        Me.INDPrmGroupBy.Value = ParametrosReporte(4)
        Me.INDPrmTypeDevolution.Value = ParametrosReporte(2)
        If ParametrosReporte(0) IsNot Nothing And ParametrosReporte(1) IsNot Nothing Then
            Me.INDLblSubTitle.Text = "Informe comprendido entre " & CDate(Me.ParametrosReporte(0)).ToString("dd De MMMM Del yyyy") & " " & CDate(Me.ParametrosReporte(1)).ToString("A dd De MMMM Del yyyy")
        End If

        If Me.INDPrmTypeDevolution.Value = 1 Then
            Me.INDLblTitle.Text = "INFORME DE DEVOLUCION DE REMISIONES DE ENTRADA"
        ElseIf Me.INDPrmTypeDevolution.Value = 2 Then
            Me.INDLblTitle.Text = "INFORME DE DEVOLUCION DE REMISIONES DE SALIDA"
        ElseIf Me.INDPrmTypeDevolution.Value = 3 Then
            Me.INDLblTitle.Text = "INFORME DE DEVOLUCION DE REMISIONES DE INVENTARIO EN CONSIGNACIÓN"
        End If
    End Sub

    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public Function GetExceptionDetails(exception As Exception) As String
        Dim properties = exception.[GetType]().GetProperties()
        Dim fields = properties.[Select](Function([property]) New With {
            Key .Name = [property].Name,
            Key .Value = [property].GetValue(exception, Nothing)
        }).[Select](Function(x) [String].Format("{0} : {1}", x.Name, If(x.Value IsNot Nothing, x.Value.ToString(), [String].Empty)))
        Return [String].Join(vbLf, fields)
    End Function

    Private Sub XrTableCell18_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles XrTableCell18.BeforePrint, XrTableCell17.BeforePrint, XrTableCell16.BeforePrint
        Dim column = TryCast(sender, XRTableCell)
        Dim currencyAbbreviation = TryCast(Me.GetCurrentRow, InventoryRemissionDevolutionReportXpo)?.CurrencyAbbreviation
        If String.IsNullOrEmpty(currencyAbbreviation) Then Exit Sub

        Select Case column.Name
            Case NameOf(Me.XrTableCell18)
                Me.XrTableCell18.Text = Utils.GetMoneyWithISO4217(GetCurrentColumnValue(NameOf(Me.INDCfTotalValue)), currencyAbbreviation)
            Case NameOf(Me.XrTableCell17)
                Me.XrTableCell17.Text = Utils.GetMoneyWithISO4217(GetCurrentColumnValue(NameOf(Me.INDCfIVAValue)), currencyAbbreviation)
            Case NameOf(Me.XrTableCell16)
                Me.XrTableCell16.Text = Utils.GetMoneyWithISO4217(GetCurrentColumnValue(NameOf(Me.INDCfValue)), currencyAbbreviation)
        End Select

    End Sub

    Private Sub XrTableCell32_SummaryGetResult(sender As Object, e As SummaryGetResultEventArgs) Handles XrTableCell32.SummaryGetResult, XrTableCell31.SummaryGetResult, XrTableCell30.SummaryGetResult
        Dim currencyAbbreviation = TryCast(Me.GetCurrentRow, InventoryRemissionDevolutionReportXpo)?.CurrencyAbbreviation
        If String.IsNullOrEmpty(currencyAbbreviation) Then Exit Sub

        e.Result = Utils.GetMoneyWithISO4217(e.CalculatedValues.ToEntityList(Of Decimal).Sum(), currencyAbbreviation)
        e.Handled = True
    End Sub


    ''' <summary>
    ''' se crean los acumulados por monedas
    ''' </summary>
    ''' <param name="sender"></param>
    ''' <param name="e"></param>
    Private Sub ReportFooter_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles ReportFooter.BeforePrint

        Dim sourceList = TryCast(Me.DataSource, XPCollection(Of InventoryRemissionDevolutionReportXpo))?.ToList()
        If sourceList Is Nothing Then Exit Sub

        Dim GroupByCurrency = (From x In sourceList
                               Group By x.CurrencyAbbreviation Into Group
                               Select CurrencyAbbreviation,
                                        TotalValue = Group.Sum(Function(f)
                                                                   Select Case f.DevolutionType
                                                                       Case 1
                                                                           Return f.RemissionEntranceId.TotalValue
                                                                       Case 2
                                                                           Return f.RemissionOutputId.Value
                                                                       Case Else
                                                                           Return f.ConsignmentInventoryRemissionId.TotalValue
                                                                   End Select
                                                               End Function),
                                           IvaValue = Group.Sum(Function(s)
                                                                    Select Case s.DevolutionType
                                                                        Case 1
                                                                            Return s.RemissionEntranceId.IvaValue
                                                                        Case 2
                                                                            Return 0
                                                                        Case Else
                                                                            Return s.ConsignmentInventoryRemissionId.IvaValue
                                                                    End Select
                                                                End Function),
                                            Value = Group.Sum(Function(s)
                                                                  Select Case s.DevolutionType
                                                                      Case 1
                                                                          Return s.RemissionEntranceId.Value
                                                                      Case 2
                                                                          Return s.RemissionOutputId.Value
                                                                      Case Else
                                                                          Return s.ConsignmentInventoryRemissionId.Value
                                                                  End Select
                                                              End Function))

        Dim row = 0
        For Each ObjItem In GroupByCurrency
            If row = 0 Then
                INDXrTotalName.Text = $"Valor Total {ObjItem.CurrencyAbbreviation}"
                XrTableCell41.Text = Utils.GetMoneyWithISO4217(ObjItem.Value, ObjItem.CurrencyAbbreviation)
                XrTableCell42.Text = Utils.GetMoneyWithISO4217(ObjItem.IvaValue, ObjItem.CurrencyAbbreviation)
                XrTableCell43.Text = Utils.GetMoneyWithISO4217(ObjItem.TotalValue, ObjItem.CurrencyAbbreviation)
                row += 1
                Continue For
            End If

            INDTblFooterReportEntrance.InsertRowBelow(INDTblFooterReportEntrance.Rows.LastRow)
            Dim irow = INDTblFooterReportEntrance.Rows.LastRow.Index
            For Each Column As XRTableCell In XrTableRow11
                Dim cell = INDTblFooterReportEntrance.Rows(irow).Cells.Item(Column.Index)
                Select Case Column.Name
                    Case NameOf(INDXrTotalName)
                        cell.Text = $"Valor Total {ObjItem.CurrencyAbbreviation}"
                    Case NameOf(XrTableCell41)
                        cell.Text = Utils.GetMoneyWithISO4217(ObjItem.Value, ObjItem.CurrencyAbbreviation)
                    Case NameOf(XrTableCell42)
                        cell.Text = Utils.GetMoneyWithISO4217(ObjItem.IvaValue, ObjItem.CurrencyAbbreviation)
                    Case NameOf(XrTableCell43)
                        cell.Text = Utils.GetMoneyWithISO4217(ObjItem.TotalValue, ObjItem.CurrencyAbbreviation)
                End Select
            Next
        Next
    End Sub

#End Region

End Class