#Region "Librerias Improtadas"
Imports Infrastructure.CrossCutting.Base
Imports Infrastructure.Data.Xpo
Imports Infrastructure.Data.Xpo.PayrollRepository
Imports Domain.Entities
#End Region

Public Class rptDevolution
    Implements IReport

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance

    Const CNameReport = "Glosas.FrmDevolutions"

    'Private _INDIdDevolucion As Integer
    'Public Property INDIdDevolucion As Integer
    '    Get
    '        Return Me._INDIdDevolucion
    '    End Get
    '    Set(value As Integer)
    '        Me._INDIdDevolucion = value
    '    End Set
    'End Property

    Public Sub CargarDataSource() Implements IReport.CargarDataSource
        Dim filtroConsulta As String = "GlosaDevolutionsReceptionCId.Id =" & Me.ParametrosReporte(0)
        Me.DataSource = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).GlosasService.GetCollection(Of GlosasRepository.GlosaDevolutionsReceptionDXpo)(Nothing, filtroConsulta)
        If Me.ParametrosReporte(1) IsNot Nothing Then
            Me.INDlblAddress.Text = If(Me.ParametrosReporte(1).Address IsNot Nothing, Me.ParametrosReporte(1).Address.Trim() & If(Me.ParametrosReporte(1).City IsNot Nothing, If(Me.ParametrosReporte(1).City.Name IsNot Nothing, " " & Me.ParametrosReporte(1).City.Name.Trim() & If(Me.ParametrosReporte(1).City.Department IsNot Nothing, " - " & Me.ParametrosReporte(1).City.Department.Name.Trim(), String.Empty), String.Empty), String.Empty), String.Empty)
            Me.INDlblPhoneEmail.Text = If(Me.ParametrosReporte(1).Phone IsNot Nothing, Me.ParametrosReporte(1).Phone.Trim() & If(Me.ParametrosReporte(1).Email IsNot Nothing, " - " & Me.ParametrosReporte(1).Email.Trim(), String.Empty), String.Empty)

        End If
    End Sub

    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Private Sub rptDevolution_DataSourceRowChanged(sender As Object, e As DevExpress.XtraReports.UI.DataSourceRowEventArgs) Handles MyBase.DataSourceRowChanged
        Dim tipoDevolucion As String = GetCurrentColumnValue("TypeDevolution")
        If tipoDevolucion = "1" Then
            lblTipoDevolucion.Text = "Justificada"
        ElseIf tipoDevolucion = "2" Then
            lblTipoDevolucion.Text = "Injustificada"
        End If
    End Sub

    Private Sub rptDevolution_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles MyBase.BeforePrint

        Me.INDLblNombreEmpresaCliente.Text = IndigoSessionValues.IndigoCompanyName
        Me.INDLblNitCliente.Text = IndigoSessionValues.IndigoCompanyNit

    End Sub
End Class