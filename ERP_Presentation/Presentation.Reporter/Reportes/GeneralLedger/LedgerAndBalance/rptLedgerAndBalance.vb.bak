Public Class rptLedgerAndBalance
    Implements IReport

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance

    ''' <summary>
    ''' Variable par obtener la tabla de Trazabilidad
    ''' </summary>
    Dim dtReportLedgerAndBalance As DataTable

    Dim currencyAbbreviation As String

    Dim a As Integer
    'Dim PreviousBalanceClass As Long = 0
    'Dim NewBalanceClass As Long = 0

    'Dim PreviousBalanceGroup As Long = 0
    'Dim NewBalanceGroup As Long = 0

