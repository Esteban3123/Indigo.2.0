#Region "Librerias Improtadas"
Imports Infrastructure.CrossCutting.Base
Imports Infrastructure.Data.Xpo
Imports Infrastructure.Data.Xpo.AccountingRepository
Imports Domain.Entities
Imports DevExpress.XtraReports.UI
Imports System.Drawing.Printing
Imports Presentation.Base

#End Region

Public Class rptListAccountingVoucher
    Implements IReport

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance
    Dim INDList
    Public Sub CargarDataSource() Implements IReport.CargarDataSource
        Try

            Dim filtroConsulta As String = Nothing
            filtroConsulta = "IdAccounting.VoucherDate >= #" & Format(ParametrosReporte(0), "yyyy-MM-dd") & "# AND IdAccounting.VoucherDate <= #" & Format(ParametrosReporte(1), "yyyy-MM-dd") & "# AND IdAccounting.LegalBookId = " & ParametrosReporte(3)

            'filtro por estado
            If (ParametrosReporte(2) <> 4) Then
                filtroConsulta &= " AND IdAccounting.Status = " & ParametrosReporte(2)
            End If

            'filtro por tipo de comprobante
            If ParametrosReporte(4) IsNot Nothing And ParametrosReporte(5) IsNot Nothing Then
                filtroConsulta &= " AND IdAccounting.IdJournalVoucher.Code >= '" & ParametrosReporte(4) & "' AND IdAccounting.IdJournalVoucher.Code <= '" & ParametrosReporte(5) & "'"
            End If

            'filtro por comprobante
            If ParametrosReporte(6) IsNot Nothing And ParametrosReporte(7) IsNot Nothing Then
                filtroConsulta &= " AND IdAccounting.Consecutive >= " & ParametrosReporte(6) & " AND IdAccounting.Consecutive <= " & ParametrosReporte(7)
            End If

            'filtro por Tercero
            If ParametrosReporte(8) IsNot Nothing And ParametrosReporte(9) IsNot Nothing Then
                filtroConsulta &= " AND IdThirdParty.Nit >= '" & ParametrosReporte(8) & "' AND IdThirdParty.Nit <= '" & ParametrosReporte(9) & "'"
            End If

            INDList = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.GetCollection(Of JournalVoucherDetailsXpo)(Nothing, filtroConsulta)

            Me.DataSource = INDList
        Catch ex As Exception
            MessageIndigo.Show(GetExceptionDetails(ex), MessageType.Errores, Me.Text, Botones.Aceptar, "")
        End Try
    End Sub

    Public Function GetExceptionDetails(exception As Exception) As String
        Dim properties = exception.[GetType]().GetProperties()
        Dim fields = properties.[Select](Function([property]) New With { _
            Key .Name = [property].Name, _
            Key .Value = [property].GetValue(exception, Nothing) _
        }).[Select](Function(x) [String].Format("{0} : {1}", x.Name, If(x.Value IsNot Nothing, x.Value.ToString(), [String].Empty)))
        Return [String].Join(vbLf, fields)
    End Function

    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Private Sub rptListAccountingVoucher_BeforePrint(sender As Object, e As PrintEventArgs) Handles MyBase.BeforePrint
        INDLblCompany.Text = IndigoSessionValues.IndigoCompanyName
        INDLblNitCompany.Text = "Nit:" & IndigoSessionValues.IndigoCompanyNit
        INDLblDates.Text = "Informe comprendido entre " & CDate(ParametrosReporte(0)).ToString("dd De MMMM Del yyyy") & " " & CDate(ParametrosReporte(1)).ToString("A dd De MMMM Del yyyy")
        Me.INDLblUserPrint.Text = "Usuario Impresión : " & IndigoSessionValues.UserIndigo & " - " & IndigoSessionValues.UserIndigoName
        Me.INDLblBook.Text = ParametrosReporte(10).ToString()
    End Sub
End Class