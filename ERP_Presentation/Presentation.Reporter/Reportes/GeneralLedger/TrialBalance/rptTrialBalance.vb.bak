#Region "Sumatoria Cuenta"

#Region "Saldo Anterior"

    Private Sub XrTableCell45_SummaryGetResult(sender As Object, e As SummaryGetResultEventArgs) Handles XrTableCell45.SummaryGetResult
        If GetCurrentColumnValue("nature") = "Debito" Then
            If totalSumAccount >= 0 Then
                e.Result = CStr(Microsoft.VisualBasic.Format(totalSumAccount, "c2")) & " DB"
            Else
                e.Result = CStr(Microsoft.VisualBasic.Format(Math.Abs(totalSumAccount), "c2")) & " CR"
            End If
        Else
            If totalSumAccount >= 0 Then
                e.Result = CStr(Microsoft.VisualBasic.Format(totalSumAccount, "c2")) & " CR"
            Else
                e.Result = CStr(Microsoft.VisualBasic.Format(Math.Abs(totalSumAccount), "c2")) & " DB"
            End If
        End If
        e.Handled = True
    End Sub

    Private Sub XrTableCell45_SummaryReset(sender As Object, e As EventArgs) Handles XrTableCell45.SummaryReset
        totalSumAccount = 0
    End Sub

    Private Sub XrTableCell45_SummaryRowChanged(sender As Object, e As EventArgs) Handles XrTableCell45.SummaryRowChanged
        totalSumAccount += Convert.ToDecimal(GetCurrentColumnValue("previousBalance"))
    End Sub

#End Region

