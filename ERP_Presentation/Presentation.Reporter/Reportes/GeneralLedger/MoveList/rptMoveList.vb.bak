#Region "Librerias Improtadas"
Imports Infrastructure.CrossCutting.Base
Imports Infrastructure.Data.Xpo
Imports Infrastructure.Data.Xpo.AccountingRepository
Imports Domain.Entities
Imports DevExpress.XtraReports.UI
Imports System.Drawing.Printing
Imports Infrastructure.CrossCutting.Resources

#End Region

Public Class rptMoveList
    Implements IReport

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance

    Dim listreport As List(Of JournalVoucherDetailsXpo)

    Public Sub CargarDataSource() Implements IReport.CargarDataSource
        'armar criteria 

        Dim filtroConsulta As String = "IdAccounting.IdJournalVoucher.Code >= '" & ParametrosReporte(2) & "' And IdAccounting.IdJournalVoucher.Code <= '" & ParametrosReporte(3) & "' AND IdAccounting.LegalBookId = " & ParametrosReporte(5)
        'si filtra por fecha
        If ParametrosReporte(0) IsNot Nothing And ParametrosReporte(1) IsNot Nothing Then
            filtroConsulta &= "And GetDate(IdAccounting.VoucherDate) >= #" & Format(ParametrosReporte(0), "yyyy-MM-dd") & "# AND GetDate(IdAccounting.VoucherDate) <= #" & Format(ParametrosReporte(1), "yyyy-MM-dd") & "#"
        End If
        If ParametrosReporte(4) <> 4 Then
            filtroConsulta &= "AND IdAccounting.Status = " & ParametrosReporte(4)
        End If

        listreport = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).AccountingService.GetCollection(Of JournalVoucherDetailsXpo)(Nothing, filtroConsulta)
        For Each item In listreport

            If item.IdAccounting.EntityCode IsNot Nothing AndAlso item.IdAccounting.EntityCode.Count > 0 Then
                item.IdAccounting.EntityCodeNameText = String.Format(ResourceManager.GetString(item.IdAccounting.EntityName), item.IdAccounting.EntityCode)
            Else
                item.IdAccounting.EntityCodeNameText = String.Format(ResourceManager.GetString("JournalVoucher"), item.IdAccounting.Consecutive)
            End If
        Next
        Me.DataSource = listreport
    End Sub

    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Private Sub rptMoveList_BeforePrint(sender As Object, e As PrintEventArgs) Handles MyBase.BeforePrint

        Me.INDLblCompany.Text = IndigoSessionValues.IndigoCompanyName
        Me.INDLblNitCompany.Text = "Nit : " & IndigoSessionValues.IndigoCompanyNit
        Me.INDLblUserPrint.Text = "Usuario Impresión : " & IndigoSessionValues.UserIndigo & " - " & IndigoSessionValues.UserIndigoName
        INDLblSubtitle.Text = "PARA LOS COMPROBANTES:" & ParametrosReporte(2) & " A " & ParametrosReporte(3)

    End Sub
End Class