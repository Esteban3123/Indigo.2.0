    Private Sub XrTable8_BeforePrint(sender As Object, e As PrintEventArgs) Handles XrTable8.BeforePrint
        Dim table As XRTable = CType(sender, XRTable)
        If GetCurrentColumnValue("Detail") = String.Empty Then
            table.HeightF = 0
            table.Visible = False
            Detail.HeightF = 20
        Else
            table.Visible = True
            table.HeightF = 20
            Detail.HeightF = 40
        End If
    End Sub
