Public Class rptCGN001BalanceAndMovement
    Implements IReport

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance

    ''' <summary>
    ''' Variable par obtener la tabla de Trazabilidad
    ''' </summary>
    Dim dtCGN001BalanceAndMovement As DataTable

    Public Sub CargarDataSource() Implements IReport.CargarDataSource

    End Sub

    Public Async Function CargarDataSource1() As task
        Try
            Dim ds As DataSet = Await IndigoConecta.Instancia.CurrentCloud.IndigoAccounting.GetListReportCGN001Async(ParametrosReporte(0), Me.ParametrosReporte(1), ParametrosReporte(2), ParametrosReporte(3), ParametrosReporte(4), ParametrosReporte(5), Me.IndigoSessionValues)
            If ds IsNot Nothing Then
                dtCGN001BalanceAndMovement = ds.Tables("ReportCGN001")
                Me.DataSource = dtCGN001BalanceAndMovement
                Me.DataMember = "ReportCGN001"
            Else
                Me.DataSource = Nothing
            End If

        Catch ex As Exception
            MessageIndigo.Show(GetExceptionDetails(ex), MessageType.Errores, Me.Text, Botones.Aceptar, "")
        End Try
    End Function

    Public Function GetExceptionDetails(exception As Exception) As String
        Dim properties = exception.[GetType]().GetProperties()
        Dim fields = properties.[Select](Function([property]) New With { _
            Key .Name = [property].Name, _
            Key .Value = [property].GetValue(exception, Nothing) _
        }).[Select](Function(x) [String].Format("{0} : {1}", x.Name, If(x.Value IsNot Nothing, x.Value.ToString(), [String].Empty)))
        Return [String].Join(vbLf, fields)
    End Function

    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Private Sub rptCGN001BalanceAndMovement_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles MyBase.BeforePrint
        Me.INDLblUserPrint.Text = "Usuario Impresión : " & IndigoSessionValues.UserIndigo & " - " & IndigoSessionValues.UserIndigoName
        If ParametrosReporte(7) IsNot Nothing Then
            Dim operatingUnit = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).CommonService.ListOperatingUnitById(ParametrosReporte(7))
            Me.INDLblDepartmentValue.Text = operatingUnit(0).IdCity.DepartamentId.Descripcion
            Me.INDLblCityValue.Text = operatingUnit(0).IdCity.Descripcion
            Me.INDLblEntityCodeValue.Text = operatingUnit(0).IPSCode
        End If
        Dim thirdParty As DevExpress.Xpo.XPCollection = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).CommonService.GetThirdPartyByNit(IndigoSessionValues.IndigoCompanyNit)
        If thirdParty IsNot Nothing Then
            Me.INDLblEntityCodeValue.Text = thirdParty(0).EntityCode
            Me.INDLblEntityNameValue.Text = thirdParty(0).Name
        End If

        Dim startPeriod = DateAdd(DateInterval.Month, -2, ParametrosReporte(1))
        Dim endPeriod = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Month, 1, ParametrosReporte(1)))

        Me.INDLblDateCortValue.Text = endPeriod.ToString("dd/MM/yyyy")
        Me.INDLblPeriod.Text = startPeriod.ToString("dd \de MMMM") & " al " & endPeriod.ToString("dd \de MMMM \de yyyy")
        Me.INDPrTextValue.Value = ParametrosReporte(6)
    End Sub

    Private Sub XrTableCell11_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles XrTableCell11.BeforePrint
        Dim cell As XRTableCell = CType(sender, XRTableCell)
        If ParametrosReporte(6) = True Then
            cell.Text = Format(Math.Round((CDec(GetCurrentColumnValue("mainAccountPreviousBalance")) / 1000), 0), "c2")
        End If
    End Sub

