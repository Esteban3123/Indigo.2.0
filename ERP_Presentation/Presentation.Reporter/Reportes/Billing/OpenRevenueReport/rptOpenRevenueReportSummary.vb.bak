#Region "Librerias Importadas"

Imports Infrastructure.CrossCutting.Base
Imports Infrastructure.Data.Xpo
Imports Infrastructure.Data.Xpo.BillingRepository

#End Region

Public Class rptOpenRevenueReportSummary
    Implements IReport
    Implements IReportAsync

    ''' <summary>
    ''' Variable para inicializar los valores de sesion
    ''' </summary>
    Dim IndigoSessionValues As SessionValues = SessionValues.Instance
    Dim _text As String
    Dim _datasource As List(Of ViewOpenRevenueReportSummaryXpo)
    Dim Count As Integer
    Dim list As List(Of String)

    Public Sub CargarDataSource() Implements IReport.CargarDataSource
        Dim filter As String = Nothing

        'filtro por fechas
        If ParametrosReporte(0) IsNot Nothing And ParametrosReporte(1) IsNot Nothing Then
            filter = "GetDate(DateIncome) >= #" & Format(ParametrosReporte(0), "yyyy-MM-dd") & "# AND GetDate(DateIncome) <= #" & Format(ParametrosReporte(1), "yyyy-MM-dd") & "#"
        End If

        'si filtra por Estado
        If ParametrosReporte(2) <> 4 Then
            filter &= If(String.IsNullOrEmpty(filter), "", " AND ") & String.Format("Status IN ({0})", ParametrosReporte(2))
        End If

        'si filtra por grupo de atencion
        If Not String.IsNullOrEmpty(ParametrosReporte(3)) Then
            filter &= If(String.IsNullOrEmpty(filter), "", " AND ") & String.Format("CareGroupId IN ({0})", ParametrosReporte(3))
        End If

        'si filtra por centro de atencion
        If Not String.IsNullOrEmpty(ParametrosReporte(4)) Then
            filter &= If(String.IsNullOrEmpty(filter), "", " AND ") & String.Format("CodCareCenter IN ({0})", ParametrosReporte(4))
        End If

        'si filtra por Entidad
        If Not String.IsNullOrEmpty(ParametrosReporte(5)) Then
            filter &= If(String.IsNullOrEmpty(filter), "", " AND ") & String.Format("EntityId IN ({0})", ParametrosReporte(5))
        End If

        'si filtra por Usuario
        If Not String.IsNullOrEmpty(ParametrosReporte(6)) Then
            filter &= If(String.IsNullOrEmpty(filter), "", " AND ") & String.Format("CodCreationUser IN ({0})", ParametrosReporte(6))
        End If

        'si filtra por documento
        If Not String.IsNullOrEmpty(ParametrosReporte(7)) AndAlso ParametrosReporte(7) = 1 Then
            filter &= If(String.IsNullOrEmpty(filter), "", " AND ") & String.Format("FolioOrder IN ({0})", ParametrosReporte(7))
        End If
        _datasource = XpoServiceEx.Instance(IndigoSessionValues.TransactionalContainer).BillingService.GetCollection(Of ViewOpenRevenueReportSummaryXpo)(Nothing, filter)
        Me.BindingSource1.DataSource = _datasource

    End Sub

    Public Function CargarDataSourceAsync() As Task Implements IReportAsync.CargarDataSourceAsync
        Return Task.Factory.StartNew(AddressOf CargarDataSource)
    End Function

    Public Sub CargarImagenes() Implements IReport.CargarImagenes

    End Sub

    Public ReadOnly Property NameReport As String Implements IReport.NameReport
        Get
            Return ""
        End Get
    End Property

    Public Property ParametrosReporte As Object() Implements IReport.ParametrosReporte

    Private Sub rptOpenRevenueReportSummary_BeforePrint(sender As Object, e As Printing.PrintEventArgs) Handles MyBase.BeforePrint
        list = New List(Of String)

        For Each Item In _datasource
            list.Add(Item.Income.ToString)
        Next
        Count = list.Distinct.Count

        XrTableCell6.Text = Count
        If ParametrosReporte(7) = 3 Then
            Select Case ParametrosReporte(8)
                Case 1
                    _text = "CENTRO DE ATENCIÓN"
                Case 2
                    _text = "ENTIDAD"
                Case 3
                    _text = "GRUPO DE ATENCIÓN"
                Case 4
                    _text = "USUARIOS"
                Case 5
                    _text = "ESTADO DE FOLIO"
                Case Else
                    _text = ""
            End Select
            Me.INDLblTitle.Text = "INGRESOS ABIERTOS - RESUMIDO :" & _text
        End If
        Me.INDLblNameCompany.Text = IndigoSessionValues.IndigoCompanyName
        Me.INDLblNitCompany.Text = "Nit : " & IndigoSessionValues.IndigoCompanyNit
        Me.INDUserImp.Text = "Usuario Impresión: " & IndigoSessionValues.UserIndigo & " - " & IndigoSessionValues.UserIndigoName

        Me.INDPrmGroupBy.Value = ParametrosReporte(8)
        Me.INDTypeReport.Value = ParametrosReporte(7)
        If ParametrosReporte(0) IsNot Nothing And ParametrosReporte(1) IsNot Nothing Then
            Me.INDLblSubTitle.Text = "Informe comprendido entre " & CDate(Me.ParametrosReporte(0)).ToString("dd De MMMM Del yyyy") & " " & CDate(Me.ParametrosReporte(1)).ToString("A dd De MMMM Del yyyy")
        End If
    End Sub

End Class