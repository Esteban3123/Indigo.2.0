#Region "Methods and Functions"

    ''' <summary>
    ''' Validates the items note and advance.
    ''' </summary>
    ''' <returns></returns>
    Private Async Function ValidateItemsNoteAndAdvance() As Task(Of Boolean)
        If DatasourceDischargeBillPopUp IsNot Nothing AndAlso DatasourceDischargeBillPopUp.Count > 0 Then
            Using model As New MVoucherTransaction(Me.Tag)
                Dim result = Await model.GetAccountPayableInNoteAndAdvance(DatasourceDischargeBillPopUp.Select(Function(o) o.IdAccountPayable).ToList(), _voucherTransaction.Code)
                If result IsNot Nothing AndAlso result.ObjectEmbbeded.Count > 0 Then
                    Using frmValidations As New FrmValidationWarning
                        frmValidations.Datasource = result.ObjectEmbbeded
                        Dim frmTransparent As New FrmTransparent(frmValidations, False)
                        If frmTransparent.ShowDialog(Me) <> System.Windows.Forms.DialogResult.OK Then
                            Return False
                        End If
                    End Using
                End If
            End Using
        End If
        Return True
    End Function

    ''' <summary>
    ''' Consulta el total de los debitos y creditos
    ''' </summary>
    ''' <returns></returns>
    Private Function getVoucherValue() As Tuple(Of Decimal, Decimal)
        Dim _byMilValue As Decimal = 0
        If TaxByMilValue IsNot Nothing AndAlso TaxByMilValue <> 0 Then
            _byMilValue = TaxByMilValue
        End If
        Return New Tuple(Of Decimal, Decimal)(Value, _byMilValue)
    End Function

    ''' <summary>
    ''' Metodo para establecer la logica para los permisos de Guardar y Actualizar True -&gt; Muestra Guardar | False -&gt; Muestra Actualizar
    ''' </summary>
    ''' <param name="existeDatos"></param>
    Public Sub LogicaBotonActualizar(existeDatos As Boolean) Implements IcrudBase.LogicaBotonActualizar

    End Sub

    ''' <summary>
    ''' Esta propiedad se utiliza para Registrar en el visor de eventos
    ''' </summary>
    Public WriteOnly Property Mensaje(Icono As Base.EeventViewerImages) As String Implements IcrudBase.Mensaje
        Set(value As String)
            If Icono = EeventViewerImages.Advertencia Then
                MessageIndigo.Show(value, MessageType.Warning, Me.Text)
            ElseIf Icono = EeventViewerImages.Informacion Then
                MessageIndigo.Show(value, MessageType.Information, Me.Text)
            ElseIf Icono = EeventViewerImages.MensajeError Then
                MessageIndigo.Show(value, MessageType.Errores, Me.Text, Botones.Aceptar, "")
            End If
        End Set
    End Property

    ''' <summary>
    ''' este metodo abre el frontal de busqueda
    ''' </summary>
    Public Sub OpenSearch() Implements IcrudBase.OpenSearch
        If BarraBotones.PermiteConsultar = False Then
            Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("NoPermissions")
            Exit Sub
        End If
        If OpenFormDialog = False Then
            Dim listStatus As New List(Of Tuple(Of String, Byte))
            listStatus.Add(New Tuple(Of String, Byte)(ResourceManager.GetString("StateUnconfirmed"), 1))
            listStatus.Add(New Tuple(Of String, Byte)(ResourceManager.GetString("StateConfirmed"), 2))
            listStatus.Add(New Tuple(Of String, Byte)(ResourceManager.GetString("StatusCanceled"), 3))
            listStatus.Add(New Tuple(Of String, Byte)(ResourceManager.GetString("StatusReverse"), 4))

            Dim listClass As New List(Of Tuple(Of String, Integer))
            listClass.Add(New Tuple(Of String, Integer)("Pago", 1))
            listClass.Add(New Tuple(Of String, Integer)("Reembolso", 2))
            listClass.Add(New Tuple(Of String, Integer)("Traslado", 3))

            FormSearchObjects = New FrmBusqueda
            AddHandler FormSearchObjects.ReturnValue, AddressOf ReturnValue
            With FormSearchObjects
                .ListaColumnas = {New ColumnInfo() With {.Caption = "Consecutivo", .FieldName = "Code", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.1},
                                  New ColumnInfo() With {.Caption = "Clase", .FieldName = "VoucherClass", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.1, .ColumnEdit = True, .ListItemsDatasourceColumEdit = listClass},
                                  New ColumnInfo() With {.Caption = "Tercero", .FieldName = "IdThirdParty.NitName", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.25},
                                  New ColumnInfo() With {.Caption = "Fecha Doc", .FieldName = "DocumentDate", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.1},
                                  New ColumnInfo() With {.Caption = "Detalle", .FieldName = "Detail", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.15},
                                  New ColumnInfo() With {.Caption = "Valor", .FieldName = "Value", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.1, .ColumnFormat = "C0"},
                                  New ColumnInfo() With {.Caption = "Tasa X Mil", .FieldName = "TaxByMilValue", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.1, .ColumnFormat = "C0"},
                                  New ColumnInfo() With {.Caption = "Estado", .FieldName = "Status", .ColumnWidth = System.Windows.Forms.SystemInformation.PrimaryMonitorSize.Width * 0.1, .ColumnEdit = True, .ListItemsDatasourceColumEdit = listStatus}}.ToList
                .ValorSolicitado = "Code"
                .ListadoOrigenDatos = Infrastructure.CrossCutting.Base.eDataSource.ListAllVoucherTransaction
                .FormParent = Me
                .ShowSearch()
            End With
        End If
    End Sub

    ''' <summary>
    ''' Devuelve el valor del OpenSearch.
    ''' </summary>
    ''' <param name="ReturnValue">The return value.</param>
    ''' <param name="ReturnObject">The return object.</param>
    Private Async Sub ReturnValue(ByVal ReturnValue As String, ByVal ReturnObject As Object)
        DeleteBlockedRecord()
        INDbteCode.Text = ReturnValue
        If INDbteCode.Text <> String.Empty Then
            Await LoadControls()
            If INDbteCode.Enabled = False Then
                BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Buscar) = True
            End If
            INDbteCode.Enabled = False
        End If
    End Sub

    ''' <summary>
    ''' Esta propiedad establece el valor ControlAcciones
    ''' </summary>
    Public WriteOnly Property ActionsOnControls As Boolean Implements IVoucherTransaction.ActionsOnControls
        Set(value As Boolean)

            INDlycRoot.BeginUpdate()
            'Grupo Principal
            INDbteCode.Enabled = Not value
            INDsleThirdParty.Enabled = value
            INDdeDate.Enabled = value
            INDmeDetail.Enabled = value

            'Tipo Egreso
            INDgleExpenseType.Enabled = value
            INDsleEntityAccount.Enabled = value
            INDsleCash.Enabled = value
            INDsleCostCenter.Enabled = value
            INDglePaymentMethod.Enabled = value
            INDtxtDebitNote.Enabled = value
            INDdeTransactionDate.Enabled = value
            INDrgXMil.Enabled = False
            INDgleVoucherClass.Enabled = value

            'Conceptos de Egreso
            INDGcVoucherTransactionDetail.Enabled = value
            Me.BarraBotones.StatusRecordVisible = value

            INDlycRoot.EndUpdate()

            If value Then
                INDgleVoucherClass.Focus()
                INDdeDate.Properties.ReadOnly = True
            Else
                INDbteCode.Focus()
            End If
        End Set
    End Property

    ''' <summary>
    ''' Limpia los controles
    ''' </summary>
    Public Sub CleanControls()
        If _voucherTransaction IsNot Nothing AndAlso _voucherTransaction.Id = 0 AndAlso IdCheckBook <> 0 AndAlso CheckNumber <> 0 Then
            DeleteCheckBlock()
        End If
        INDlycRoot.BeginUpdate()
        ActionsOnControls = False
        'Grupo Principal
        INDbteCode.EditValue = Nothing
        INDsleThirdParty.EditValue = Nothing
        INDdeDate.EditValue = Nothing
        Value = 0
        INDmeDetail.EditValue = Nothing
        ReadOnlyControls(False)
        INDcolBalanceShare.Visible = True
        'Tipo Egreso
        INDgleExpenseType.EditValue = Nothing
        INDsleEntityAccount.EditValue = Nothing
        INDsleCash.EditValue = Nothing
        INDsleCostCenter.EditValue = Nothing
        PaymentMethod = Nothing
        INDtxtDebitNote.EditValue = Nothing
        INDtxtCheck.EditValue = Nothing
        INDdeTransactionDate.EditValue = Nothing
        INDrgXMil.EditValue = False
        TaxByMilValue = 0
        INDgleVoucherClass.EditValue = Nothing
        EntityBankAccount = Nothing
        INDlgrExpenditureConcept.HideControl(True)
        INDliThirdParty.HideControl(True)
        INDlgrExpenditureConcept.HideControl(True)

        INDgleExpenseType.Properties.ReadOnly = True
        IdCheckBook = Nothing
        CheckNumber = Nothing
        EntityBankAccountDatasourceGrid = Nothing
        DischargeBillDatasource = Nothing
        DatasourceDischargeBillPopUp = Nothing
        VoucherTransactionDetailDatasource = Nothing
        INDGcVoucherTransactionDetail.DataSource = Nothing
        INDlycRoot.EndUpdate()
        Me._voucherTransaction = Nothing
        Me._doc = Nothing
        Me.BarraBotones.EnableBarItems()
        Me.BarraBotones.DisableBarDocument()
        INDsbAddExpenseConcept.Enabled = False
        'variables que retorna el evento agregar del concepto de egreso
        _modeEditPopUpExpenseConcept = False
        ListVoucherTransactionAdvance = Nothing
        _statePopUpCash = False
        _statePopUpCostCenter = False
        _statePopUpThird = False
        _statePopUpEntityBankAccount = False
        ctrTmp.PrintValueVoucher()
        'null text
        INDsleThirdParty.Properties.NullText = String.Empty
        INDsleCash.Properties.NullText = String.Empty
        INDsleCostCenter.Properties.NullText = String.Empty
        INDsleEntityAccount.Properties.NullText = String.Empty
        Me.BarraBotones.StatusRecord = Nothing
        Me.BarraBotones.StatusRecordVisible = False
        Me.BarraBotones.CleanAuditBasic()
        Me.BarraBotones.ReassignOperatingUnit()
        'Ocultar layouts
        INDliEntityBankAccount.HideControl(True)
        INDliCash.HideControl(True)
        INDliCostCenter.HideControl(True)
        INDliPaymentMethod.HideControl(True)
        INDliDebitNote.HideControl(True)
        INDliCheck.HideControl(True)
        INDliTransactionDate.HideControl(True)
        'INDliXMil.HideControl(True)
        INDsleThirdParty.Properties.ReadOnly = False
        'INDgleExpenseType.Properties.ReadOnly = False

        If indigo.UserViewMode AndAlso Not Me.FormSearchObjects.IsDisposed Then
            Me.BarraBotones.PrepareToolbar(eAction.OnlyNew)
        Else
            Me.BarraBotones.PrepareToolbar(eAction.NewAndFind)
        End If

        DeleteBlockedRecord()
    End Sub

    ''' <summary>
    ''' Validates the fields.
    ''' </summary>
    ''' <returns></returns>
    Private Function ValidateFields() As Boolean
        If ValidateControls() Then
            If VoucherTransactionDetailDatasource Is Nothing OrElse VoucherTransactionDetailDatasource.Count = 0 Then
                Mensaje(EeventViewerImages.Advertencia) = String.Format(ResourceManager.GetString("VoucherTransactionConceptNotFound", NAME_MODULE))
                Return False
            End If
            Return True
        Else
            Return False
        End If
    End Function

    ''' <summary>
    ''' Cargamos los estados de la barra
    ''' </summary>
    Private Sub LoadStatus()
        Dim listStates As New List(Of StatusRecord)()
        listStates.Add(New StatusRecord With {.StatusValue = "1", .StatusName = ResourceManager.GetString("StateUnconfirmed"), .StatusColor = System.Drawing.Color.FromArgb(CType(CType(104, Byte), Integer), CType(CType(33, Byte), Integer), CType(CType(204, Byte), Integer))})
        listStates.Add(New StatusRecord With {.StatusValue = "2", .StatusName = ResourceManager.GetString("StateConfirmed"), .StatusColor = System.Drawing.Color.FromArgb(CType(CType(0, Byte), Integer), CType(CType(122, Byte), Integer), CType(CType(204, Byte), Integer))})
        listStates.Add(New StatusRecord With {.StatusValue = "3", .StatusName = ResourceManager.GetString("StatusCanceled"), .StatusColor = System.Drawing.Color.FromArgb(CType(CType(231, Byte), Integer), CType(CType(76, Byte), Integer), CType(CType(60, Byte), Integer))})
        listStates.Add(New StatusRecord With {.StatusValue = "4", .StatusName = ResourceManager.GetString("StatusReverse"), .StatusColor = System.Drawing.Color.FromArgb(CType(CType(231, Byte), Integer), CType(CType(76, Byte), Integer), CType(CType(60, Byte), Integer))})
        listStates.Add(New StatusRecord With {.StatusValue = "-1", .StatusName = ResourceManager.GetString("StatusCanceled"), .StatusColor = System.Drawing.Color.White})
        Me.BarraBotones.States = listStates
    End Sub

    ''' <summary>
    ''' Generates the document.
    ''' </summary>
    ''' <returns></returns>
    Private Function GenerateDoc() As IndexedDocument2

        Select Case VoucherClass
            Case eVoucherClass.Payment
                Dim _behavior As Integer = VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6).Cast(Of VoucherTransactionDetails).ToList().Select(Function(y) y.ExpenseConceptBehavior).FirstOrDefault()
                Dim dateServer = Me.GetDateServer()
                Select Case _behavior
                    Case 1 'traslado entre bancos
                        Dim IdEntityBankAccountDetail As Integer = VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6).Cast(Of VoucherTransactionDetails).ToList().Select(Function(y) y.IdEntityBankAccount).FirstOrDefault()
                        Using Model As New MEntityAccount(Me.Tag)
                            Dim _entityAccount As EntityBankAccounts = Model.GetEntityBankAccountByIdSimple(IdEntityBankAccountDetail)
                            If Me._doc Is Nothing Then
                                Me._doc = New IndexedDocument2 With {
                                    .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_BankTransfer", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text, String.Concat(_entityAccount.Code, " - ", _entityAccount.Bank.Name, " CTA. ", _entityAccount.Type, " ", _entityAccount.Number)),
                                    .CreationDate = dateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                                    .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                                    .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                                    .Update = dateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                            Else
                                Me._doc.Update = dateServer
                                Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                                Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_BankTransfer", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text, String.Concat(_entityAccount.Code, " - ", _entityAccount.Bank.Name, " CTA. ", _entityAccount.Type, " ", _entityAccount.Number))
                                Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                            End If
                        End Using
                    Case 2 'caja menor
                        Using Model As New MPUC(Me.Tag)
                            Dim accountO As MainAccounts = Model.GetAccountByIdSimple(_voucherTransaction.IdMainAccount)
                            Dim accountD As MainAccounts = Model.GetAccountByIdSimple(VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6).Cast(Of VoucherTransactionDetails).ToList().Select(Function(y) y.IdMainAccount).FirstOrDefault())
                            If Me._doc Is Nothing Then
                                Me._doc = New IndexedDocument2 With {
                                    .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_MinorCash", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleCash.Text, String.Concat(accountO.Number, " - ", accountO.Name), String.Concat(accountD.Number, " - ", accountD.Name)),
                                    .CreationDate = dateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                                    .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                                    .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                                    .Update = dateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                            Else
                                Me._doc.Update = dateServer
                                Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                                Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_MinorCash", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleCash.Text, String.Concat(accountO.Number, " - ", accountO.Name), String.Concat(accountD.Number, " - ", accountD.Name))
                                Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                            End If
                        End Using
                    Case 3
                        Using Model As New MPUC(Me.Tag)
                            Dim account As MainAccounts = Model.GetAccountByIdSimple(VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6).Cast(Of VoucherTransactionDetails).ToList().
                                                                                     Select(Function(y) y.IdMainAccount).FirstOrDefault())
                            If DatasourceDischargeBillPopUp IsNot Nothing AndAlso DatasourceDischargeBillPopUp.Count > 0 Then
                                Dim _ListBills As String = String.Join(" - ", DatasourceDischargeBillPopUp.Select(Function(x) x.AccountPayableBillNumber).Cast(Of String)().ToList().Distinct().ToList().ToArray())
                                If Me._doc Is Nothing Then
                                    Me._doc = New IndexedDocument2 With {
                                        .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_PaymentAdvancePaymentInvoices", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text, String.Concat(account.Number, " - ", account.Name), _ListBills),
                                        .CreationDate = dateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                                        .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                                        .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                                        .Update = dateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                                Else
                                    Me._doc.Update = dateServer
                                    Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                                    Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_PaymentAdvancePaymentInvoices", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text, String.Concat(account.Number, " - ", account.Name), _ListBills)
                                    Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                                End If
                            End If
                        End Using
                    Case 4 'devolutivo de anticipos ReturningImprestRC
                        Using Model As New MPUC(Me.Tag)
                            Dim _ListCashReceipts As String = String.Join(" - ", (From pa In ListVoucherTransactionAdvance Select pa).Cast(Of VoucherTransactionAdvance).ToList().Select(Function(x) x.PortfolioAdvanceCode).Cast(Of String).ToList().ToArray())
                            Dim account As MainAccounts = Model.GetAccountByIdSimple(VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6).Cast(Of VoucherTransactionDetails).ToList().Select(Function(y) y.IdMainAccount).FirstOrDefault())
                            If Me._doc Is Nothing Then
                                Me._doc = New IndexedDocument2 With {
                                    .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_ReturningImprestRC", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text, _ListCashReceipts),
                                    .CreationDate = dateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                                    .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                                    .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                                    .Update = dateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                            Else
                                Me._doc.Update = dateServer
                                Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                                Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_ReturningImprestRC", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text, _ListCashReceipts)
                                Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                            End If
                        End Using
                    Case 5 'Reembolso caja menor ReturningImprestRC
                    Case Else 'nothing
                        If Me._doc Is Nothing Then
                            Me._doc = New IndexedDocument2 With {
                                .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text),
                                .CreationDate = dateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                                .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                                .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                                .Update = dateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                        Else
                            Me._doc.Update = dateServer
                            Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                            Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent", NAME_MODULE), INDsleThirdParty.Text.Split("-").ElementAt(0), INDsleThirdParty.Text.Split("-").ElementAt(1), INDsleEntityAccount.Text)
                            Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                        End If
                End Select
            Case eVoucherClass.Transfer
                If ExpenseType = 1 Then
                    Dim _listBankAccountDetail As String = String.Join("; ", (From ba In EntityBankAccountDatasourceGrid Select ba).ToList().Select(Function(x) String.Concat(x.EntityCode, " - ", x.EntityName)).Cast(Of String).ToList().ToArray())
                    If Me._doc Is Nothing Then
                        Me._doc = New IndexedDocument2 With {
                            .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_BankTransfer", NAME_MODULE), INDsleEntityAccount.Text, _listBankAccountDetail),
                            .CreationDate = DateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                            .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                            .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                            .Update = DateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                    Else
                        Me._doc.Update = DateServer
                        Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                        Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_BankTransfer", NAME_MODULE), INDsleEntityAccount.Text, _listBankAccountDetail)
                        Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                    End If
                ElseIf ExpenseType = 3 Then
                    Dim _listCashDetail As String = String.Join("; ", (From ba In EntityBankAccountDatasourceGrid Select ba).ToList().Select(Function(x) String.Concat(x.EntityCode, " - ", x.EntityName)).Cast(Of String).ToList().ToArray())
                    If Me._doc Is Nothing Then
                        Me._doc = New IndexedDocument2 With {
                            .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_CashTransfer", NAME_MODULE), INDsleCash.Text, _listCashDetail),
                            .CreationDate = DateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                            .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                            .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                            .Update = DateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                    Else
                        Me._doc.Update = DateServer
                        Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                        Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_CashTransfer", NAME_MODULE), INDsleCash.Text, _listCashDetail)
                        Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                    End If
                End If
            Case eVoucherClass.Refund
                Using Model As New MPUC(Me.Tag)
                    'Dim _ListCashReceipts As String = String.Join(" - ", (From pa In _listRefund Select pa).ToList().Select(Function(x) x.Code).Cast(Of String).ToList().ToArray())
                    'Dim account As MainAccounts = Model.GetAccountByIdSimple(VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6).Cast(Of VoucherTransactionDetails).ToList().Select(Function(y) y.IdMainAccount).FirstOrDefault())
                    Dim dataOrigin As String = String.Empty
                    If _voucherTransaction.IdEntityBankAccount IsNot Nothing Then
                        dataOrigin = "Cuenta Bancaria : " & INDsleEntityAccount.Text
                    Else
                        dataOrigin = "Caja : " & INDsleCash.Text
                    End If
                    If Me._doc Is Nothing Then
                        Me._doc = New IndexedDocument2 With {
                            .Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_PettyCashReimbursement", NAME_MODULE), dataOrigin, dataOrigin),
                            .CreationDate = DateServer, .CreationUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName, .DocumentType = IndexedDocumentType.File,
                            .IdEntity = "$#" & Me.Tag & "_" & Me._voucherTransaction.Code & "#$", .IdForm = Me.Tag,
                            .Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code),
                            .Update = DateServer, .UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName}
                    Else
                        Me._doc.Update = DateServer
                        Me._doc.UpdateUser = Me.indigo.UserIndigo & "-" & Me.indigo.UserIndigoName
                        Me._doc.Content = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexContent_PettyCashReimbursement", NAME_MODULE), dataOrigin, dataOrigin)
                        Me._doc.Title = String.Format(ResourceManager.GetString(Me.GetType().Name & "_IndexTitle", NAME_MODULE), Me._voucherTransaction.Code)
                    End If
                End Using
        End Select
        Return Me._doc
    End Function

    ''' <summary>
    ''' Creates the type of the list expense.
    ''' </summary>
    ''' <exception cref="System.NotImplementedException"></exception>
    Private Sub CreateListExpenseType()
        ListExpenseType = New List(Of Tuple(Of Short, String))
        Select Case VoucherClass
            Case eVoucherClass.Payment
                ListExpenseType.Add(New Tuple(Of Short, String)(1, ResourceManager.GetString("ExpenseTypeBankAccount", NAME_MODULE)))
                ListExpenseType.Add(New Tuple(Of Short, String)(2, ResourceManager.GetString("CashMinor", NAME_MODULE)))
                ListExpenseType.Add(New Tuple(Of Short, String)(3, ResourceManager.GetString("CashMajor", NAME_MODULE)))
            Case eVoucherClass.Refund, eVoucherClass.Transfer
                ListExpenseType.Add(New Tuple(Of Short, String)(1, ResourceManager.GetString("ExpenseTypeBankAccount", NAME_MODULE)))
                ListExpenseType.Add(New Tuple(Of Short, String)(3, ResourceManager.GetString("CashMajor", NAME_MODULE)))
        End Select
        INDgleExpenseType.Properties.DataSource = ListExpenseType
    End Sub

    ''' <summary>
    ''' Crea el listado de las opciones de generado con
    ''' </summary>
    Private Sub CreatePaymentMethod(ByVal Type As Integer)
        ListPaymentMethod = New List(Of Tuple(Of Integer, String))
        If Type = eEntityBankAccountType.Current Then
            ListPaymentMethod.Add(New Tuple(Of Integer, String)(1, ResourceManager.GetString("PaymentMethodCheck", NAME_MODULE)))
        End If
        ListPaymentMethod.Add(New Tuple(Of Integer, String)(2, ResourceManager.GetString("PaymentMethodDebitNote", NAME_MODULE)))
        INDglePaymentMethod.Properties.DataSource = ListPaymentMethod
    End Sub

    ''' <summary>
    ''' Creates the voucher class.
    ''' </summary>
    Private Sub CreateVoucherClass()
        ListVoucherClass = New List(Of Tuple(Of Integer, String))
        ListVoucherClass.Add(New Tuple(Of Integer, String)(1, ResourceManager.GetString("VoucherClassPayment", NAME_MODULE)))
        ListVoucherClass.Add(New Tuple(Of Integer, String)(2, ResourceManager.GetString("VoucherClassRefund", NAME_MODULE)))
        ListVoucherClass.Add(New Tuple(Of Integer, String)(3, ResourceManager.GetString("DocumentTypeConsignmentTransfer", NAME_MODULE)))
        INDgleVoucherClass.Properties.DataSource = ListVoucherClass
    End Sub

    ''' <summary>
    ''' Obtiene el id del detalle de secuencia por el prefijo seleccionado
    ''' </summary>
    ''' <param name="prefix">Prefijo a buscar</param>
    ''' <returns>Id del detalle de secuencia</returns>
    Private Function GetIdSequenceByPrefix(ByVal prefix As String) As Int64
        If Me._sequence IsNot Nothing AndAlso Me._sequence.TreasurySequenceDetail IsNot Nothing AndAlso Me._sequence.TreasurySequenceDetail.Any(Function(d) d.Prefix IsNot Nothing AndAlso d.Prefix.Trim().Equals(prefix)) Then
            Return Me._sequence.TreasurySequenceDetail.Where(Function(d) d.Prefix IsNot Nothing AndAlso d.Prefix.Trim().Equals(prefix)).FirstOrDefault().Id
        Else
            Return 0
        End If
    End Function

    ''' <summary>
    ''' News the voucher transaction.
    ''' </summary>
    Private Async Function NewVoucherTransaction() As Task
        Me._voucherTransaction = New VoucherTransaction()
        If Me._sequence.IsManual Then
            Me.ActionsOnControls = True
            Me.BarraBotones.PrepareToolbar(eAction.OnlySaveConfirm)
            Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.GestionDocumental) = True
            Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Auditoria) = True
        Else
            If Me._sequence.Scope.Equals("O") Then 'El ambito es a nivel de organización
                Me._idCurrentSequence = Me._sequence.TreasurySequenceDetail(0).Id
            ElseIf Me._sequence.Scope.Equals("OU") Then 'El ambito es a nivel de unidad operativa
                If Me._sequence.TreasurySequenceDetail.Any(Function(o) o.IdOperatingUnit = Me._idOperativeUnit) Then
                    Me._idCurrentSequence = Me._sequence.TreasurySequenceDetail.SingleOrDefault(Function(o) o.IdOperatingUnit = Me._idOperativeUnit).Id
                Else
                    Me.Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("OperatingUnitUnassigned")
                    Me.BarraBotones.PrepareToolbar(eAction.OnlyUndo)
                    Exit Function
                End If
            ElseIf Me._sequence.Scope.Equals("CC") Then
                Dim errors = New StringBuilder()
                For Each item In ListVoucherClass
                    If Me._sequence.TreasurySequenceDetail Is Nothing OrElse Not Me._sequence.TreasurySequenceDetail.Any(Function(d) d.Type = item.Item1) Then
                        errors.AppendLine(item.Item2)
                    End If
                Next
                If errors.Length > 0 Then
                    Me.Mensaje(EeventViewerImages.Advertencia) = "No existe una secuencia numérica asignada a los comprobantes de tipo: " & Environment.NewLine & errors.ToString
                    Me.BarraBotones.PrepareToolbar(eAction.OnlyUndo)
                    Exit Function
                End If
            End If
            If Me._sequence.Sequential Then
                Me.Code = ResourceManager.GetString("LabelOrTextboxNew")
                Me.ActionsOnControls = True
                Me.BarraBotones.PrepareToolbar(eAction.OnlySaveConfirm)
                Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.GestionDocumental) = True
                Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Auditoria) = True
            Else
                If Me.DicSequense IsNot Nothing AndAlso Me.DicSequense.Count > 0 Then
                    If Me.DicSequense(CInt(Me._idCurrentSequence)).Count > 0 Then
                        Me.Code = Me.DicSequense(CInt(Me._idCurrentSequence))(0)
                        Me.ActionsOnControls = True
                        Me.BarraBotones.PrepareToolbar(eAction.OnlySaveConfirm)
                        Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.GestionDocumental) = True
                        Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Auditoria) = True
                    Else
                        AsyncLoader(True)
                        Using model As New MCommonTreasury(CStr(Me.Tag))
                            Me.DicSequense(CInt(Me._idCurrentSequence)) = Await model.GetNumericSequenseGroup(CInt(Me._idCurrentSequence))
                        End Using
                        AsyncLoader(False)
                        If Me.DicSequense(CInt(Me._idCurrentSequence)) IsNot Nothing AndAlso Me.DicSequense(CInt(Me._idCurrentSequence)).Count > 0 Then
                            Me.Code = Me.DicSequense(CInt(Me._idCurrentSequence))(0)
                            Me.ActionsOnControls = True
                            Me.BarraBotones.PrepareToolbar(eAction.OnlySaveConfirm)
                            Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.GestionDocumental) = True
                            Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Auditoria) = True
                        Else
                            Me.Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("InvalidPatternSequense")
                        End If
                    End If
                Else
                    Me.Code = ResourceManager.GetString("LabelOrTextboxNew")
                    Me.ActionsOnControls = True
                    Me.BarraBotones.PrepareToolbar(eAction.OnlySaveConfirm)
                    Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.GestionDocumental) = True
                    Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Auditoria) = True
                End If
            End If
        End If
        _presenter.LoadDateServer(Me.GetDateServer())
    End Function

    ''' <summary>
    ''' Elimina el registro bloqueado
    ''' </summary>
    Public Async Sub DeleteBlockedRecord()
        If _record IsNot Nothing AndAlso _record.Id > 0 AndAlso _record.CodUser.Equals(Me.indigo.UserIndigo) Then
            Using ModelCommonTreasury As New MCommonTreasury(Me.Tag)
                Await ModelCommonTreasury.DeleteBlockRecordTreasury(_record)
                _record = Nothing
            End Using
        End If
    End Sub

    Public Sub AsyncLoaderLocal(state As Boolean)
        Me.LyiProgressBar.ContentVisible = state
        Me.ToolBars.Enabled = Not state
        If Not state Then
            ActionsOnControls = Not state
            INDbteCode.Enabled = state
        End If
    End Sub

    ''' <summary>
    ''' Loads the controls.
    ''' </summary>
    Public Async Function LoadControls() As Task
        If Not String.IsNullOrEmpty(Code) AndAlso Not String.IsNullOrWhiteSpace(Code) Then
            Try
                If Me.BarraBotones.PermiteConsultar = False Then
                    Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("NoPermissions")
                    Exit Function
                End If

                Using Model As New MVoucherTransaction(Me.Tag)
                    AsyncLoaderLocal(True)
                    INDlycRoot.BeginUpdate()
                    Dim result As ActionResult(Of VoucherTransaction) = Await Model.GetVoucherTransaction(Me.Code)
                    _voucherTransaction = result.ObjectEmbbeded
                    If _voucherTransaction IsNot Nothing AndAlso _voucherTransaction.Id > 0 Then
                        Me.BarraBotones.StatusRecordVisible = True
                        IsLoading = True
                        Using ModelCommonTreasury As New MCommonTreasury(Me.Tag)
                            _record = Await ModelCommonTreasury.GetBlockRecordTreasury(Me.Tag, _voucherTransaction.Id)
                            Using ModelCashRegisterUser As New MCashRegisterUser(Me.Tag)
                                With _voucherTransaction
                                    Me.BarraBotones.AddAuditBasic(ResourceManager.GetString("CreationUser"), .CreationUser)
                                    Me.BarraBotones.AddAuditBasic(ResourceManager.GetString("CreationDate"), .CreationDate)
                                    Me.BarraBotones.AddAuditBasic(ResourceManager.GetString("ModificationUser"), .ModificationUser)
                                    Me.BarraBotones.AddAuditBasic(ResourceManager.GetString("ModificationDate"), .ModificationDate)
                                    Me.LayoutControls.SetCustomFieldsValue(.CustomProperties)
                                    Code = .Code
                                    VoucherClass = .VoucherClass
                                    IdThirdParty = .IdThirdParty
                                    IdMainAccount = .IdMainAccount
                                    IdCostCenter = .IdCostCenter
                                    obligation = .Detail
                                    DocumentDate = .DocumentDate
                                    ExpenseType = .ExpenseType
                                    IdEntityBankAccount = .IdEntityBankAccount
                                    IdCashRegister = .IdCashRegister
                                    PaymentMethod = .PaymentMethod
                                    NoteNumber = .NoteNumber
                                    IdCheckBook = .IdChecks
                                    CheckNumber = .CheckNumber
                                    TransactionDate = .TransactionDate
                                    TaxByMil = .TaxByMil
                                    TaxByMilValue = .TaxByMilValue
                                    Value = .Value
                                    CashRegisterExpense = .CashRegisterExpense
                                    RefundCashRegisterExpense = .RefundCashRegisterExpense
                                    'IdFundsDispersion = .IdFundsDispersion
                                    BeneficiaryIdentification = .BeneficiaryIdentification
                                    Beneficiary = .Beneficiary
                                    TransactionRelationShip = .TransactionRelationship
                                    CheckReconciled = .CheckReconciled
                                    IdPaymentOrder = .IdPaymentOrder
                                    Printed = .Printed
                                    RTEValue = .RTEValue
                                    IVAValue = .IVAValue
                                    ICAValue = .ICAValue
                                    OtherValue = .OtherValue
                                    BankAccountNumber = .BankAccountNumber
                                    BankName = .BankName
                                    DetailsInterfaceBudget = .DetailsInterfaceBudget
                                    Status = .Status.ToString()
                                End With
                            End Using
                            LoadNullText()
                            Select Case VoucherClass
                                Case eVoucherClass.Payment
                                    VoucherTransactionDetailDatasource = _voucherTransaction.VoucherTransactionDetails.ToList()
                                    Dim resultBehavior = (From x In _voucherTransaction.VoucherTransactionDetails Where x.ExpenseConceptBehavior = 4 Select x.VoucherTransactionAdvance).SingleOrDefault()
                                    If resultBehavior IsNot Nothing Then
                                        ListVoucherTransactionAdvance = (From r In resultBehavior Select r).ToList()
                                    End If
                                    INDsbAddExpenseConcept.Enabled = True
                                Case eVoucherClass.Transfer, eVoucherClass.Refund
                                    EntityBankAccountDatasourceGrid = _voucherTransaction.VoucherTransactionDetails.ToList()
                            End Select
                            Me.GetDocumentIndexed(Me.Tag & "_" & Me._voucherTransaction.Code)
                            If _record.Id = 0 Then
                                _record = (Await ModelCommonTreasury.SaveBlockRecordTreasury(
                                    New BlockRecordTreasury With {.BlockDate = Date.Now, .ChangeTracker = New ObjectChangeTracker() With {.State = ObjectState.Added},
                                        .NameUser = Me.indigo.UserIndigoName, .IdForm = Me.Tag, .CodUser = Me.indigo.UserIndigo, .IdRecord = _voucherTransaction.Id})
                                    ).ObjectEmbbeded
                            Else
                                Dim xtraMessage As String = String.Format(obtenerRecurso(RegistroBloqueado, Comunes), _record.CodUser, _record.NameUser, _record.BlockDate)
                                Me.BarraBotones.ShowXtraMessage(xtraMessage, ImagesXtraLabel.Warning, _record.CodUser)
                            End If
                            Me.BarraBotones.SetDocuments(_voucherTransaction.Id, Me.Tag.ToString(), Nothing, GetType(VoucherTransaction).Name)
                            If _voucherTransaction.Status = 2 OrElse _voucherTransaction.Status = 3 OrElse _voucherTransaction.Status = 4 Then 'estado confirmado
                                ReadOnlyControls(True)
                                INDcolMoreInfo.OptionsColumn.AllowEdit = True
                                INDcolMoreInfo.OptionsColumn.AllowFocus = True
                                INDpopConMoreInfo.Enabled = True
                                INDlcMoreInfo.Enabled = True
                                INDlgrMoreInfo.Enabled = True
                                INDlgrInvoices.Enabled = True
                                INDlgrAdvancePayment.Enabled = True
                                INDlgrBankTraslate.Enabled = True
                                INDlgrRefund.Enabled = True

                                INDcolBalanceShare.Visible = False
                                INDcolAdvanceBalance.Visible = False
                                Me.BarraBotones.PrepareToolbar(eAction.OnlyUndoAndAudit)
                            Else
                                Me.BarraBotones.PrepareToolbar(eAction.OnlyUpdateConfirmIntegratedAnnular)
                                Me.BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Eliminar) = True
                            End If
                            BarraBotones.OcultarBotonesSinPermisos(EbuttonsWithoutPermission.Imprimir) = False
                            Me.BarraBotones.PrintReport(PrintReportAction.None, _voucherTransaction.Id, 0, _voucherTransaction.Id)
                            AsyncLoaderLocal(False)
                            ActionsOnControls = True
                            INDbteCode.Enabled = False
                            INDGvVoucherTransactionDetail.ShowLoadingPanel()
                            Me.BarraBotones.Enabled = False
                            asyncConcepts = New BackgroundWorker()
                            asyncConcepts.WorkerSupportsCancellation = True
                            AddHandler asyncConcepts.DoWork, AddressOf asyncExpense_DoWork
                            AddHandler asyncConcepts.RunWorkerCompleted, AddressOf asyncExpense_Complete
                            asyncConcepts.RunWorkerAsync()
                        End Using
                        Me.RefreshXMilValue()
                        ctrTmp.PrintValueVoucher()
                    Else
                        'Me.Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString(Me.GetType().Name & "_DontExists", NAME_MODULE)
                        'Me.Code = String.Empty
                        'Me.BarraBotones.StatusRecord = eActionsStatusRecords.Inactive
                        AsyncLoaderLocal(False)
                        If Me._sequence.IsManual Then
                            Await Me.NewVoucherTransaction()
                        Else
                            Me.Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString(Me.GetType().Name & "_DontExists", NAME_MODULE)
                            Me.Code = String.Empty
                            Me.BarraBotones.StatusRecord = eActionsStatusRecords.Inactive
                            Deshacer()
                            INDbteCode.Focus()
                        End If
                    End If
                End Using
                IndigoGridControl1.RefreshGrid(INDGcVoucherTransactionDetail)
                INDlycRoot.EndUpdate()
                IsLoading = False
                Me.BarraBotones.LoadReportsAndDefinitions()
                RaiseEvent LoadControlsFinish(ExpenseType)
            Catch ex As Exception
                AsyncLoader(False)
                INDbteCode.Enabled = False
                Throw ex
            End Try
        End If

    End Function

    ''' <summary>
    ''' Asigna los valores a la entidad
    ''' </summary>
    Private Sub AssigningValues()
        With _voucherTransaction
            .CustomProperties = Me.LayoutControls.GetCustomFieldsValue()
            .Code = Code
            .IdMainAccount = IdMainAccount
            .IdCostCenter = IdCostCenter
            .ExpenseType = ExpenseType
            .Detail = obligation.Trim()
            .DocumentDate = DocumentDate
            .IdCashRegister = IdCashRegister
            .IdEntityBankAccount = IdEntityBankAccount
            .Prefix = Me._prefixSelected
            .Value = Value
            .VoucherClass = VoucherClass
            .PaymentMethod = PaymentMethod
            .NoteNumber = NoteNumber
            .IdChecks = IdCheckBook
            .CheckNumber = CheckNumber
            .TransactionDate = TransactionDate
            .TaxByMil = TaxByMil
            .TaxByMilValue = IIf(TaxByMilValue Is Nothing, CType(0, Decimal), TaxByMilValue)
            .CashRegisterExpense = CashRegisterExpense 'CashRegisterExpense (No se incluye en este frontal)
            .RefundCashRegisterExpense = RefundCashRegisterExpense ' RefundCashRegisterExpense (No se incluye en este frontal)
            .SchedulePaymentId = IdFundsDispersion ' IdFundsDispersion (No se incluye en este frontal)

            Dim third As Domain.Entities.ThirdParty = Nothing
            If IdThirdParty IsNot Nothing AndAlso IdThirdParty > 0 Then
                .IdThirdParty = IdThirdParty
                Using Model As New MThirdParty(Me.Tag)
                    third = Model.GetThirdPartyByIdSimple(IdThirdParty)
                End Using
            End If

            Using Formulario As New FrmBeneficiary
                If _voucherTransaction.Id <> 0 Then
                    Formulario.LoadData(.BeneficiaryIdentification, .Beneficiary)
                ElseIf third IsNot Nothing AndAlso third.Id > 0 Then
                    Formulario.LoadData(third.Person.IdentificationNumber, third.Name)
                End If
                Formulario.StartPosition = System.Windows.Forms.FormStartPosition.CenterParent
                Formulario.MinimizeBox = False
                Formulario.MaximizeBox = False
                Dim transparent As New FrmTransparent(Formulario, False)
                transparent.ShowDialog(Me)
                .BeneficiaryIdentification = Formulario.BeneficiaryIdentification
                .Beneficiary = Formulario.BeneficiaryName
            End Using

            .TransactionRelationship = TransactionRelationShip ' TransactionRelationShip (No se incluye en este frontal)
            .CheckReconciled = CheckReconciled ' CheckReconciled (No se incluye en este frontal)
            .IdPaymentOrder = IdPaymentOrder ' IdPaymentOrder (No se incluye en este frontal)
            .Printed = Printed ' Printed (No se incluye en este frontal)
            .RTEValue = RTEValue ' RTEValue
            .IVAValue = IVAValue ' IVAValue
            .ICAValue = ICAValue ' ICAValue
            .OtherValue = OtherValue ' OtherValue

            If .IdEntityBankAccount IsNot Nothing Then
                Using Model As New MEntityAccount(Me.Tag)
                    Dim cuentaBancaria As EntityBankAccounts = Model.GetEntityBankAccountByIdSimple(.IdEntityBankAccount)
                    .BankAccountNumber = cuentaBancaria.Number
                    Using ModelBank As New Presentation.Common.MVP.MBank(Me.Tag)
                        Dim banco As Domain.Entities.Bank = ModelBank.GetBankById(cuentaBancaria.IdBank)
                        .BankName = banco.Name
                    End Using
                End Using
            End If
            .DetailsInterfaceBudget = DetailsInterfaceBudget
            .IdUnitOperative = Me._idOperativeUnit
            .Status = If(Status Is Nothing, 1, CByte(Status))
        End With

        Select Case VoucherClass
            Case eVoucherClass.Payment
                Dim advance As TreasuryAdvances = Nothing
                For Each voucherDetail As VoucherTransactionDetails In VoucherTransactionDetailDatasource
                    advance = voucherDetail.TreasuryAdvances.FirstOrDefault()
                    If voucherDetail.Id <> 0 AndAlso advance IsNot Nothing Then
                        If voucherDetail.AdvanceValue <> 0 Then
                            advance.Value = voucherDetail.AdvanceValue
                            advance.Detail = voucherDetail.AdvanceDetail
                            advance.MarkAsModified()
                        Else
                            advance.MarkAsDeleted()
                        End If
                        _voucherTransaction.MarkAsModified()
                    Else
                        If voucherDetail.AdvanceValue <> 0 Then
                            advance = New TreasuryAdvances()
                            With advance
                                .IdVoucherTransactionDetail = voucherDetail.Id
                                .Detail = voucherDetail.AdvanceDetail
                                .Value = voucherDetail.AdvanceValue
                            End With
                            voucherDetail.TreasuryAdvances.Add(advance)
                        End If
                    End If
                    'agrego o modifico las facturas
                    voucherDetail.DischargeBill.Clear()
                    If DatasourceDischargeBillPopUp IsNot Nothing Then
                        For Each dischargeBill As DischargeBill In DatasourceDischargeBillPopUp.Where(Function(x) x.ExpenseConceptId = voucherDetail.IdExpenseConcept).ToList()
                            If dischargeBill.Id > 0 Then
                                dischargeBill.MarkAsModified()
                            End If
                            voucherDetail.DischargeBill.Add(dischargeBill)
                        Next
                    End If
                    'marcar como eliminadas las facturas del listado
                    If voucherDetail.DischargeBillDelete IsNot Nothing AndAlso voucherDetail.DischargeBillDelete.Count > 0 Then
                        For Each dischargeBill As DischargeBill In voucherDetail.DischargeBillDelete
                            If dischargeBill.Id > 0 Then
                                dischargeBill.MarkAsDeleted()
                                voucherDetail.DischargeBill.Add(dischargeBill)
                            End If
                        Next
                    End If
                    If ListVoucherTransactionAdvance IsNot Nothing AndAlso ListVoucherTransactionAdvance.Count > 0 And voucherDetail.ExpenseConceptBehavior = 4 Then
                        For Each item In ListVoucherTransactionAdvance
                            If Not (item.ChangeTracker.State = ObjectState.Deleted AndAlso item.Id = 0) Then
                                voucherDetail.VoucherTransactionAdvance.Add(item)
                            End If
                        Next
                    End If
                    If voucherDetail.Id = 0 Then
                        _voucherTransaction.VoucherTransactionDetails.Add(voucherDetail)
                    End If
                Next
            Case eVoucherClass.Transfer, eVoucherClass.Refund
                EntityBankAccountDatasourceGrid.ForEach(Sub(voucherDetail)
                                                            If voucherDetail.Id = 0 Then
                                                                _voucherTransaction.VoucherTransactionDetails.Add(voucherDetail)
                                                            End If
                                                        End Sub)
        End Select

    End Sub

    ''' <summary>
    ''' Limpia los layouts
    ''' </summary>
    Private Sub CleanLayout()
        INDliPaymentMethod.HideControl(True)
        INDliDebitNote.HideControl(True)
        INDliCheck.HideControl(True)
        INDliCostCenter.HideControl(True)
        INDliTransactionDate.HideControl(True)
        'INDliXMil.HideControl(True)
        INDliCash.HideControl(True)
        INDliEntityBankAccount.HideControl(True)
        PaymentMethod = Nothing
        INDsleEntityAccount.EditValue = Nothing
        INDsleCash.EditValue = Nothing
        INDtxtDebitNote.EditValue = Nothing
        INDtxtCheck.EditValue = Nothing
        INDdeTransactionDate.EditValue = Nothing
        INDrgXMil.EditValue = False
        TaxByMilValue = Nothing
        _statePopUpCash = False
    End Sub

    ''' <summary>
    ''' Actualiza el valor de la tasa por mil
    ''' </summary>
    Private Sub RefreshXMilValue()
        If IdEntityBankAccount IsNot Nothing AndAlso IdEntityBankAccount > 0 AndAlso TaxByMil = True Then
            If EntityBankAccount IsNot Nothing AndAlso EntityBankAccount.Id > 0 Then
                Select Case VoucherClass
                    Case eVoucherClass.Payment
                        If VoucherTransactionDetailDatasource IsNot Nothing Then
                            Dim diference = VoucherTransactionDetailDatasource.Where(Function(o) o.Nature = 1).Sum(Function(x) x.Value) - VoucherTransactionDetailDatasource.Where(Function(o) o.Nature = 2).Sum(Function(x) x.Value)
                            TaxByMilValue = TreasuryStaticServices.CalculateRateByMilValue(EntityBankAccount.Rate, diference).Item1
                            Value = TreasuryStaticServices.CalculateRateByMilValue(EntityBankAccount.Rate, diference).Item2
                        End If
                    Case eVoucherClass.Transfer, eVoucherClass.Refund
                        If EntityBankAccountDatasourceGrid IsNot Nothing Then
                            Dim diference = EntityBankAccountDatasourceGrid.Where(Function(o) o.Nature = 1).Sum(Function(x) x.Value) - EntityBankAccountDatasourceGrid.Where(Function(o) o.Nature = 2).Sum(Function(x) x.Value)
                            TaxByMilValue = TreasuryStaticServices.CalculateRateByMilValue(EntityBankAccount.Rate, diference).Item1
                            Value = TreasuryStaticServices.CalculateRateByMilValue(EntityBankAccount.Rate, diference).Item2
                        End If
                End Select
            End If
        Else
            Select Case VoucherClass
                Case eVoucherClass.Payment
                    If VoucherTransactionDetailDatasource IsNot Nothing Then
                        Value = VoucherTransactionDetailDatasource.Where(Function(o) o.Nature = 1).Sum(Function(x) x.Value) - VoucherTransactionDetailDatasource.Where(Function(o) o.Nature = 2).Sum(Function(x) x.Value)
                    End If
                Case eVoucherClass.Transfer, eVoucherClass.Refund
                    If EntityBankAccountDatasourceGrid IsNot Nothing Then
                        Value = EntityBankAccountDatasourceGrid.Where(Function(o) o.Nature = 1).Sum(Function(x) x.Value) - EntityBankAccountDatasourceGrid.Where(Function(o) o.Nature = 2).Sum(Function(x) x.Value)
                    End If
            End Select
        End If
    End Sub

    ''' <summary>
    ''' Elimino un cheque bloqueado y lo envio a cheques pendientes
    ''' </summary>
    Private Sub DeleteCheckBlock(Optional ByVal isPending As Boolean = True)
        'If _voucherTransaction IsNot Nothing AndAlso _voucherTransaction.Id = 0 Then
        Dim setting As SettingsTreasury = Nothing
        Using ModelSetting As New MSettingsTreasury(Me.Tag)
            Dim resultSetting = ModelSetting.GetSettingsTreasuryByIdUnitOperativeSimple(Me._idOperativeUnit)
            If resultSetting.StateResult AndAlso resultSetting.ObjectEmbbeded IsNot Nothing AndAlso resultSetting.ObjectEmbbeded.Id > 0 Then
                setting = resultSetting.ObjectEmbbeded
                If setting.CheckBookControl Then
                    If IdCheckBook IsNot Nothing AndAlso CheckNumber IsNot Nothing AndAlso IdCheckBook <> 0 AndAlso CheckNumber <> 0 Then
                        If isPending Then
                            Using ModelOutstandingChecks As New MOutstandingChecks(Me.Tag)
                                Dim outstandingChecks As New OutstandingChecks()
                                With outstandingChecks
                                    .IdCheckBook = IdCheckBook
                                    .CheckNumber = CheckNumber
                                End With
                                Dim resultOutstandingChecks = ModelOutstandingChecks.SaveOutstandingChecksSimple(outstandingChecks)
                                IdCheckBook = outstandingChecks.IdCheckBook
                                CheckNumber = outstandingChecks.CheckNumber
                                If resultOutstandingChecks.StateResult = False AndAlso (_voucherTransaction.Status = 1 OrElse _voucherTransaction.Status = 0) Then
                                    Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("OutstandingChecksPutError", NAME_MODULE)
                                End If
                            End Using
                        End If
                        Using Model As New MCheck(Me.Tag)
                            Dim resultOp = Model.GetCheckBlockByIdCheckBookNumberSimple(IdCheckBook, CheckNumber)
                            Dim checkBlock As CheckBlock = resultOp.ObjectEmbbeded
                            If checkBlock IsNot Nothing AndAlso checkBlock.Id > 0 Then
                                checkBlock.MarkAsDeleted()
                                Dim regBlock = Model.DeleteCheckBlockSimple(checkBlock)
                                If regBlock.StateResult = False AndAlso (_voucherTransaction.Status = 1 OrElse _voucherTransaction.Status = 0) Then
                                    Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("DeleteErrorCheckBlock", NAME_MODULE)
                                End If
                            End If
                        End Using
                        CheckNumber = Nothing
                        IdCheckBook = Nothing
                    End If
                End If
            End If
        End Using
        'End If
    End Sub

    ''' <summary>
    ''' Adds the expense concept.
    ''' </summary>
    Private Sub AddVoucherTransactionDetail(ByVal isEdit As Boolean)
        Me.Cursor = ChangeCursorIndigo()
        Using Formulario As New FrmPopUpDisbursementVoucher
            Formulario.MinimizeBox = False
            Formulario.MaximizeBox = False
            Formulario.IniciarCombos()
            Formulario.VoucherClass = VoucherClass
            AddHandler Formulario.AddVoucherDetail, AddressOf LoadExpenseConcept
            Select Case ExpenseType
                Case eExpenseType.BankAccount
                    Formulario.IdEntityBankAccount = INDsleEntityAccount.EditValue
                    Formulario.InitializeExpenseConceptNotCash()
                Case eExpenseType.MinorCash
                    Formulario.IdCash = INDsleCash.EditValue
                    Formulario.InitializeExpenseConceptByCash()
                Case eExpenseType.MajorCash
                    Formulario.IdCash = INDsleCash.EditValue
                    'Formulario.InitializeExpenseConceptByMajorCash()
                    Formulario.InitializeExpenseConceptNotCash()
            End Select
            Select Case VoucherClass
                Case eVoucherClass.Payment
                    Formulario.PaymentsSettingPaymentsXpo = Me.PaymentsSettingPaymentsXpo
                    Formulario.MainThird = IdThirdParty
                    Dim _voucherTDetail As VoucherTransactionDetails = Nothing
                    If isEdit Then
                        _voucherTDetail = CType(INDGvVoucherTransactionDetail.GetRow(INDGvVoucherTransactionDetail.FocusedRowHandle), VoucherTransactionDetails)
                        If _voucherTDetail.ExpenseConceptBehavior = eBehavior.PettyCash OrElse _voucherTDetail.ExpenseConceptBehavior = eBehavior.PaymentAdvancePaymentInvoices Then
                            Formulario.DictionaryAgesPayments = _dictionaryAgesPayments
                            If DatasourceDischargeBillPopUp IsNot Nothing Then
                                Formulario.LoadListDischargeBill(DatasourceDischargeBillPopUp.Where(Function(x) x.ExpenseConceptId = _voucherTDetail.IdExpenseConcept).ToList())
                            Else
                                Formulario.LoadListDischargeBill(Nothing)
                            End If
                        ElseIf _voucherTDetail.ExpenseConceptBehavior = eBehavior.ReturningImprestRC Then 'Devolutivo de anticipos R/C
                            Formulario.VoucherTransactionAdvance = ListVoucherTransactionAdvance
                        End If
                        Formulario.LoadDataVoucherTransactionDetail(_voucherTDetail)
                    End If
                    If VoucherTransactionDetailDatasource IsNot Nothing Then
                        If isEdit Then
                            Formulario.ListVoucherDetails = VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6 AndAlso x.IdExpenseConcept <> _voucherTDetail.IdExpenseConcept) _
                                                                .Cast(Of VoucherTransactionDetails).ToList()
                        Else
                            Formulario.ListVoucherDetails = VoucherTransactionDetailDatasource.Where(Function(x) x.ExpenseConceptBehavior <> 6).Cast(Of VoucherTransactionDetails).ToList()
                        End If
                    End If
                    'Parámetros
                    'Formulario.ThirdParthy = INDsleThirdParty.EditValue
                Case eVoucherClass.Refund
                    If ExpenseType = 3 Then
                        Formulario.IdCashRegisterValidate = IdCashRegister
                    End If
                    Dim _voucherTDetail As VoucherTransactionDetails = CType(ViewTransfer.GetFocusedRow(), VoucherTransactionDetails)
                    If EntityBankAccountDatasourceGrid IsNot Nothing Then
                        If isEdit Then
                            Formulario.ListVoucherDetails = EntityBankAccountDatasourceGrid.Where(Function(x) x.CashRegisterId <> _voucherTDetail.CashRegisterId).Cast(Of VoucherTransactionDetails).ToList()
                        Else
                            Formulario.ListVoucherDetails = EntityBankAccountDatasourceGrid
                        End If
                    End If
                    If isEdit Then
                        Formulario.LoadDataVoucherTransactionDetail(_voucherTDetail)
                    End If
                Case eVoucherClass.Transfer
                    If ExpenseType = 3 Then
                        Formulario.IdCashRegisterValidate = IdCashRegister
                    End If
                    Dim _voucherTDetail As VoucherTransactionDetails = CType(ViewTransfer.GetFocusedRow(), VoucherTransactionDetails)
                    If EntityBankAccountDatasourceGrid IsNot Nothing Then
                        If isEdit Then
                            If ExpenseType = 1 Then
                                Formulario.ListVoucherDetails = EntityBankAccountDatasourceGrid.Where(Function(x) x.IdEntityBankAccount <> _voucherTDetail.IdEntityBankAccount).Cast(Of VoucherTransactionDetails).ToList()
                            ElseIf ExpenseType = 3 Then
                                Formulario.ListVoucherDetails = EntityBankAccountDatasourceGrid.Where(Function(x) x.CashRegisterId <> _voucherTDetail.CashRegisterId).Cast(Of VoucherTransactionDetails).ToList()
                            End If
                        Else
                            Formulario.ListVoucherDetails = EntityBankAccountDatasourceGrid
                        End If
                    End If
                    If isEdit Then
                        Formulario.LoadDataVoucherTransactionDetail(_voucherTDetail)
                    End If
            End Select
            Formulario.ExpenseType = ExpenseType
            Formulario.StartPosition = System.Windows.Forms.FormStartPosition.CenterParent
            If _voucherTransaction IsNot Nothing Then
                Formulario.StatusVoucher = _voucherTransaction.Status
            End If
            Dim transparent As New FrmTransparent(Formulario, False)
            Me.Cursor = System.Windows.Forms.Cursors.Default
            transparent.ShowDialog(Me)
        End Using
    End Sub

    ''' <summary>
    ''' Deletes the expense concept.
    ''' </summary>
    Private Sub DeleteVoucherTransactionDetail()
        If MessageIndigo.Show(ResourceManager.GetString("DeleteRecord"), MessageType.Question, Me.Text, Botones.SiNo) = System.Windows.Forms.DialogResult.Yes Then
            Dim voucherDetail As VoucherTransactionDetails = CType(INDGvVoucherTransactionDetail.GetFocusedRow(), VoucherTransactionDetails)
            If voucherDetail.Id > 0 Then
                If DatasourceDischargeBillPopUp IsNot Nothing AndAlso DatasourceDischargeBillPopUp.Any(Function(x) x.ExpenseConceptId = voucherDetail.IdExpenseConcept) Then
                    DatasourceDischargeBillPopUp.Where(Function(o) o.ExpenseConceptId = voucherDetail.IdExpenseConcept).ToList().ForEach(Sub(i)
                                                                                                                                             'i.MarkAsDeleted()
                                                                                                                                             voucherDetail.DischargeBill.Add(i)
                                                                                                                                         End Sub)
                    voucherDetail.IsDelete = True
                Else
                    voucherDetail.MarkAsDeleted()
                End If
                VoucherTransactionDetailDatasource = _voucherTransaction.VoucherTransactionDetails.Where(Function(x) x.IsDelete = False).ToList()
            Else
                VoucherTransactionDetailDatasource.Remove(voucherDetail)
            End If
            If _voucherTransaction.ChangeTracker.State <> ObjectState.Added Then
                _voucherTransaction.MarkAsModified()
            End If
            INDGcVoucherTransactionDetail.DataSource = VoucherTransactionDetailDatasource
            INDGcVoucherTransactionDetail.RefreshDataSource()
            Me.RefreshXMilValue()
            ctrTmp.PrintValueVoucher()
            INDgleVoucherClass.Properties.ReadOnly = INDGcVoucherTransactionDetail.DataSource IsNot Nothing AndAlso CType(INDGcVoucherTransactionDetail.DataSource, List(Of VoucherTransactionDetails)).Count > 0
            INDsleThirdParty.Properties.ReadOnly = INDGcVoucherTransactionDetail.DataSource IsNot Nothing AndAlso CType(INDGcVoucherTransactionDetail.DataSource, List(Of VoucherTransactionDetails)).Count > 0
            INDgleExpenseType.Properties.ReadOnly = INDGcVoucherTransactionDetail.DataSource IsNot Nothing AndAlso CType(INDGcVoucherTransactionDetail.DataSource, List(Of VoucherTransactionDetails)).Count > 0
        End If
    End Sub

    ''' <summary>
    ''' Activa o Inactiva el control que agrega conceptos de egreso
    ''' </summary>
    Private Sub ActiveInactivePopUpExpenseConcept()
        INDsbAddExpenseConcept.Enabled = False
        If VoucherClass = eVoucherClass.Payment Then
            If INDsleThirdParty.EditValue Is Nothing OrElse INDgleExpenseType.EditValue Is Nothing Then
                INDsbAddExpenseConcept.Enabled = False
            Else
                If INDsleCash.EditValue Is Nothing And INDsleEntityAccount.EditValue Is Nothing Then
                    INDsbAddExpenseConcept.Enabled = False
                Else
                    INDsbAddExpenseConcept.Enabled = True
                End If
            End If
        ElseIf VoucherClass = eVoucherClass.Refund OrElse VoucherClass = eVoucherClass.Transfer Then
            If INDsleCash.EditValue Is Nothing And INDsleEntityAccount.EditValue Is Nothing Then
                INDsbAddExpenseConcept.Enabled = False
            Else
                INDsbAddExpenseConcept.Enabled = True
            End If
        End If
    End Sub

    ''' <summary>
    ''' Loads the null text.
    ''' </summary>
    Private Sub LoadNullText()
        With _voucherTransaction
            INDsleThirdParty.Properties.NullText = _voucherTransaction.FullNameThird
            If Not String.IsNullOrEmpty(_voucherTransaction.FullNameEntityBankAccount) Then
                INDsleEntityAccount.Properties.NullText = _voucherTransaction.FullNameEntityBankAccount
            End If
            If Not String.IsNullOrEmpty(_voucherTransaction.FullNameCashRegister) Then
                INDsleCash.Properties.NullText = _voucherTransaction.FullNameCashRegister
            End If
            If Not String.IsNullOrEmpty(_voucherTransaction.FullNameCostCenter) Then
                INDsleCostCenter.Properties.NullText = _voucherTransaction.FullNameCostCenter
            End If
        End With
    End Sub

    ''' <summary>
    ''' Loads the concept complex. el parameetro load es para saber si se esta leyendo de la base de datos y no se esta guardando por primera vez
    ''' </summary>
    Public Sub LoadVoucherTransactionDetail(tempVoucherDetailPopUp As VoucherTransactionDetails, Optional Load As Boolean = False)
        INDlycRoot.BeginUpdate()
        Dim voucherTransactionDetail As VoucherTransactionDetails = tempVoucherDetailPopUp
        Select Case VoucherClass
            Case eVoucherClass.Payment
                If VoucherTransactionDetailDatasource Is Nothing Then
                    VoucherTransactionDetailDatasource = New List(Of VoucherTransactionDetails)()
                End If
                If _modeEditPopUpExpenseConcept Then
                    voucherTransactionDetail = CType(INDGvVoucherTransactionDetail.GetFocusedRow(), VoucherTransactionDetails)
                    'For Each prop As System.Reflection.PropertyInfo In voucherTransactionDetail.GetType().GetProperties()
                    '    prop.SetValue(voucherTransactionDetail, tempVoucherDetailPopUp.GetType().GetProperty(prop.Name).GetValue(prop))
                    'Next
                    With voucherTransactionDetail
                        .Id = tempVoucherDetailPopUp.Id
                        .IdThirdParty = tempVoucherDetailPopUp.IdThirdParty
                        .IdExpenseConcept = tempVoucherDetailPopUp.IdExpenseConcept
                        .IdEntityBankAccount = tempVoucherDetailPopUp.IdEntityBankAccount
                        .IdMainAccount = tempVoucherDetailPopUp.IdMainAccount
                        .Nature = tempVoucherDetailPopUp.Nature
                        .IdCostCenter = tempVoucherDetailPopUp.IdCostCenter
                        .Value = tempVoucherDetailPopUp.Value
                        .PercentRetention = tempVoucherDetailPopUp.PercentRetention
                        .IdRetentionConcept = tempVoucherDetailPopUp.IdRetentionConcept
                        .Detail = tempVoucherDetailPopUp.Detail
                        .FullNameMainAccount = tempVoucherDetailPopUp.FullNameMainAccount
                        .FullNameCostCenter = tempVoucherDetailPopUp.FullNameCostCenter
                        .FullNameThirdParty = tempVoucherDetailPopUp.FullNameThirdParty
                        .ExpenseConceptCode = tempVoucherDetailPopUp.ExpenseConceptCode
                        .ExpenseConceptName = tempVoucherDetailPopUp.ExpenseConceptName
                        .ExpenseConceptBehavior = tempVoucherDetailPopUp.ExpenseConceptBehavior
                        .IdCashFlowConcept = tempVoucherDetailPopUp.IdCashFlowConcept
                        .CodeNameCashFlowConcept = tempVoucherDetailPopUp.CodeNameCashFlowConcept

                        .AdvanceValue = tempVoucherDetailPopUp.AdvanceValue
                        .AdvanceDetail = tempVoucherDetailPopUp.AdvanceDetail
                        If .Nature = 1 Then
                            .NatureName = ResourceManager.GetString("AccountNatureDebit")
                        Else
                            .NatureName = ResourceManager.GetString("AccountNatureCredit")
                        End If
                        .DischargeBillDelete = tempVoucherDetailPopUp.DischargeBillDelete
                    End With
                Else
                    voucherTransactionDetail = tempVoucherDetailPopUp
                    VoucherTransactionDetailDatasource.Add(tempVoucherDetailPopUp)
                End If
                INDGcVoucherTransactionDetail.RefreshDataSource()
                Select Case tempVoucherDetailPopUp.ExpenseConceptBehavior
                    Case 2, 3
                        INDGcDischargeBill.RefreshDataSource()
                    Case 4
                    Case 5
                        LoadRefundByCashRegisterId(tempVoucherDetailPopUp.IdMainAccount)
                End Select
                _modeEditPopUpExpenseConcept = False
                Me.RefreshXMilValue()
                ctrTmp.PrintValueVoucher()

            Case eVoucherClass.Refund

                If EntityBankAccountDatasourceGrid Is Nothing Then
                    EntityBankAccountDatasourceGrid = New List(Of VoucherTransactionDetails)()
                End If
                If _modeEditPopUpExpenseConcept Then
                    voucherTransactionDetail = CType(ViewTransfer.GetFocusedRow(), VoucherTransactionDetails)

                    With voucherTransactionDetail
                        .Id = tempVoucherDetailPopUp.Id
                        .CashRegisterId = tempVoucherDetailPopUp.CashRegisterId
                        .IdMainAccount = tempVoucherDetailPopUp.IdMainAccount
                        .Nature = tempVoucherDetailPopUp.Nature
                        .IdCostCenter = tempVoucherDetailPopUp.IdCostCenter
                        .Value = tempVoucherDetailPopUp.Value
                        .Detail = tempVoucherDetailPopUp.Detail
                        .FullNameMainAccount = tempVoucherDetailPopUp.FullNameMainAccount
                        .FullNameCostCenter = tempVoucherDetailPopUp.FullNameCostCenter
                        .EntityCode = tempVoucherDetailPopUp.EntityCode
                        .EntityName = tempVoucherDetailPopUp.EntityName
                    End With

                Else
                    Dim _listTempVoucherDetail As List(Of VoucherTransactionDetails) = EntityBankAccountDatasourceGrid
                    _listTempVoucherDetail.Add(tempVoucherDetailPopUp)
                    EntityBankAccountDatasourceGrid = Nothing
                    EntityBankAccountDatasourceGrid = _listTempVoucherDetail
                End If
                INDGcVoucherTransactionDetail.RefreshDataSource()
                'LoadRefundByCashRegisterId(tempVoucherDetailPopUp.CashRegisterId)
                _modeEditPopUpExpenseConcept = False
                Me.RefreshXMilValue()
                ctrTmp.PrintValueVoucher()


            Case eVoucherClass.Transfer
                If EntityBankAccountDatasourceGrid Is Nothing Then
                    EntityBankAccountDatasourceGrid = New List(Of VoucherTransactionDetails)()
                End If
                If _modeEditPopUpExpenseConcept Then
                    voucherTransactionDetail = CType(ViewTransfer.GetFocusedRow(), VoucherTransactionDetails)
                    'For Each prop As System.Reflection.PropertyInfo In voucherTransactionDetail.GetType().GetProperties()
                    '    prop.SetValue(voucherTransactionDetail, tempVoucherDetailPopUp.GetType().GetProperty(prop.Name).GetValue(tempVoucherDetailPopUp))
                    'Next
                    With voucherTransactionDetail
                        .Id = tempVoucherDetailPopUp.Id
                        .CashRegisterId = tempVoucherDetailPopUp.CashRegisterId
                        .IdEntityBankAccount = tempVoucherDetailPopUp.IdEntityBankAccount
                        .IdMainAccount = tempVoucherDetailPopUp.IdMainAccount
                        .Nature = tempVoucherDetailPopUp.Nature
                        .IdCostCenter = tempVoucherDetailPopUp.IdCostCenter
                        .Value = tempVoucherDetailPopUp.Value
                        .Detail = tempVoucherDetailPopUp.Detail
                        .FullNameMainAccount = tempVoucherDetailPopUp.FullNameMainAccount
                        .FullNameCostCenter = tempVoucherDetailPopUp.FullNameCostCenter
                        .EntityCode = tempVoucherDetailPopUp.EntityCode
                        .EntityName = tempVoucherDetailPopUp.EntityName
                    End With
                Else
                    'voucherTransactionDetail = tempVoucherDetailPopUp
                    Dim _listTempVoucherDetail As List(Of VoucherTransactionDetails) = EntityBankAccountDatasourceGrid
                    _listTempVoucherDetail.Add(tempVoucherDetailPopUp)
                    'EntityBankAccountDatasourceGrid.Add(tempVoucherDetailPopUp)
                    EntityBankAccountDatasourceGrid = Nothing
                    EntityBankAccountDatasourceGrid = _listTempVoucherDetail
                End If
                INDGcVoucherTransactionDetail.RefreshDataSource()
                _modeEditPopUpExpenseConcept = False
                Me.RefreshXMilValue()
                ctrTmp.PrintValueVoucher()
        End Select

        INDgleVoucherClass.Properties.ReadOnly = True
        INDsleThirdParty.Properties.ReadOnly = True
        INDgleExpenseType.Properties.ReadOnly = True
        INDlycRoot.EndUpdate()
    End Sub

    ''' <summary>
    ''' Loads the refund by account accounting.
    ''' </summary>
    Private Async Sub LoadRefundByCashRegisterId(ByVal CashRegisterId As Integer)
        Using Model As New MRefund(Me.Tag)
            _listRefund = (Await Model.ListRefundByCashRegisterIdAsync(CashRegisterId)).ObjectEmbbeded
        End Using
    End Sub

    ''' <summary>
    ''' Obtiene el objeto que se agrego el el concepto de egreso
    ''' </summary>
    Public Async Sub LoadExpenseConcept(sender As Object, e As AddExpenseConceptEventArgs)
        If _voucherTransaction.Id <> 0 Then
            _voucherTransaction.MarkAsModified()
        End If
        Select Case VoucherClass
            Case eVoucherClass.Payment
                If e.ListDischargeBill IsNot Nothing AndAlso e.ListDischargeBill.Count > 0 Then
                    Dim validationResult As New StringBuilder()
                    For Each item In e.ListDischargeBill
                        Using model As New MSchedulePayment(Me.Tag)
                            Dim result As ActionResult = Await model.IsAccountPayableShareInSchedulePaymentDetailActive(item.IdAccountPayableShare)
                            If result.StateResult Then
                                validationResult.AppendLine(String.Format("La factura {0} con cuota {1} se encuentra agregada en las siguientes programaciones de pago activas : {2}", item.AccountPayableBillNumber, item.AccountPayableShareShare, result.Message))
                            End If
                        End Using
                    Next
                    If validationResult.Length > 0 Then
                        Mensaje(EeventViewerImages.Informacion) = validationResult.ToString()
                    End If
                    If e.ListDischargeBill IsNot Nothing AndAlso e.ListDischargeBill.Count > 0 Then
                        If DatasourceDischargeBillPopUp IsNot Nothing Then
                            DatasourceDischargeBillPopUp.RemoveAll(Function(x) x.ExpenseConceptId = e.ListDischargeBill(0).ExpenseConceptId)
                        Else
                            DatasourceDischargeBillPopUp = New List(Of DischargeBill)()
                        End If
                        DatasourceDischargeBillPopUp.AddRange(e.ListDischargeBill)
                    End If
                    'DischargeBillDatasource = e.ListDischargeBill
                End If

                If e.VoucherTransactionD.ExpenseConceptBehavior = 4 Then
                    ListVoucherTransactionAdvance = e.ListVoucherTransactionAdvance
                End If
            Case eVoucherClass.Refund
                _listRefund = e.ListRefund
            Case eVoucherClass.Transfer

        End Select
        _modeEditPopUpExpenseConcept = e.IsEditMode
        LoadVoucherTransactionDetail(e.VoucherTransactionD)
    End Sub

    ''' <summary>
    ''' Función que contiene la logica necesaria para manejar los cheques
    ''' </summary>
    ''' <returns></returns>
    Private Async Function LoadCheck() As Task
        If Me._idOperativeUnit = 0 Then
            Mensaje(EeventViewerImages.Advertencia) = "Debe seleccionar una unidad Operativa"
            Exit Function
        End If

        If IsLoading Then
            Using modelSettins As New MSettingsTreasury(Me.Tag)
                Dim res As ActionResult(Of SettingsTreasury) = Await modelSettins.GetSettingsTreasuryByIdUnitOperative(Me._idOperativeUnit)
                If res.StateResult AndAlso res.ObjectEmbbeded IsNot Nothing AndAlso res.ObjectEmbbeded.Id > 0 Then

                    NoteNumber = Nothing
                    INDliCheck.HideControl(False)
                    INDliDebitNote.HideControl(True)
                    INDliTransactionDate.HideControl(False)
                    TransactionDate = DocumentDate
                    INDtxtCheck.Enabled = Not res.ObjectEmbbeded.CheckBookControl

                    IdCheckBook = _voucherTransaction.IdChecks
                    CheckNumber = _voucherTransaction.CheckNumber

                End If
            End Using
        Else
            Using model As New MVoucherTransaction(Me.Tag)
                Dim res As SP_GetCheckNumber_Result = Await model.GetCheckNumberAsync(IdEntityBankAccount, Me._idOperativeUnit)
                If res IsNot Nothing Then
                    If res.StatusResult = "999" Then
                        'ACCIONES DE LIMPIAR CUANDO OCURREN ERRORES
                        INDglePaymentMethod.EditValue = Nothing
                        Mensaje(EeventViewerImages.Advertencia) = res.MessageResult
                        Exit Function
                    End If

                    NoteNumber = Nothing
                    INDliCheck.HideControl(False)
                    INDliDebitNote.HideControl(True)
                    INDliTransactionDate.HideControl(False)
                    TransactionDate = DocumentDate
                    INDtxtCheck.Enabled = Not res.CheckbookControl
                    IdCheckBook = res.CheckbookId
                    If res.CheckbookControl Then
                        CheckNumber = res.CheckNumberToAssign
                    Else
                        INDtxtCheck.Properties.MinValue = res.CheckNumberToAssign
                        INDtxtCheck.Properties.MaxValue = res.CheckNumberEnd
                    End If

                Else
                    Mensaje(EeventViewerImages.Advertencia) = "Ocurrieron errores. Contacte con el Administrador"
                End If
            End Using
        End If

        'Exit Function

        'Dim setting As SettingsTreasury = Nothing
