    ''' <summary>
    ''' Handles the EditValueChanged event of the INDsleThirdParty control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub INDsleThirdParty_EditValueChanged(sender As Object, e As EventArgs) Handles INDsleThirdParty.EditValueChanged
        ActiveInactivePopUpExpenseConcept()
    End Sub

    ''' <summary>
    ''' Handles the EditValueChanged event of the INDsleCash control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Async Sub INDsleCash_EditValueChanged(sender As Object, e As EventArgs) Handles INDsleCash.EditValueChanged
        If INDsleCash.EditValue IsNot Nothing AndAlso INDsleCash.EditValue > 0 AndAlso (_voucherTransaction.Status = 1 OrElse _voucherTransaction.Status = 0) Then
            Dim band As Boolean = False
            Using Model As New MCashRegisterUser(Me.Tag)
                Dim ListUser As List(Of CashRegisterUser) = Await Model.ListCashRegisterUserByIdCashRegister(CStr(INDsleCash.EditValue))
                For Each c As CashRegisterUser In ListUser
                    If c.IdUser.Equals(Me.indigo.UserIndigoId) Then
                        band = True
                        Exit For
                    End If
                Next
                If Not band Then
                    Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("CashPermission", NAME_MODULE)
                    INDsleCash.EditValue = Nothing
                End If
            End Using
            Using Model As New MCashRegister(Me.Tag)
                Dim cash As CashRegisters = Await Model.GetcashRegisterById(INDsleCash.EditValue)
                If cash IsNot Nothing Then
                    IdMainAccount = cash.IdMainAccount
                    IdCostCenter = cash.IdCostCenter
                    If Me._sequence.Scope.Equals("O") Then
                        Me._idCurrentSequence = Me.GetIdSequenceByPrefix(cash.Prefix)
                        Me._prefixSelected = cash.Prefix
                    End If

                    If cash.IdCostCenter > 0 Then
                        INDliCostCenter.HideControl(False)
                        INDsleCostCenter.EditValue = cash.IdCostCenter
                    Else
                        INDliCostCenter.HideControl(True)
                        INDsleCostCenter.EditValue = Nothing
                    End If
                End If
            End Using
        End If
        ActiveInactivePopUpExpenseConcept()
    End Sub
#End Region

