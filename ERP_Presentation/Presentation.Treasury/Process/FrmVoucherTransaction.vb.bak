    Private Sub BarraBotones_QueryLoadReportsAndDefinitions(sender As Object, e As LoadReportsAndDefinitionsEventArgs) Handles BarraBotones.QueryLoadReportsAndDefinitions
        Dim bankCode As String
        If EntityBankAccount IsNot Nothing Then
            If TypeOf EntityBankAccount Is EntityBankAccountXpo Then 'If bankAccount.GetType().Name.Equals(GetType(EntityBankAccountXpo).Name) Then
                bankCode = EntityBankAccount.IdBank.Code
            Else
                bankCode = EntityBankAccount.Bank.Code
            End If
            If Me.INDliPaymentMethod.Visibility = DevExpress.XtraLayout.Utils.LayoutVisibility.Always AndAlso Me.INDglePaymentMethod.EditValue IsNot Nothing AndAlso Me.INDglePaymentMethod.EditValue = CInt(ePaymentType.Check) AndAlso Me.EntityBankAccount IsNot Nothing AndAlso Me.EntityBankAccount.IdBank IsNot Nothing Then
                e.ListReportsAndDefinitions = e.ListReportsAndDefinitions.Where(Function(r) r.CodeEntity = If(TypeOf EntityBankAccount Is EntityBankAccountXpo, Me.EntityBankAccount.IdBank.BankFileCode, Me.EntityBankAccount.Bank.BankFileCode)).ToList()
            Else
                e.ListReportsAndDefinitions = e.ListReportsAndDefinitions.Where(Function(r) r.CodeEntity Is Nothing OrElse r.CodeEntity.Trim().Equals(String.Empty)).ToList()
            End If
        End If
    End Sub

#End Region

#Region "Async"
    ''' <summary>
    ''' Evento asincrono que carga el concepto de egreso con las cuotas de las facturas
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="DoWorkEventArgs"/> instance containing the event data.</param>
    Private Sub asyncExpense_DoWork(sender As Object, e As DoWorkEventArgs)
        If VoucherClass = eVoucherClass.Payment Then
            For Each voucherDetail As VoucherTransactionDetails In VoucherTransactionDetailDatasource
                Select Case voucherDetail.ExpenseConceptBehavior
                    Case 2, 3
                        LoadDischargeBillByVoucherTransactionId(voucherDetail.Id, voucherDetail.IdExpenseConcept)
                    Case 4
                        'Using Model As New MBusqueda
                        '    Dim _listVoucherTransactionAdvance = Model.ConsultarEntidades(eDataSource.ListVoucherTransactionAdvance)
                        '    ListVoucherTransactionAdvance = New List(Of VoucherTransactionAdvance)()
                        '    For Each item As Infrastructure.Data.Xpo.TreasuryRepository.VoucherTransactionAdvanceXpo In _listVoucherTransactionAdvance
                        '        Dim voucherTransactionAdvance = New VoucherTransactionAdvance()
                        '        With voucherTransactionAdvance
                        '            .Id = item.Id
                        '            .IdVoucherTransactionD = item.IdVoucherTransactionD
                        '            .PortfolioAdvanceId = item.PortfolioAdvanceId.Id
                        '            .Value = item.Value
                        '            .Percentage = item.Percentage
                        '            .PortfolioAdvanceCode = item.PortfolioAdvanceId.Code
                        '            .PortfolioAdvanceDocumentDate = item.PortfolioAdvanceId.DocumentDate
                        '            .PortfolioAdvanceBalance = item.PortfolioAdvanceId.Balance
                        '        End With
                        '        ListVoucherTransactionAdvance.Add(voucherTransactionAdvance)
                        '    Next
                        'End Using
                    Case 5
                        Using ModelRefund As New MRefund(Me.Tag)
                            _listRefund = (ModelRefund.ListRefundByAccountSimple(voucherDetail.IdMainAccount)).ObjectEmbbeded
                        End Using
                End Select
            Next
        End If
    End Sub

    ''' <summary>
    ''' Método que se ejecuta al terminar la tarea asincrona de cargar el concepto de egreso con las facturas
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="RunWorkerCompletedEventArgs"/> instance containing the event data.</param>
    Private Sub asyncExpense_Complete(sender As Object, e As RunWorkerCompletedEventArgs)
        If VoucherClass = eVoucherClass.Payment Then
            Me.RefreshXMilValue()
            ctrTmp.PrintValueVoucher()
        End If
        INDGvVoucherTransactionDetail.HideLoadingPanel()
        Me.BarraBotones.Enabled = True
    End Sub
#End Region

#Region "Enum"

    ''' <summary>
    ''' Enumeración que contiene el tipo de comprobante
    ''' </summary>
    Public Enum eExpenseType
        BankAccount = 1
        MinorCash = 2
        MajorCash = 3
        BankingProduct = 4
    End Enum

    Public Enum ePaymentType
        Check = 1
        ''' <summary>
        ''' The debit note
        ''' </summary>
        DebitNote = 2
    End Enum

    Public Enum eEntityBankAccountType
        Saving = 1
        Current = 2
    End Enum

    ''' <summary>
    ''' Enumeración de los estados de la chequera
    ''' </summary>
    Public Enum eStatusCheck
        Active = 1
        Blocked = 2
        Finished = 3
    End Enum

    Public Enum eStatusAccountPayable
        Registrado = 1
        Confirmado = 2
        Anulado = 3
    End Enum

    ''' <summary>
    ''' Enumeracion que contiene el tracker
    ''' </summary>
    Public Enum eTracker
        Unchanged = 1
        Added = 2
        Modified = 3
        Deleted = 4
    End Enum

    ''' <summary>
    ''' Enumeracion del comportamiento de los conceptos de caja menor
    ''' </summary>
    Public Enum eBehavior
        ''' <summary>
        ''' Traslado entre bancos
        ''' </summary>
        TransferBetweenBanks = 1
        ''' <summary>
        ''' Caja Menor
        ''' </summary>
        PettyCash = 2
        ''' <summary>
        ''' Pago/Anticipo de Facturas CxP
        ''' </summary>
        PaymentAdvancePaymentInvoices = 3
        ''' <summary>
        ''' Devolutivos de Anticipos RC
        ''' </summary>
        ReturningImprestRC = 4
        ''' <summary>
        '''  Reembolso de Caja Menor
        ''' </summary>
        PettyCashReimbursement = 5
        ''' <summary>
        ''' Comportamiento ninguno
        ''' </summary>
        Ninguno = 6
    End Enum

    Public Enum eVoucherClass
        Payment = 1
        Refund = 2
        Transfer = 3
    End Enum

#End Region

End Class