    ''' <summary>
    ''' Handles the LostFocus event of the INDdeDate control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Async Sub INDdeDate_LostFocus(sender As Object, e As EventArgs) Handles INDdeDate.LostFocus
        If DateServer IsNot Nothing Then
            Using Model As New MDocumentAccount(Me.Tag)
                If Not Await Model.ValidatePeriod(DateServer.Value.Month, DateServer.Value.Year) Then
                    Dim periods As List(Of ClosedMonth) = Model.GetOpenPeriod()
                    If periods IsNot Nothing AndAlso periods.Count > 0 Then
                        Dim perOpen As String = AccountingServices.GetListOpenPeriods(periods)
                        INDdeDate.EditValue = Nothing
                        Mensaje(EeventViewerImages.Advertencia) = perOpen
                        INDdeDate.Focus()
                    Else
                        Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("OpenPeriodNothing", NAME_MODULE_ACCOUNTING)
                        INDdeDate.EditValue = Nothing
                        INDdeDate.Focus()
                    End If
                End If
            End Using
        End If
    End Sub

    ''' <summary>
    ''' METODO: Item Guardar del control de usuarios.
    ''' </summary>
    Public Async Sub Guardar(ByVal withConfirm As Boolean)
        If ValidateFields() = False Then
            Exit Sub
        End If
        AsyncLoader(True)
        If withConfirm Then
            If Not Await ValidateItemsNoteAndAdvance() Then
                AsyncLoader(False)
                Exit Sub
            End If
        End If
        AssigningValues()
        Try
            Using Model As New MVoucherTransaction(Me.Tag.ToString())
                Dim Result = Await Model.SaveVoucherTransaction(Me._voucherTransaction, withConfirm, Me._idCurrentSequence, Me._sequence)
                '_presenter.GetSequence()
                AsyncLoader(False)
                If Result.StateResult = True Then
                    If withConfirm Then
                        Select Case Result.StatusCode
                            Case eStatusResult.SUCCESS
                                Mensaje(EeventViewerImages.Informacion) = Result.Message
                            Case eStatusResult.WARNING
                                Mensaje(EeventViewerImages.Advertencia) = Result.Message
                            Case eStatusResult.EXCEPTION
                                Mensaje(EeventViewerImages.Advertencia) = Result.Message
                        End Select
                        DeleteCheckBlock(False)
                    Else
                        If _voucherTransaction.ChangeTracker.State = Domain.Base.Entities.ObjectState.Added Then
                            If Not Me._sequence.IsManual AndAlso Not Me._sequence.Sequential Then
                                Me.DicSequense(Me._sequence.TreasurySequenceDetail(0).Id).RemoveAt(0)
                            End If
                            If Me._sequence.Sequential Then
                                Mensaje(EeventViewerImages.Informacion) = String.Format(ResourceManager.GetString("SavedWithCode"), Result.ObjectEmbbeded.Code)
                            Else
                                Mensaje(EeventViewerImages.Informacion) = ResourceManager.GetString("SaveMessage")
                            End If
                        ElseIf _voucherTransaction.ChangeTracker.State = Domain.Base.Entities.ObjectState.Modified Then
                            Mensaje(EeventViewerImages.Informacion) = ResourceManager.GetString("UpdateMessage")
                        End If
                    End If
                    Me._voucherTransaction = Result.ObjectEmbbeded
                    Me.UpdateIndexedDocument(Me.BarraBotones._listDocuments)
                    Select Case varImp
                        Case 1
                            Me.BarraBotones.PrintReport(PrintReportAction.Create, _voucherTransaction.Id, 0, _voucherTransaction.Id)
                        Case 2
                            Me.BarraBotones.PrintReport(PrintReportAction.Update, _voucherTransaction.Id, 0, _voucherTransaction.Id)
                        Case 3
                            Me.BarraBotones.PrintReport(PrintReportAction.Confirm, _voucherTransaction.Id, 0, _voucherTransaction.Id)
                    End Select
                    IdCheckBook = 0
                    CheckNumber = 0
                    Me.Deshacer()
                Else
                    If Result.Message IsNot Nothing Then
                        generateListError(Result.Message)
                    End If
                End If
            End Using
        Catch ex As Exception
            AsyncLoader(False)
            INDbteCode.Enabled = False
            Throw ex
        End Try
    End Sub

    ''' <summary>
    ''' METODO: Item Guardar del control de usuarios.
    ''' </summary>
    Public Sub Guardar() Implements IcrudBase.Guardar

    End Sub

    ''' <summary>
    ''' Genera el mensaje de error
    ''' </summary>
    ''' <param name="errors">The errors.</param>
    Private Sub generateListError(errors As String)
        Dim listError As New StringBuilder()
        listError.AppendLine(ResourceManager.GetString("ErrorListMessage"))
        listError.AppendLine(errors)
        Mensaje(EeventViewerImages.Advertencia) = listError.ToString()
    End Sub

    ''' <summary>
    ''' Anula el documento
    ''' </summary>
    Public Async Sub Anular()
        If Me._voucherTransaction IsNot Nothing AndAlso Me._voucherTransaction.Id > 0 Then
            If MessageIndigo.Show(ResourceManager.GetString("AnnularMessage"), MessageType.Question, Me.Text, Botones.SiNo) = System.Windows.Forms.DialogResult.Yes Then
                _voucherTransaction.Status = 3
                Try
                    Using Model As New MVoucherTransaction(Me.Tag.ToString())
                        AsyncLoader(True)
                        Dim result = Await Model.SaveVoucherTransaction(Me._voucherTransaction, False, Me._idCurrentSequence, Me._sequence)
                        AsyncLoader(False)
                        If result.StateResult = True Then
                            Mensaje(EeventViewerImages.Informacion) = ResourceManager.GetString("AnnularCorrect")
                            Me._voucherTransaction = result.ObjectEmbbeded

                            Me.BarraBotones.PrintReport(PrintReportAction.Cancel, _voucherTransaction.Id, 0, _voucherTransaction.Id)

                            Me.UpdateIndexedDocument(Me.BarraBotones._listDocuments)
                            IdCheckBook = 0
                            CheckNumber = 0
                            Me.Deshacer()
                        Else
                            '_voucherTransaction.VoucherTransactionDetails.Clear()
                            If result.Message IsNot Nothing Then
                                generateListError(result.Message)
                            End If
                        End If
                    End Using
                Catch ex As Exception
                    AsyncLoader(False)
                    INDbteCode.Enabled = False
                    Throw ex
                End Try
            End If
        End If
    End Sub

    ''' <summary>
    ''' Confirma el comprobante de egreso
    ''' </summary>
    ''' <exception cref="System.NotImplementedException"></exception>
    Private Async Sub Confirmar()
        Try
            Using Model As New MVoucherTransaction(Me.Tag.ToString())
                AsyncLoader(True)
                Dim Result = Await Model.ConfirmVoucherTransaction(Me._voucherTransaction.Id, Me._idCurrentSequence)
                AsyncLoader(False)
                If Result.StateResult = True Then
                    Dim consecutive = Result.ObjectEmbbeded
                    Mensaje(EeventViewerImages.Informacion) = String.Format(ResourceManager.GetString("DocumentConfirmWithConsecutive"), consecutive)
                    Me.UpdateIndexedDocument(Me.BarraBotones._listDocuments)
                    UnlockCheck()
                    Me.Deshacer()
                Else
                    If Result.Message IsNot Nothing Then
                        generateListError(Result.Message)
                    End If
                End If
            End Using
        Catch ex As Exception
            AsyncLoader(False)
            INDbteCode.Enabled = False
            Throw ex
        End Try
    End Sub

    ''' <summary>
    ''' Validates the entity.
    ''' </summary>
    Private Function ValidateEntity(ByVal auxEntity As VoucherTransaction) As Boolean
        If (auxEntity.Id = _voucherTransaction.Id AndAlso auxEntity.Code = _voucherTransaction.Code AndAlso
            auxEntity.ExpenseType = _voucherTransaction.ExpenseType AndAlso auxEntity.Detail = _voucherTransaction.Detail AndAlso auxEntity.DocumentDate = _voucherTransaction.DocumentDate AndAlso
            auxEntity.Value = _voucherTransaction.Value) Then
            Return True
        End If
        Return False
    End Function

    ''' <summary>
    ''' Oculta los controles de conceptos
    ''' </summary>
    Private Sub HideConceptControls()
        INDliThirdParty.HideControl(True)
        INDlgrExpenditureConcept.HideControl(True)
    End Sub

    ''' <summary>
    ''' METODO: Item Nuevo del control de usuarios.
    ''' </summary>
    Public Async Sub Nuevo() Implements IcrudBase.Nuevo
        If _sequence Is Nothing OrElse _sequence.Id = 0 Then
            Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("SequenceNotFound")
            Exit Sub
        End If

        If Me._sequence.IsManual Then
            Deshacer()
        Else
            Await Me.NewVoucherTransaction()
        End If
    End Sub

#End Region

