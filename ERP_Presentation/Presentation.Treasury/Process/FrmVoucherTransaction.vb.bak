    Dim DatasourceDischargeBillPopUp As List(Of DischargeBill)
    ''' <summary>
    ''' método que carga las cuotas de las facturas asociadas al tercero en la rejilla (se ejecuta cuando se lee de la base de datos)
    ''' </summary>
    Private Sub LoadDischargeBillByVoucherTransactionId(IdVoucherTransactionD As Integer, ExpenseConceptId As Integer)
        Using ModelXpo As New MBusqueda
            _bandBalanceChanged = False
            Dim filter() As Object = {IdVoucherTransactionD}
            Dim _dischargeBillXpo As XPCollection = ModelXpo.ConsultarEntidades(eDataSource.ListDischargeBillByIdVoucherTransactionDXpo, filter)
            Dim _tmpDischargeBill As New List(Of DischargeBill)()
            For Each dBill As DischargeBillXpo In _dischargeBillXpo
                Dim _dischargeBill As New DischargeBill()
                Dim Share As Infrastructure.Data.Xpo.TreasuryRepository.AccountPayableSharesXpo = dBill.IdAccountPayableShare
                With _dischargeBill
                    .IdVoucherTransactionD = dBill.IdVoucherTransactionD
                    .IdAccountPayable = Share.IdAccountPayable.Id
                    .IdAccountPayableShare = Share.Id
                    .AccountPayableBillNumber = Share.IdAccountPayable.BillNumber
                    .AccountPayableShareDateExpires = Share.DateExpires
                    .AccountPayableShareBalance = Share.Balance
                    .AccountPayableShareShare = Share.Share
                    .Id = dBill.Id
                    .AdvancePercent = dBill.AdvancePercent
                    .AdvancedValue = dBill.AdvancedValue
                    .PaymentOrderValue = dBill.PaymentOrderValue
                    .OperativeUnitId = Share.IdAccountPayable.IdOperatingUnit
                    If Not TreasuryStaticServices.ValidateBalanceAccountPayableShare(Share.Balance, dBill.AdvancedValue) Then
                        _bandBalanceChanged = True
                    End If
                    .IdPaymentConcept = dBill.IdPaymentConcept
                    .ExpenseConceptId = ExpenseConceptId
                    'Consulto las edades de cartera
                    If _dictionaryAgesPayments Is Nothing Then
                        _dictionaryAgesPayments = New Dictionary(Of Integer, List(Of AgesPayments))()
                    End If
                    If Not _dictionaryAgesPayments.ContainsKey(.OperativeUnitId) Then
                        Using Model As New MAgesPayment(Me.Tag)
                            Dim _agesPayment As List(Of AgesPayments) = (Model.ListAgesPaymentByUnitOperativeIdSimple(.OperativeUnitId)).ObjectEmbbeded
                            _dictionaryAgesPayments.Add(.OperativeUnitId, _agesPayment)
                        End Using
                    End If
                    Dim daysExpired As Integer = (_serverDate - .AccountPayableShareDateExpires).TotalDays
                    If daysExpired <= 0 Then
                        .ColorAgePortFolio = Convert.ToInt32(ePortfolioAge.ColorDefault) 'Color.FromArgb(Convert.ToInt32(ePortfolioAge.ColorDefault))
                    Else
                        .ColorAgePortFolio = (From ap As AgesPayments In _dictionaryAgesPayments(.OperativeUnitId) Where ap.InitialRange <= daysExpired And ap.EndRange >= daysExpired Select ap.Color).FirstOrDefault()
                    End If
                    If BudgetInterface Then
                        If dBill.DischargeBillBudgetXpo IsNot Nothing Then
                            For Each dischargeBillBudgetXpo In dBill.DischargeBillBudgetXpo
                                _dischargeBill.DischargeBillBudget.Add(New DischargeBillBudget With {
                                    .Id = dischargeBillBudgetXpo.Id,
                                    .ObligationDetailId = dischargeBillBudgetXpo.ObligationDetailId,
                                    .Value = dischargeBillBudgetXpo.Value
                                })
                            Next
                        End If

                        'Obtenemos los detalles presupuestales asociados a la cuenta por pagar
                        GetObligationDetailsByDischargeBill(_dischargeBill)
                    End If

                    If _voucherTransaction.Status <> 2 Then
                        If _bandBalanceChanged Then
                            If Me.ParentForm.InvokeRequired Then
                                Me.ParentForm.BeginInvoke(Sub()
                                                              Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("BalanceChanged", NAME_MODULE)
                                                          End Sub)
                            Else
                                Mensaje(EeventViewerImages.Advertencia) = ResourceManager.GetString("BalanceChanged", NAME_MODULE)
                            End If
                        End If
                    End If
                End With
                _tmpDischargeBill.Add(_dischargeBill)
            Next
            If DatasourceDischargeBillPopUp Is Nothing Then
                DatasourceDischargeBillPopUp = New List(Of DischargeBill)()
            End If
            If INDGcDischargeBill.InvokeRequired Then
                INDGcDischargeBill.BeginInvoke(Sub()
                                                   'DischargeBillDatasource = _tmpDischargeBill
                                                   DatasourceDischargeBillPopUp.AddRange(_tmpDischargeBill)
                                               End Sub)
            Else
                'DischargeBillDatasource = _tmpDischargeBill
                DatasourceDischargeBillPopUp.AddRange(_tmpDischargeBill)
            End If
        End Using
    End Sub

    ''' <summary>
    ''' Consulta las obligaciones presupuestales asociadas a una cuenta por pagar
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub GetObligationDetailsByDischargeBill(dischargeBill As DischargeBill)
        Using model As New MVoucherTransaction(Me.Tag)
            Dim collectionObligation = model.GetObligationDetails(dischargeBill.IdAccountPayable, If(_voucherTransaction.Status = 1, 1, 2))
            If collectionObligation IsNot Nothing Then
                For Each detail In collectionObligation
                    Dim dischargeBillBudget = dischargeBill.DischargeBillBudget.FirstOrDefault(Function(d) d.ObligationDetailId = detail.Id)
                    If dischargeBillBudget Is Nothing Then
                        If Not _voucherTransaction.Status = 1 Then
                            Continue For
                        End If

                        dischargeBillBudget = New DischargeBillBudget With {
                            .ObligationDetailId = detail.Id,
                            .Value = 0
                        }
                        dischargeBill.DischargeBillBudget.Add(dischargeBillBudget)
                    End If

                    dischargeBillBudget.CommitmentCode = detail.CommitmentCode
                    dischargeBillBudget.CommitmentDocument = detail.CommitmentDocument
                    dischargeBillBudget.CategoryCodeName = detail.CategoryCodeName
                    dischargeBillBudget.FinancialSourceCodeName = detail.FinancialSourceCodeName
                    dischargeBillBudget.RevenueTypeCodeName = detail.RevenueTypeCodeName
                    dischargeBillBudget.Balance = detail.Balance
                Next
            End If
        End Using
    End Sub

#End Region

#Region "Events"

#Region "QueryPopUp"
    ''' <summary>
    ''' Handles the QueryPopUp event of the RepositoryPopMoreInfo control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="System.ComponentModel.CancelEventArgs"/> instance containing the event data.</param>
    Private Async Sub RepositoryPopMoreInfo_QueryPopUp(sender As Object, e As System.ComponentModel.CancelEventArgs) Handles RepositoryPopMoreInfo.QueryPopUp
        Dim popUp As DevExpress.XtraEditors.PopupContainerEdit = CType(sender, DevExpress.XtraEditors.PopupContainerEdit)
        If popUp.Parent IsNot Nothing Then
            Dim view As GridView = CType(CType(popUp.Parent, GridControl).MainView, GridView)
            Dim obj() As Object = New Object() {view.GetFocusedRow()}
            Dim datasourceConcetp As VoucherTransactionDetails = view.GetFocusedRow()
            If popUp.Properties.PopupControl IsNot Nothing AndAlso popUp.Properties.PopupControl.Controls IsNot Nothing AndAlso popUp.Properties.PopupControl.Controls.Count > 0 Then
                Dim vgrid As DevExpress.XtraVerticalGrid.VGridControl = popUp.Properties.PopupControl.Controls(0).Controls(9)
                CleanLayoutPopUpMoreInfo()
                Select Case datasourceConcetp.ExpenseConceptBehavior
                    Case eBehavior.TransferBetweenBanks
                        Using Model As New MEntityAccount(Me.Tag)
                            Dim entBank As EntityBankAccounts = Await Model.GetEntityBankAccountById(datasourceConcetp.IdEntityBankAccount)
                            If entBank IsNot Nothing AndAlso entBank.Id > 0 Then
                                Using ModelBank As New Presentation.Common.MVP.MBank(Me.Tag)
                                    Dim bank As Domain.Entities.Bank = ModelBank.GetBankById(entBank.IdBank)
                                    INDtxtBankTraslate.EditValue = String.Format(ResourceManager.GetString("EntityAccountDescription", NAME_MODULE), entBank.Code, bank.Name, entBank.Type, entBank.Number)
                                End Using
                            End If
                        End Using
                        INDlgrBankTraslate.HideControl(False)
                    Case eBehavior.PettyCash
                        INDlgrInvoices.HideControl(False)
                        INDliAdvancePaymentInfo.HideControl(True)
                    Case eBehavior.PaymentAdvancePaymentInvoices
                        INDlgrInvoices.HideControl(False)
                        INDliAdvancePaymentInfo.HideControl(False)
                        INDtxtValueAdvance.EditValue = datasourceConcetp.AdvanceValue
                        If DatasourceDischargeBillPopUp IsNot Nothing AndAlso DatasourceDischargeBillPopUp.Any() Then
                            DischargeBillDatasource = DatasourceDischargeBillPopUp.Where(Function(x) x.ExpenseConceptId = datasourceConcetp.IdExpenseConcept).ToList()
                            INDGcDischargeBill.RefreshDataSource()
                        End If
                    Case eBehavior.ReturningImprestRC
                        INDlgrAdvancePayment.HideControl(False)
                        If ListVoucherTransactionAdvance Is Nothing OrElse ListVoucherTransactionAdvance.Count = 0 Then
                            LoadVoucherTransactionAdvance(datasourceConcetp.Id)
                        End If
                        INDgcAdvance.DataSource = ListVoucherTransactionAdvance.Where(Function(x) x.Value > 0 AndAlso x.ChangeTracker.State <> ObjectState.Deleted).ToList()
                    Case eBehavior.PettyCashReimbursement
                        INDlgrRefund.HideControl(False)
                        INDgcRefund.DataSource = Nothing
                        INDgcRefund.DataSource = _listRefund
                    Case eBehavior.Ninguno
                End Select
                vgrid.DataSource = Nothing
                vgrid.DataSource = obj
                vgrid.RefreshDataSource()
            End If
        End If
    End Sub

    ''' <summary>
    ''' Carga los anticipos de tesoreria por id del detalle
    ''' </summary>
    Private Sub LoadVoucherTransactionAdvance(voucherDetailId As Integer)
        Using Model As New MVoucherTransaction(Me.Tag)
            Dim _listVoucherTransactionAdvance = Model.ListVoucherTransactionAdvanceByVoucherTransactionDetailId(voucherDetailId)
            ListVoucherTransactionAdvance = New List(Of VoucherTransactionAdvance)()
            For Each item As Infrastructure.Data.Xpo.TreasuryRepository.VoucherTransactionAdvanceXpo In _listVoucherTransactionAdvance
                Dim voucherTransactionAdvance = New VoucherTransactionAdvance()
                With voucherTransactionAdvance
                    .Id = item.Id
                    .IdVoucherTransactionD = item.IdVoucherTransactionD
                    .PortfolioAdvanceId = item.PortfolioAdvanceId.Id
                    .Value = item.Value
                    .Percentage = item.Percentage
                    .PortfolioAdvanceCode = item.PortfolioAdvanceId.Code
                    .PortfolioAdvanceDocumentDate = item.PortfolioAdvanceId.DocumentDate
                    .PortfolioAdvanceBalance = item.PortfolioAdvanceId.Balance
                End With
                ListVoucherTransactionAdvance.Add(voucherTransactionAdvance)
            Next
        End Using
    End Sub

    ''' <summary>
    ''' Oculta los grupos del popUp more info
    ''' </summary>
    Private Sub CleanLayoutPopUpMoreInfo()
        INDlgrBankTraslate.HideControl(True)
        INDlgrInvoices.HideControl(True)
        INDlgrAdvancePayment.HideControl(True)
        INDlgrRefund.HideControl(True)
    End Sub
#End Region

#Region "Actions"
    ''' <summary>
    ''' Handles the ButtonAction event of the IndigoGridView1_Click control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub IndigoGridView1_Click_ButtonAction(sender As Object, e As EventArgs) Handles IndigoGridView1.Click_ButtonAction, IndigoGridView1.ContexMenuActions
        Select Case (sender.Tag)
            Case "Add", Infrastructure.CrossCutting.Resources.ResourceManager.GetString("Add")
                AddVoucherTransactionDetail(False)
            Case "Edit", Infrastructure.CrossCutting.Resources.ResourceManager.GetString("Edit")
                AddVoucherTransactionDetail(True)
            Case "Remove", Infrastructure.CrossCutting.Resources.ResourceManager.GetString("Remove")
                DeleteVoucherTransactionDetail()
        End Select
    End Sub

    ''' <summary>
    ''' Handles the ButtonAction event of the IndigoGridView2_Click control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub IndigoGridView2_Click_ButtonAction(sender As Object, e As EventArgs) Handles IndigoGridView2.ContexMenuActions, IndigoGridView2.Click_ButtonAction
        Select Case (sender.Tag)
            Case "Add", Infrastructure.CrossCutting.Resources.ResourceManager.GetString("Add")
                AddVoucherTransactionDetail(False)
            Case "Edit", Infrastructure.CrossCutting.Resources.ResourceManager.GetString("Edit")
                AddVoucherTransactionDetail(True)
            Case "Remove", Infrastructure.CrossCutting.Resources.ResourceManager.GetString("Remove")
                RemoveBankAccount()
        End Select
    End Sub

    ''' <summary>
    ''' Removes the bank account.
    ''' </summary>
    Private Sub RemoveBankAccount()
        If MessageIndigo.Show(ResourceManager.GetString("DeleteRecord"), MessageType.Question, Me.Text, Botones.SiNo) = System.Windows.Forms.DialogResult.Yes Then
            Dim voucherDetail As VoucherTransactionDetails = CType(ViewTransfer.GetFocusedRow(), VoucherTransactionDetails)
            If voucherDetail.Id <> 0 Then
                voucherDetail.MarkAsDeleted()
                _voucherTransaction.MarkAsModified()

            End If
            Dim _entityDatasourceTmp = EntityBankAccountDatasourceGrid
            _entityDatasourceTmp.Remove(voucherDetail)
            EntityBankAccountDatasourceGrid = _entityDatasourceTmp
            INDGcVoucherTransactionDetail.RefreshDataSource()
            'INDgcEntityBank.DataSource = Nothing
            'INDgcEntityBank.DataSource = EntityBankAccountDatasourceGrid

            'Se valida si la entidad principal tiene datos
            If _voucherTransaction.VoucherTransactionDetails IsNot Nothing AndAlso _voucherTransaction.VoucherTransactionDetails.Count > 0 Then
                If _voucherTransaction.VoucherTransactionDetails.Contains(voucherDetail) AndAlso voucherDetail.Id = 0 Then
                    _voucherTransaction.VoucherTransactionDetails.Remove(voucherDetail)
                End If
            End If

            Me.RefreshXMilValue()
            ctrTmp.PrintValueVoucher()
        End If
    End Sub

#End Region

