#Region "DatasourceChanged"
    ''' <summary>
    ''' Handles the DataSourceChanged event of the INDGcDisbursementVoucher control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub INDGcDisbursementVoucher_DataSourceChanged(sender As Object, e As EventArgs) Handles INDGcVoucherTransactionDetail.DataSourceChanged
        If VoucherTransactionDetailDatasource IsNot Nothing AndAlso VoucherTransactionDetailDatasource.Count > 0 Then
            INDGvVoucherTransactionDetail.OptionsView.ShowFooter = True
            INDsleThirdParty.Properties.ReadOnly = True
            INDgleExpenseType.Properties.ReadOnly = True
        Else
            INDGvVoucherTransactionDetail.OptionsView.ShowFooter = False
            INDsleThirdParty.Properties.ReadOnly = False
            INDgleExpenseType.Properties.ReadOnly = False
        End If
    End Sub

    ''' <summary>
    ''' Handles the DataSourceChanged event of the INDgcEntityBank control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub INDgcEntityBank_DataSourceChanged(sender As Object, e As EventArgs)
        If EntityBankAccountDatasourceGrid IsNot Nothing AndAlso EntityBankAccountDatasourceGrid.Count > 0 Then
            INDgleVoucherClass.Properties.ReadOnly = True
            INDgleExpenseType.Properties.ReadOnly = True
            If ExpenseType = 1 Then
                INDsleEntityAccount.Properties.ReadOnly = True
            ElseIf ExpenseType = 3 Then
                INDsleCash.Properties.ReadOnly = True
            End If
        Else
            INDgleVoucherClass.Properties.ReadOnly = False
            INDgleExpenseType.Properties.ReadOnly = False
            If ExpenseType = 1 Then
                INDsleEntityAccount.Properties.ReadOnly = False
            ElseIf ExpenseType = 3 Then
                INDsleCash.Properties.ReadOnly = False
            End If
        End If
    End Sub
#End Region

#Region "Load"
    Private Sub Frm_Disposed(sender As Object, e As EventArgs) Handles MyBase.Disposed
        IsLoading = Nothing
        asyncConcepts = Nothing
        _serverDate = Nothing
        ListVoucherTransactionAdvance = Nothing
        _dictionaryAgesPayments = Nothing
        _statePopUpCash = Nothing
        _statePopUpCostCenter = Nothing
        _statePopUpThird = Nothing
        _statePopUpEntityBankAccount = Nothing
        _bandBalanceChanged = Nothing
        _modeEditPopUpExpenseConcept = Nothing
        _listRefund = Nothing
        ctrTmp = Nothing
        _sequence = Nothing
        _idCurrentSequence = Nothing
        _prefixSelected = Nothing
        OpenFormDialog = Nothing
        _idOperativeUnit = Nothing
        _record = Nothing
        _presenter = Nothing
        _voucherTransaction = Nothing
        ListExpenseType = Nothing
        ListPaymentMethod = Nothing
        ListVoucherClass = Nothing
        ListEntityBankAccountsTransfer = Nothing
        EntityBankAccount = Nothing
    End Sub
    ''' <summary>
    ''' Handles the Load event of the FrmDisbursementVouchers control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub FrmDisbursementVouchers_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        AddHandler System.Windows.Forms.Application.ThreadExit, AddressOf Application_ThreadExit
        Me.LayoutControls.SetIsCustomizable(Me.INDlycRoot, True)
        Me._idOperativeUnit = Me.BarraBotones.OperatingUnitValue
        '****Inicializar variables*****'
        Me._doc = Nothing
        Me._funct = AddressOf GenerateDoc
        Me.indigo = SessionValues.Instance

        IndigoGridControl1.RefreshGrid(INDGcVoucherTransactionDetail)

        _presenter = New PVoucherTransaction(Me)
        _presenter.InitializeEntityBankAccount()
        _presenter.LoadDateServer(Me.GetDateServer())
        _presenter.GetSequence()
        _presenter.InitializePaymentConcept()
        _presenter.LoadDefinitionLayout()
        _presenter.GetSettingsPaymentsByOperatingUnitId(Me._idOperativeUnit)

        Dim listAction As New List(Of eAcciones)
        'listAction.Add(eAcciones.Add)
        listAction.Add(eAcciones.Remove)
        listAction.Add(eAcciones.Edit)
        IndigoGridView2.SetListAcction(ViewTransfer, listAction)
        IndigoGridView1.SetListAcction(INDGvVoucherTransactionDetail, listAction)
        For Each col As DevExpress.XtraGrid.Columns.GridColumn In INDGvVoucherTransactionDetail.Columns
            If col.Name = "colActions" Then
                col.Width = 250
            End If
        Next
        For Each col As DevExpress.XtraGrid.Columns.GridColumn In ViewTransfer.Columns
            If col.Name = "colActions" Then
                col.Width = 250
            End If
        Next
        _serverDate = Me.GetDateServer()
        _statePopUpCash = False
        _statePopUpCostCenter = False
        _statePopUpThird = False
        _statePopUpEntityBankAccount = False

        'CreatePaymentMethod()
        CreateVoucherClass()
        LoadStatus()
        Deshacer()
    End Sub

    ''' <summary>
    ''' Handles the FormClosing event of the FrmDisbursementVouchers control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="FormClosingEventArgs"/> instance containing the event data.</param>
    Private Sub FrmDisbursementVouchers_FormClosing(sender As Object, e As FormClosingEventArgs) Handles MyBase.FormClosing
        UnlockCheck()
    End Sub

    Private Sub Application_ThreadExit(sender As Object, e As EventArgs)
        UnlockCheck()
    End Sub

    Private Sub UnlockCheck()
        If asyncConcepts IsNot Nothing AndAlso asyncConcepts.IsBusy AndAlso asyncConcepts.WorkerSupportsCancellation Then
            asyncConcepts.CancelAsync()
        End If
        DeleteBlockedRecord()
        DeleteCheckBlock()
    End Sub

    ''' <summary>
    ''' Handles the IdEntityLoaded event of the MyBase control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="System.EventArgs"/> instance containing the event data.</param>
    Private Sub MyBase_IdEntityLoaded(sender As Object, e As EventArgs) Handles Me.IdEntityLoaded
        If Me._voucherTransaction IsNot Nothing AndAlso Me._voucherTransaction.Id > 0 Then
            If (MessageIndigo.Show(obtenerRecurso(Eresources.ComunesAbrirEntidad, Eform.Comunes), MessageType.Question, obtenerRecurso(Eresources.RegistroEnEdicion, Eform.Comunes), Botones.SiNo) = System.Windows.Forms.DialogResult.Yes) Then
                CleanControls()
                DeleteBlockedRecord()
                Me.INDbteCode.Text = Me.IdEntity.Trim()
                Me.LoadControls()
            End If
        Else 'Realiza la consulta normal
            Me.INDbteCode.Text = Me.IdEntity.Trim()
            Me.LoadControls()
            If FormSearchObjects IsNot Nothing Then
                FormSearchObjects.Close()
            End If
        End If
        Me.IdEntity = String.Empty
    End Sub
#End Region

#Region "EditValueChanged"
    ''' <summary>
    ''' Handles the EditValueChanged event of the INDgleExpenseType control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub INDgleExpenseType_EditValueChanged(sender As Object, e As EventArgs) Handles INDgleExpenseType.EditValueChanged
        IndigoGridControl1.RefreshGrid(INDGcVoucherTransactionDetail)
        Select Case ExpenseType
            Case CShort(eExpenseType.BankAccount)
                INDliCash.HideControl()
                INDsleCash.EditValue = Nothing
                INDliEntityBankAccount.HideControl(False)
                'INDliXMil.HideControl(False)
                If VoucherClass = eVoucherClass.Refund OrElse VoucherClass = eVoucherClass.Transfer Then
                    INDsbAddExpenseConcept.Text = ResourceManager.GetString("LabelAddBank", NAME_MODULE)
                    INDlgrExpenditureConcept.HideControl(False)
                End If
            Case CShort(eExpenseType.MinorCash), CShort(eExpenseType.MajorCash)
                INDliEntityBankAccount.HideControl()
                INDliCostCenter.HideControl()
                INDliPaymentMethod.HideControl()
                INDliDebitNote.HideControl()
                INDliCheck.HideControl()
                INDliTransactionDate.HideControl()
                INDsleCostCenter.EditValue = Nothing
                INDglePaymentMethod.EditValue = Nothing
                INDtxtDebitNote.EditValue = Nothing
                INDrgXMil.EditValue = False
                INDsleEntityAccount.EditValue = Nothing
                IdCheckBook = Nothing
                CheckNumber = 0
                TransactionDate = Nothing
                TaxByMil = False
                TaxByMilValue = 0
                'INDliXMil.HideControl()
                INDliCash.HideControl(False)
                _statePopUpCash = False
                INDsleCash.EditValue = Nothing

                If VoucherClass = eVoucherClass.Refund OrElse VoucherClass = eVoucherClass.Transfer Then
                    INDsbAddExpenseConcept.Text = ResourceManager.GetString("LabelAddCash", NAME_MODULE)
                    INDlgrExpenditureConcept.HideControl(False)
                End If
        End Select
    End Sub

    ''' <summary>
    ''' Handles the EditValueChanged event of the INDgleVoucherClass control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub INDgleVoucherClass_EditValueChanged(sender As Object, e As EventArgs) Handles INDgleVoucherClass.EditValueChanged
        If VoucherClass <> 0 Then
            IndigoGridControl1.RefreshGrid(INDGcVoucherTransactionDetail)
            HideConceptControls()
            Select Case VoucherClass
                Case eVoucherClass.Payment
                    INDlgrExpenditureConcept.HideControl(False)
                    INDliThirdParty.HideControl(False)

                    INDlgrExpenditureConcept.AllowHide = False
                    INDliThirdParty.AllowHide = False

                Case eVoucherClass.Refund, eVoucherClass.Transfer
                    INDsleThirdParty.EditValue = Nothing
            End Select
            CreateListExpenseType()
            INDgleExpenseType.Properties.ReadOnly = False
        Else
            INDgleExpenseType.Properties.DataSource = Nothing
            INDgleExpenseType.Properties.ReadOnly = True
        End If
    End Sub

    ''' <summary>
    ''' Handles the EditValueChanging event of the INDglePaymentMethod control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="DevExpress.XtraEditors.Controls.ChangingEventArgs"/> instance containing the event data.</param>
    Private Sub INDglePaymentMethod_EditValueChanging(sender As Object, e As DevExpress.XtraEditors.Controls.ChangingEventArgs) Handles INDglePaymentMethod.EditValueChanging
        If e.NewValue IsNot Nothing Then
            If CInt(e.NewValue) = CInt(ePaymentType.DebitNote) Then
                If _idOperativeUnit = 0 Then
                    Mensaje(EeventViewerImages.Advertencia) = "Seleccione Unidad Operativa"
                    e.Cancel = True
                End If
            End If
        End If
    End Sub

    ''' <summary>
    ''' Handles the EditValueChanged event of the INDglePaymentMethod control. (refactorizar este evento)
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Async Sub INDglePaymentMethod_EditValueChanged(sender As Object, e As EventArgs) Handles INDglePaymentMethod.EditValueChanged
        If INDglePaymentMethod.EditValue IsNot Nothing Then
            If CInt(INDglePaymentMethod.EditValue) = CInt(ePaymentType.Check) Then
                If CInt(INDtxtCheck.EditValue) <> 0 Then
                    DeleteCheckBlock()
                End If
                Await LoadCheck()
                Me.BarraBotones.LoadReportsAndDefinitions()
            ElseIf CInt(INDglePaymentMethod.EditValue) = CInt(ePaymentType.DebitNote) Then
                DeleteCheckBlock()
                INDliCheck.HideControl(True)
                INDliDebitNote.HideControl(False)
                INDliTransactionDate.HideControl(True)
                INDdeTransactionDate.EditValue = Nothing
            End If
        End If
    End Sub

    ''' <summary>
    ''' Handles the EditValueChanged event of the INDsleEntityBankAccount control.
    ''' </summary>
    ''' <param name="sender">The source of the event.</param>
    ''' <param name="e">The <see cref="EventArgs"/> instance containing the event data.</param>
    Private Sub INDsleEntityBankAccount_EditValueChanged(sender As Object, e As EventArgs) Handles INDsleEntityAccount.EditValueChanged
        If INDsleEntityAccount.EditValue IsNot Nothing AndAlso INDsleEntityAccount.EditValue > 0 Then
            EntityBankAccount = Nothing
            If IsLoading Then
                EntityBankAccount = _voucherTransaction.EntityBankAccounts
            Else
                EntityBankAccount = DirectCast(DirectCast(INDGvEntityAccount.GetFocusedRow(), DevExpress.Data.Async.Helpers.ReadonlyThreadSafeProxyForObjectFromAnotherThread).OriginalRow, Infrastructure.Data.Xpo.TreasuryRepository.EntityBankAccountXpo)
                IdMainAccount = EntityBankAccount.IdMainAccount.Id
                IdCostCenter = EntityBankAccount.IdCostCenter
            End If
            CreatePaymentMethod(EntityBankAccount.Type)
            If EntityBankAccount.Type = eEntityBankAccountType.Saving AndAlso Not IsLoading Then
                PaymentMethod = 2
            End If
            If EntityBankAccount IsNot Nothing AndAlso EntityBankAccount.Id > 0 Then
                If Me._sequence.Scope.Equals("O") Then
                    Me._idCurrentSequence = Me.GetIdSequenceByPrefix(EntityBankAccount.Prefix)
                    Me._prefixSelected = EntityBankAccount.Prefix
                End If
                If EntityBankAccount.IdCostCenter IsNot Nothing AndAlso EntityBankAccount.IdCostCenter > 0 Then
                    INDliCostCenter.HideControl(False)
                    INDsleCostCenter.EditValue = EntityBankAccount.IdCostCenter
                Else
                    INDliCostCenter.HideControl()
                    INDsleCostCenter.EditValue = Nothing
                End If
                If EntityBankAccount.Type = eEntityBankAccountType.Current Then
                    If PaymentMethod IsNot Nothing AndAlso PaymentMethod > 0 Then
                        INDglePaymentMethod_EditValueChanged(Nothing, Nothing)
                    End If
                End If
            End If
            INDliPaymentMethod.HideControl(False)
            Me.BarraBotones.LoadReportsAndDefinitions()
        Else
            If Me._sequence.Scope.Equals("O") Then
                Me._idCurrentSequence = Me.GetIdSequenceByPrefix("-")
                Me._prefixSelected = String.Empty
            End If
            'INDliPaymentMethod.HideControl()
        End If
        ActiveInactivePopUpExpenseConcept()
    End Sub

    '''' <summary>
    '''' Handles the EditValueChanged event of the INDrgXMil control.
    '''' </summary>
