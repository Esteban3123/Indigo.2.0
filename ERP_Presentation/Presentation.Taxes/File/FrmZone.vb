Imports Infrastructure.CrossCutting.Base
Imports Presentation.Base

Public Class FrmZone
    Private Sub BarraBotones_Load(sender As Object, e As EventArgs) Handles BarraBotones.Load
        BarraBotones.ActualizarPermisosBarra(Me.Tag)
    End Sub

    Private Sub ButtonEdit1_Enter(sender As Object, e As EventArgs) Handles ButtonEdit1.Enter
        Mensaje(EeventViewerImages.Advertencia) = "No se encuentran parametros NIIF"
    End Sub

    Public WriteOnly Property Mensaje(Icono As EeventViewerImages) As String
        Set(value As String)
            If Icono = EeventViewerImages.Advertencia Then
                MessageIndigo.Show(value, MessageType.Warning, Me.Text, Me)
            ElseIf Icono = EeventViewerImages.Informacion Then
                MessageIndigo.Show(value, MessageType.Information, Me.Text, Me)
            ElseIf Icono = EeventViewerImages.MensajeError Then
                MessageIndigo.Show(value, MessageType.Errores, Me.Text, Botones.Aceptar, "")
            End If
        End Set
    End Property
End Class