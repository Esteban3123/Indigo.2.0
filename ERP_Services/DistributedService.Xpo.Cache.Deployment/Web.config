    <add name="XpoConnection2" connectionString="data source=DiegoRL;user id=droldan;password=123;initial catalog={0};Persist Security Info=true;Application Name=XpoConnection; XpoDataStorePool=True;XpoDataStorePoolSize=20;XpoDataStorePoolMaxConnections=50;" providerName="System.Data.SqlClient" />
    <add name="XpoConnection3" connectionString="data source=192.168.21.202;user id=sa;password=admin;initial catalog={0};Persist Security Info=true;Application Name=XpoConnection; XpoDataStorePool=True;XpoDataStorePoolSize=20;XpoDataStorePoolMaxConnections=50;" providerName="System.Data.SqlClient" />
    <add name="XpoConnection4" connectionString="data source=192.168.10.10;user id=genesis;password=123;initial catalog={0};Persist Security Info=true;Application Name=XpoConnection; XpoDataStorePool=True;XpoDataStorePoolSize=20;XpoDataStorePoolMaxConnections=50;" providerName="System.Data.SqlClient" />
    <add name="XpoConnection5" connectionString="data source=172.21.1.11;user id=genesis;password=123;initial catalog={0};Persist Security Info=true;Application Name=XpoConnection; XpoDataStorePool=True;XpoDataStorePoolSize=20;XpoDataStorePoolMaxConnections=50;" providerName="System.Data.SqlClient" />

