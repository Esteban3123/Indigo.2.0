                                   .TipoDocumentoVictima = dr("TipoDocumentoVictima").ToString(),
                                   .NumeroDocumentoVictima = dr("NumeroDocumentoVictima").ToString(),
                                   .FechaNacimientoVictima = dr("FechaNacimientoVictima").ToString(),
