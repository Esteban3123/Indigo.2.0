    Private Sub FixupAccountingStructure(ByVal previousValue As AccountingStructure, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.FunctionalUnit.Contains(Me) Then
            previousValue.FunctionalUnit.Remove(Me)
        End If

        If AccountingStructure IsNot Nothing Then
            AccountingStructure.FunctionalUnit.Add(Me)

            AccountingStructureId = AccountingStructure.Id
        ElseIf Not skipKeys Then
            AccountingStructureId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("AccountingStructure") AndAlso
                ChangeTracker.OriginalValues("AccountingStructure") Is AccountingStructure Then
                ChangeTracker.OriginalValues.Remove("AccountingStructure")
            Else
                ChangeTracker.RecordOriginalValue("AccountingStructure", previousValue)
            End If
            If AccountingStructure IsNot Nothing AndAlso Not AccountingStructure.ChangeTracker.ChangeTrackingEnabled Then
                AccountingStructure.StartTracking()
            End If
        End If
    End Sub

