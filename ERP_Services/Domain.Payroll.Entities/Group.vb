    Private Sub FixupCompany(ByVal previousValue As Company)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Group.Contains(Me) Then
            previousValue.Group.Remove(Me)
        End If

        If Company IsNot Nothing Then
            Company.Group.Add(Me)

            CompanyId = Company.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Company") AndAlso
                ChangeTracker.OriginalValues("Company") Is Company Then
                ChangeTracker.OriginalValues.Remove("Company")
            Else
                ChangeTracker.RecordOriginalValue("Company", previousValue)
            End If
            If Company IsNot Nothing AndAlso Not Company.ChangeTracker.ChangeTrackingEnabled Then
                Company.StartTracking()
            End If
        End If
    End Sub

