#Region "Association Fixup"

    Private Sub FixupBank(ByVal previousValue As Bank, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Liquidation.Contains(Me) Then
            previousValue.Liquidation.Remove(Me)
        End If

        If Bank IsNot Nothing Then
            Bank.Liquidation.Add(Me)

            BankId = Bank.Id
        ElseIf Not skipKeys Then
            BankId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Bank") AndAlso
                ChangeTracker.OriginalValues("Bank") Is Bank Then
                ChangeTracker.OriginalValues.Remove("Bank")
            Else
                ChangeTracker.RecordOriginalValue("Bank", previousValue)
            End If
            If Bank IsNot Nothing AndAlso Not Bank.ChangeTracker.ChangeTrackingEnabled Then
                Bank.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupCostCenter(ByVal previousValue As CostCenter, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Liquidation.Contains(Me) Then
            previousValue.Liquidation.Remove(Me)
        End If

        If CostCenter IsNot Nothing Then
            CostCenter.Liquidation.Add(Me)

            CostCenterId = CostCenter.Id
        ElseIf Not skipKeys Then
            CostCenterId = Nothing
        End If
