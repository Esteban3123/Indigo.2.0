    Private Sub FixupCostCenter(ByVal previousValue As CostCenter)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.ScheduleDetail.Contains(Me) Then
            previousValue.ScheduleDetail.Remove(Me)
        End If

        If CostCenter IsNot Nothing Then
            CostCenter.ScheduleDetail.Add(Me)

            CenterCostId = CostCenter.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("CostCenter") AndAlso
                ChangeTracker.OriginalValues("CostCenter") Is CostCenter Then
                ChangeTracker.OriginalValues.Remove("CostCenter")
            Else
                ChangeTracker.RecordOriginalValue("CostCenter", previousValue)
            End If
            If CostCenter IsNot Nothing AndAlso Not CostCenter.ChangeTracker.ChangeTrackingEnabled Then
                CostCenter.StartTracking()
            End If
        End If
    End Sub

