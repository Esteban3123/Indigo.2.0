            Dim keyNames As List(Of String) = targetType.KeyMembers.Select(Function(x) x.Name).ToList()
#>
    Private Sub Fixup<#=navProperty.Name#>Keys()
<#
            For k As Integer = 0 To keyNames.Count - 1
#>
