    Private Sub FixupRetentionConcepts(ByVal previousValue As RetentionConcepts, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.ThirdParty.Contains(Me) Then
            previousValue.ThirdParty.Remove(Me)
        End If

        If RetentionConcepts IsNot Nothing Then
            RetentionConcepts.ThirdParty.Add(Me)

            IVARetentionConceptId = RetentionConcepts.Id
        ElseIf Not skipKeys Then
            IVARetentionConceptId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("RetentionConcepts") AndAlso
                ChangeTracker.OriginalValues("RetentionConcepts") Is RetentionConcepts Then
                ChangeTracker.OriginalValues.Remove("RetentionConcepts")
            Else
                ChangeTracker.RecordOriginalValue("RetentionConcepts", previousValue)
            End If
            If RetentionConcepts IsNot Nothing AndAlso Not RetentionConcepts.ChangeTracker.ChangeTrackingEnabled Then
                RetentionConcepts.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupPerson(ByVal previousValue As Person)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.ThirdParty.Contains(Me) Then
            previousValue.ThirdParty.Remove(Me)
        End If

        If Person IsNot Nothing Then
            Person.ThirdParty.Add(Me)

            PersonId = Person.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Person") AndAlso
                ChangeTracker.OriginalValues("Person") Is Person Then
                ChangeTracker.OriginalValues.Remove("Person")
            Else
                ChangeTracker.RecordOriginalValue("Person", previousValue)
            End If
            If Person IsNot Nothing AndAlso Not Person.ChangeTracker.ChangeTrackingEnabled Then
                Person.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupCustomer(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As Customer In e.NewItems
                item.ThirdParty = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("Customer", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As Customer In e.OldItems
                If item.ThirdParty Is Me Then
                    item.ThirdParty = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("Customer", item)
                End If
            Next
        End If
    End Sub

