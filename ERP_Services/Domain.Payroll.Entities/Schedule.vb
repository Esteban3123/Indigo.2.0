    Private Sub FixupFunctionalUnit(ByVal previousValue As FunctionalUnit)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Schedule.Contains(Me) Then
            previousValue.Schedule.Remove(Me)
        End If

        If FunctionalUnit IsNot Nothing Then
            FunctionalUnit.Schedule.Add(Me)

            FunctionalUnitId = FunctionalUnit.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("FunctionalUnit") AndAlso
                ChangeTracker.OriginalValues("FunctionalUnit") Is FunctionalUnit Then
                ChangeTracker.OriginalValues.Remove("FunctionalUnit")
            Else
                ChangeTracker.RecordOriginalValue("FunctionalUnit", previousValue)
            End If
            If FunctionalUnit IsNot Nothing AndAlso Not FunctionalUnit.ChangeTracker.ChangeTrackingEnabled Then
                FunctionalUnit.StartTracking()
            End If
        End If
    End Sub

