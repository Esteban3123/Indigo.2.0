#Region "Association Fixup"

    Private Sub FixupThirdParty(ByVal previousValue As ThirdParty, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.MainAccounts.Contains(Me) Then
            previousValue.MainAccounts.Remove(Me)
        End If

        If ThirdParty IsNot Nothing Then
            ThirdParty.MainAccounts.Add(Me)

            IdThirdParty = ThirdParty.Id
        ElseIf Not skipKeys Then
            IdThirdParty = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ThirdParty") AndAlso
                ChangeTracker.OriginalValues("ThirdParty") Is ThirdParty Then
                ChangeTracker.OriginalValues.Remove("ThirdParty")
            Else
                ChangeTracker.RecordOriginalValue("ThirdParty", previousValue)
            End If
            If ThirdParty IsNot Nothing AndAlso Not ThirdParty.ChangeTracker.ChangeTrackingEnabled Then
                ThirdParty.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupMainAccounts2(ByVal previousValue As MainAccounts, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.MainAccounts1.Contains(Me) Then
            previousValue.MainAccounts1.Remove(Me)
        End If

        If MainAccounts2 IsNot Nothing Then
            MainAccounts2.MainAccounts1.Add(Me)

            IdParent = MainAccounts2.Id
        ElseIf Not skipKeys Then
            IdParent = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("MainAccounts2") AndAlso
                ChangeTracker.OriginalValues("MainAccounts2") Is MainAccounts2 Then
                ChangeTracker.OriginalValues.Remove("MainAccounts2")
            Else
                ChangeTracker.RecordOriginalValue("MainAccounts2", previousValue)
            End If
            If MainAccounts2 IsNot Nothing AndAlso Not MainAccounts2.ChangeTracker.ChangeTrackingEnabled Then
                MainAccounts2.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupLegalBook(ByVal previousValue As LegalBook)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.MainAccounts.Contains(Me) Then
            previousValue.MainAccounts.Remove(Me)
        End If

        If LegalBook IsNot Nothing Then
            LegalBook.MainAccounts.Add(Me)

            LegalBookId = LegalBook.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("LegalBook") AndAlso
                ChangeTracker.OriginalValues("LegalBook") Is LegalBook Then
                ChangeTracker.OriginalValues.Remove("LegalBook")
            Else
                ChangeTracker.RecordOriginalValue("LegalBook", previousValue)
            End If
            If LegalBook IsNot Nothing AndAlso Not LegalBook.ChangeTracker.ChangeTrackingEnabled Then
                LegalBook.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupCustomer(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As Customer In e.NewItems
                item.MainAccounts = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("Customer", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As Customer In e.OldItems
                If item.MainAccounts Is Me Then
                    item.MainAccounts = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("Customer", item)
                End If
            Next
        End If
    End Sub

    Private Sub FixupJournalVoucherDetails(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As JournalVoucherDetails In e.NewItems
                item.MainAccounts = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
