    Private Sub FixupVoucherTransactionDetails(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As VoucherTransactionDetails In e.NewItems
                item.VoucherTransaction = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("VoucherTransactionDetails", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As VoucherTransactionDetails In e.OldItems
                If item.VoucherTransaction Is Me Then
                    item.VoucherTransaction = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("VoucherTransactionDetails", item)
                End If
            Next
        End If
    End Sub

