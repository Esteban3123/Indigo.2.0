#Region "Association Fixup"

    Private Sub FixupCustomer(ByVal previousValue As Customer, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.AccountReceivable.Contains(Me) Then
            previousValue.AccountReceivable.Remove(Me)
        End If

        If Customer IsNot Nothing Then
            Customer.AccountReceivable.Add(Me)

            CustomerId = Customer.Id
        ElseIf Not skipKeys Then
            CustomerId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Customer") AndAlso
                ChangeTracker.OriginalValues("Customer") Is Customer Then
                ChangeTracker.OriginalValues.Remove("Customer")
            Else
                ChangeTracker.RecordOriginalValue("Customer", previousValue)
            End If
            If Customer IsNot Nothing AndAlso Not Customer.ChangeTracker.ChangeTrackingEnabled Then
                Customer.StartTracking()
            End If
        End If
    End Sub

