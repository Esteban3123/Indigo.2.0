                ChangeTracker.OriginalValues.Remove("CostCenter")
            Else
                ChangeTracker.RecordOriginalValue("CostCenter", previousValue)
            End If
            If CostCenter IsNot Nothing AndAlso Not CostCenter.ChangeTracker.ChangeTrackingEnabled Then
                CostCenter.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupCurrency(ByVal previousValue As Currency, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.AccountReceivable.Contains(Me) Then
            previousValue.AccountReceivable.Remove(Me)
        End If

        If Currency IsNot Nothing Then
            Currency.AccountReceivable.Add(Me)

            CurrencyId = Currency.Id
        ElseIf Not skipKeys Then
            CurrencyId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Currency") AndAlso
                ChangeTracker.OriginalValues("Currency") Is Currency Then
                ChangeTracker.OriginalValues.Remove("Currency")
            Else
                ChangeTracker.RecordOriginalValue("Currency", previousValue)
            End If
            If Currency IsNot Nothing AndAlso Not Currency.ChangeTracker.ChangeTrackingEnabled Then
                Currency.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupAccountReceivableAccounting(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As AccountReceivableAccounting In e.NewItems
                item.AccountReceivable = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("AccountReceivableAccounting", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As AccountReceivableAccounting In e.OldItems
                If item.AccountReceivable Is Me Then
                    item.AccountReceivable = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("AccountReceivableAccounting", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

