                If item.City1 Is Me Then
                    item.City1 = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("Person1", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

