    Private Sub FixupConcept2(ByVal previousValue As Concept, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Concept1.Contains(Me) Then
            previousValue.Concept1.Remove(Me)
        End If

        If Concept2 IsNot Nothing Then
            Concept2.Concept1.Add(Me)

            IdAdjustmentConcept = Concept2.Id
        ElseIf Not skipKeys Then
            IdAdjustmentConcept = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Concept2") AndAlso
                ChangeTracker.OriginalValues("Concept2") Is Concept2 Then
                ChangeTracker.OriginalValues.Remove("Concept2")
            Else
                ChangeTracker.RecordOriginalValue("Concept2", previousValue)
            End If
            If Concept2 IsNot Nothing AndAlso Not Concept2.ChangeTracker.ChangeTrackingEnabled Then
                Concept2.StartTracking()
            End If
        End If
    End Sub

