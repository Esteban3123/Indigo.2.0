    Private Sub FixupForeclousureDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As ForeclousureDetail In e.NewItems
                item.Foreclousure = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("ForeclousureDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As ForeclousureDetail In e.OldItems
                If item.Foreclousure Is Me Then
                    item.Foreclousure = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("ForeclousureDetail", item)
                End If
            Next
        End If
    End Sub

