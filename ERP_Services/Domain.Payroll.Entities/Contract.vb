    Private Sub FixupOrganizationChartPosition(ByVal previousValue As OrganizationChartPosition, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Contract.Contains(Me) Then
            previousValue.Contract.Remove(Me)
        End If

        If OrganizationChartPosition IsNot Nothing Then
            OrganizationChartPosition.Contract.Add(Me)

            OrganizationChartPositionId = OrganizationChartPosition.Id
        ElseIf Not skipKeys Then
            OrganizationChartPositionId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("OrganizationChartPosition") AndAlso
                ChangeTracker.OriginalValues("OrganizationChartPosition") Is OrganizationChartPosition Then
                ChangeTracker.OriginalValues.Remove("OrganizationChartPosition")
            Else
                ChangeTracker.RecordOriginalValue("OrganizationChartPosition", previousValue)
            End If
            If OrganizationChartPosition IsNot Nothing AndAlso Not OrganizationChartPosition.ChangeTracker.ChangeTrackingEnabled Then
                OrganizationChartPosition.StartTracking()
            End If
        End If
    End Sub

