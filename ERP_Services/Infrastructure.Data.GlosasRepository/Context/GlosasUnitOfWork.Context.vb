    Public Sub CommitAndRefreshChanges() Implements Domain.Base.IUnitWork.CommitAndRefreshChanges
   Dim saveFailed As Boolean = False
        Do
            Try
                MyBase.SaveChanges()
                Dim contextAux = CType(Me, IObjectContextAdapter).ObjectContext
                Dim itemsToRefresh As IEnumerable(Of Object) = contextAux.ObjectStateManager.GetObjectStateEntries(EntityState.Modified).Where(Function(ose) Not ose.IsRelationship AndAlso ose.Entity IsNot Nothing).[Select](Function(ose) ose.Entity)
                contextAux.Refresh(RefreshMode.StoreWins, itemsToRefresh)
                saveFailed = False
            Catch ex As DbUpdateConcurrencyException
                saveFailed = True
                ex.Entries.ToList().ForEach(Sub(entry)
                                                entry.OriginalValues.SetValues(entry.GetDatabaseValues())
                                            End Sub)
            End Try
        Loop While saveFailed
	 End Sub

