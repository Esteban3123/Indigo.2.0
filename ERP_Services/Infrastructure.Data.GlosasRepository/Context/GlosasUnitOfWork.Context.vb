	''' <summary>
    ''' Prueba de RollBack Para Comprobantes de Egreso
    ''' </summary>
    ''' <typeparam name="TEntity">Entidad</typeparam>
    ''' <returns></returns>
    ''' <remarks></remarks>
	Public Sub RollbackChangesUnitOfWork() Implements Domain.Base.IUnitWork.RollbackChangesUnitOfWork
        'Refresh context and override changes
        Dim itemsToRefresh As IEnumerable(Of Object) = CType(Me, IObjectContextAdapter).ObjectContext.ObjectStateManager.GetObjectStateEntries(EntityState.Modified).Where(Function(ose) Not ose.IsRelationship AndAlso ose.Entity IsNot Nothing).[Select](Function(ose) ose.Entity)
        For Each entry As DbEntityEntry In Me.ChangeTracker.Entries()
            Select Case entry.State
                Case EntityState.Modified
                    entry.State = EntityState.Unchanged
                Case EntityState.Added
                    entry.State = EntityState.Detached
                Case EntityState.Deleted
                    entry.Reload()
            End Select
        Next
		CType(Me, IObjectContextAdapter).ObjectContext.Refresh(RefreshMode.StoreWins, itemsToRefresh)
    End Sub

