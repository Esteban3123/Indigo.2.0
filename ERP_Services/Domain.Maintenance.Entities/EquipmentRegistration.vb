        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As ManualDetail In e.NewItems
                item.EquipmentRegistration = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("ManualDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As ManualDetail In e.OldItems
                If item.EquipmentRegistration Is Me Then
                    item.EquipmentRegistration = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("ManualDetail", item)
                End If
            Next
        End If
    End Sub

