    Private Sub FixupEquipmentFunction(ByVal previousValue As EquipmentFunction, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.EquipmentRegistration.Contains(Me) Then
            previousValue.EquipmentRegistration.Remove(Me)
        End If

        If EquipmentFunction IsNot Nothing Then
            EquipmentFunction.EquipmentRegistration.Add(Me)

            IdEquipmentFunction = EquipmentFunction.Id
        ElseIf Not skipKeys Then
            IdEquipmentFunction = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("EquipmentFunction") AndAlso
                ChangeTracker.OriginalValues("EquipmentFunction") Is EquipmentFunction Then
                ChangeTracker.OriginalValues.Remove("EquipmentFunction")
            Else
                ChangeTracker.RecordOriginalValue("EquipmentFunction", previousValue)
            End If
            If EquipmentFunction IsNot Nothing AndAlso Not EquipmentFunction.ChangeTracker.ChangeTrackingEnabled Then
                EquipmentFunction.StartTracking()
            End If
        End If
    End Sub

