<configuration>
  <connectionStrings>
    <!-- Desarrollo Indigo Azure -->
    <add name="CONX_GENESIS" connectionString="{0}data source=ssindigodev.database.windows.net;Initial Catalog={1};User ID=DbaIndigo;Password=%FY!4%k4p" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <add key="defaultIoCContainer" value="RealAppContext" />
    <add key="Auditoria" value="true" />
    <add key="PersistenciaMSMQ" value="true" />
    <add key="containerSecurity" value="INDIGOSEC" />
    <add key="Container" value=".\Private$\IndigoAuditoria" />
    <add key="FileManager_FileStoreFolder" value="D:\Store" />
    <add key="FileManager_FileExpirationTime" value="1800" />
    <add key="FileManager_TimeoutToUploadFiles" value="60" />
    <add key="FileManager_BufferSize" value="1048576" />
    <add key="_PathMessageStore_" value="C:\ProgramData\Indigo Technologies\MessageStore" />
    <add key="_PathElectronicDocuments_" value="C:\ProgramData\Indigo Technologies\ElectronicDocuments" />
  </appSettings>
  <system.web>
    <trust level="Full" />
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="true" />
  </system.webServer>
  <system.serviceModel>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
    <bindings>
      <basicHttpBinding>
        <binding name="basicHttpBinding" closeTimeout="01:00:00" openTimeout="01:00:00" receiveTimeout="01:00:00" sendTimeout="01:00:00" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647" transferMode="Streamed">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
        </binding>
      </basicHttpBinding>
      <basicHttpsBinding>
        <binding name="basicHttpsBinding" closeTimeout="01:00:00" openTimeout="01:00:00" receiveTimeout="01:00:00" sendTimeout="01:00:00" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647" transferMode="Streamed">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
        </binding>
      </basicHttpsBinding>
      <wsHttpBinding>
        <binding name="wsHttpBinding" maxReceivedMessageSize="2147483647">
          <security mode="None">
            <transport clientCredentialType="None" />
            <message clientCredentialType="None" negotiateServiceCredential="false" establishSecurityContext="false" />
          </security>
        </binding>
        <binding name="wsHttpsBinding" maxReceivedMessageSize="2147483647" bypassProxyOnLocal="true">
          <security mode="Transport">
            <transport clientCredentialType="None">
              <extendedProtectionPolicy policyEnforcement="Never" />
            </transport>
          </security>
        </binding>
      </wsHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="BehaviorWCF">
          <serviceMetadata httpGetEnabled="true" httpGetUrl="ServiceEntity/" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
        <behavior name="">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <protocolMapping>
      <add scheme="https" binding="basicHttpsBinding" />
    </protocolMapping>
    <services>
      <service behaviorConfiguration="BehaviorWCF" name="DistributedServices.Security.SecurityService">
        <endpoint address="basicHttpSecurityDefault" binding="basicHttpBinding" bindingConfiguration="basicHttpBinding" name="basicHttp_Endpoint_Security" contract="DistributedServices.Security.ISecurityService" listenUriMode="Explicit" />
        <endpoint address="basicHttpsSecurityDefault" binding="basicHttpsBinding" bindingConfiguration="basicHttpsBinding" name="basicHttps_Endpoint_Security" contract="DistributedServices.Security.ISecurityService" listenUriMode="Explicit" />
        <endpoint address="wsHttpSecurityDefault" binding="wsHttpBinding" bindingConfiguration="wsHttpBinding" name="wsHttp_Endpoint_Security" contract="DistributedServices.Security.ISecurityService" listenUriMode="Explicit" />
        <endpoint address="wsHttpsSecurityDefault" binding="wsHttpBinding" bindingConfiguration="wsHttpsBinding" name="wsHttps_Endpoint_Security" contract="DistributedServices.Security.ISecurityService" listenUriMode="Explicit" />
      </service>
      <service behaviorConfiguration="BehaviorWCF" name="DistributedServices.Crystal.CrystalService">
        <endpoint address="basicHttpsCrystal" binding="basicHttpsBinding" bindingConfiguration="basicHttpsBinding" name="basicHttps_Endpoint_Crystal" contract="DistributedServices.Crystal.ICrystalService" listenUriMode="Explicit" />
        <endpoint address="wsHttpCrystal" binding="wsHttpBinding" bindingConfiguration="wsHttpBinding" name="wsHttp_Endpoint_Crystal" contract="DistributedServices.Crystal.ICrystalService" listenUriMode="Explicit" />
      </service>
    </services>
  </system.serviceModel>
