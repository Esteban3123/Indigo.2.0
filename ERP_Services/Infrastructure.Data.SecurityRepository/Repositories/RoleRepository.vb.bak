#Region "Imports"
Imports Domain.Base
Imports Domain.Security.Entities
Imports Domain.Security
Imports Infrastructure.Data.Base
Imports Domain.Base.Entities
Imports System.Data.Entity

#End Region

''' <summary>
''' Esta clase Repositorio Grupo hereda del repositorio generico para poder obtener los metodos
''' comunes en todos los repositorios de manera que esta clase solo contiene los metodos y funciones no Comunes.
''' </summary>
Public Class RoleRepository
    Inherits GenericRepository(Of Roll)
    Implements IRoleRepository


    'Devuelve el contexto en este repositorio 
    Private _context As ISeguridadUnitOfWork

    ''' <summary>
    '''inicializa la neva instancia de <see cref="RoleRepository" /> clase.
    ''' </summary>
    ''' <param name="contex">el contexto.</param>
    Public Sub New(ByVal contex As ISeguridadUnitOfWork)
        MyBase.New(contex)
        _context = contex
    End Sub

    ''' <summary>
    ''' metodo que develve los valores originales de la entidad {T}
    ''' </summary>
    ''' <typeparam name="TEntidad">el tipo de la entidad.</typeparam>
    ''' <param name="entity">el objeto de la entidad.</param>
    ''' <returns></returns>
    Public Function GetSourceValues(Of TEntidad)(ByVal entity As TEntidad) As TEntidad
        Return IndigoContext.GetSourceValues(entity, CType(_context, DbContext))
    End Function

    ''' <summary>
    ''' Gets the permission rol by menu.	
    ''' </summary>
    ''' <param name="codeRole">The code role.</param>
    ''' <param name="codeMenu">The code menu.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetPermissionRolByMenu(codeRole As String, codeMenu As String) As List(Of PermissionRoll) Implements IRoleRepository.GetPermissionsRole
        Dim permissionRole = (From e In _context.PermissionRoll
                         Where e.IdRoll = CInt(codeRole) And e.IdForm = codeMenu
                          Select e).ToList()

        Return If(permissionRole IsNot Nothing AndAlso permissionRole.Count > 0, permissionRole, New List(Of PermissionRoll)())
    End Function

    ''' <summary>
    ''' Gets the permissions role.	
    ''' </summary>
    ''' <param name="codeRole">The code role.</param>
    ''' <param name="codeMenu">The code menu.</param>
    ''' <param name="authorized">The authorized.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetPermissionsRole(codeRole As String, codeMenu As String, authorized As Boolean) As List(Of PermissionRoll) Implements IRoleRepository.GetPermissionsRole
        Dim permissionRole = (From e In _context.PermissionRoll.Include("Roll")
                                 Where e.Roll.RollCode = codeRole And e.IdForm = codeMenu.Trim And e.ActionValue = authorized
                                 Select e).ToList()
        If permissionRole IsNot Nothing Then
            Return permissionRole.ToList
        Else
            Return New List(Of PermissionRoll)()
        End If
    End Function

    ''' <summary>
    ''' Obtiene el rol por Id.
    ''' </summary>
    ''' <param name="id">The id role.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetRoleId(id As Integer) As Roll Implements IRoleRepository.GetRoleId
        Dim res = (From e In _context.Roll.AsNoTracking() Where e.Id = id Select e).FirstOrDefault()
        If res IsNot Nothing Then
            Return res
        End If
        Return New Roll
    End Function

    ''' <summary>
    ''' Gets the role.	
    ''' </summary>
    ''' <param name="codeRole">The code role.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetRole(codeRole As String) As Roll Implements IRoleRepository.GetRole
        Dim res = (From e In _context.Roll.Include("PermissionRoll") Where e.RollCode = codeRole Select e).FirstOrDefault()
        If res IsNot Nothing Then
            Return res
        End If
        Return New Roll
    End Function

    ''' <summary>
    ''' obtiene un rol y sus permisos dependiendo del tag del formulario
    ''' </summary>
    ''' <param name="rolId"></param>
    ''' <param name="IdForm"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetRolByIdAndPermissionRollByIdForm(rolId As Integer, IdForm As String) As Roll Implements IRoleRepository.GetRolByIdAndPermissionRollByIdForm
        Dim res = (From r In _context.Roll Where r.Id = rolId Select r).FirstOrDefault()
        If res IsNot Nothing Then
            Dim permissionRoll = (From pr In _context.PermissionRoll Where pr.IdRoll = res.Id And pr.IdForm = IdForm Select pr).ToList()
            For Each permission In permissionRoll
                res.PermissionRoll.Add(permission)
            Next
            Return res
        Else
            Return New Roll
        End If
    End Function

    ''' <summary>
    ''' Lists the permissions rol.	
    ''' </summary>
    ''' <param name="codeRole">The code role.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function ListPermissionsRol(codeRole As String) As List(Of PermissionRoll) Implements IRoleRepository.GetPermissionsRole
        Dim permissionRole = (From e In _context.PermissionRoll
                         Where e.IdRoll = CInt(codeRole)
                          Select e).ToList()

        Return If(permissionRole IsNot Nothing AndAlso permissionRole.Count > 0, permissionRole, New List(Of PermissionRoll)())
    End Function

    ''' <summary>
    ''' Listar permisos por rol.	
    ''' </summary>
    ''' <param name="codeRole">El código del rol.</param>
    ''' <param name="authorized">autorizado.</param>
    ''' <returns>Lista de permisos por rol</returns>
    Public Function ListPermissionsRolAuthorized(codeRole As String, authorized As Boolean) As List(Of PermissionRoll) Implements IRoleRepository.ListPermissionsRolAuthorized

        Dim permissionRole = (From e In _context.PermissionRoll
                         Where e.IdRoll = CInt(codeRole) And e.ActionValue = authorized
                          Select e).ToList()

        Return If(permissionRole IsNot Nothing AndAlso permissionRole.Count > 0, permissionRole, New List(Of PermissionRoll)())

    End Function

    Public Function ListRolAll() As List(Of RolAll) Implements IRoleRepository.ListRolAll
        Dim Busqueda = From e In _context.Roll
                                           Select New RolAll With
                           {
     .RolCode = e.RollCode, .RolName = e.Description, .RolCodeName = e.RollCode + " - " + e.Description, .Auto = e.Id
                               }
        Return Busqueda.ToList
    End Function
End Class
