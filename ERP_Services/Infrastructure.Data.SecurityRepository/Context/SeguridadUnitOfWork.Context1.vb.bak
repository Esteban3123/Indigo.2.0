    ''' <summary>
    ''' Devuelve el objectSet de la entidad que le enviemos como parametro
    ''' </summary>
    ''' <typeparam name="TEntity">Entidad</typeparam>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetObjectSet(Of TEntity As {New, Class, IObjectWithChangeTracker})() As DbSet(Of TEntity) Implements Base.IQueryableContext.GetObjectSet
        Dim typeContext As Type = Me.GetType() 'Obtengo el tipo del contexto
        Dim typeModel As Type = GetType(TEntity) 'Obtengo el tipo de la entidad generica
        Dim properties As PropertyInfo() = typeContext.GetProperties() 'Obtengo las propiedades publicas
        For Each propertyInfo As PropertyInfo In properties
            If propertyInfo.Name = typeModel.Name Then
                Dim objectSet As DbSet(Of TEntity) = CType(propertyInfo.GetValue(Me), DbSet(Of TEntity))
                Return objectSet
            End If
        Next
        Throw New EntityException("La Propiedad " & typeModel.Name & " no existe en el contexto " & typeContext.Name)
    End Function

