        da.SelectCommand.CommandTimeout = 90
        Dim ds As New DataSet
        da.Fill(ds, "NULL")
        dtDatos = ds.Tables("NULL")
        conexion.Close()
        Return ds
    End Function

    Public Sub RegisterChanges(Of TEntity As {Class, Domain.Base.Entities.IObjectWithChangeTracker})(item As TEntity) Implements Domain.Base.IUnitWork.RegisterChanges
        Me.Set(Of TEntity)().ApplyChanges(item)
    End Sub

    Public Sub RollbackChanges() Implements Domain.Base.IUnitWork.RollbackChanges
        'Refresh context and override changes
        Dim itemsToRefresh As IEnumerable(Of Object) = CType(Me, IObjectContextAdapter).ObjectContext.ObjectStateManager.GetObjectStateEntries(EntityState.Modified).Where(Function(ose) Not ose.IsRelationship AndAlso ose.Entity IsNot Nothing).[Select](Function(ose) ose.Entity)
        CType(Me, IObjectContextAdapter).ObjectContext.Refresh(RefreshMode.StoreWins, itemsToRefresh)
    End Sub

    ''' <summary>
    ''' Prueba de RollBack Para Comprobantes de Egreso
    ''' </summary>
    ''' <typeparam name="TEntity">Entidad</typeparam>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Sub RollbackChangesUnitOfWork() Implements Domain.Base.IUnitWork.RollbackChangesUnitOfWork
        'Refresh context and override changes
        Dim itemsToRefresh As IEnumerable(Of Object) = CType(Me, IObjectContextAdapter).ObjectContext.ObjectStateManager.GetObjectStateEntries(EntityState.Modified).Where(Function(ose) Not ose.IsRelationship AndAlso ose.Entity IsNot Nothing).[Select](Function(ose) ose.Entity)
        For Each entry As DbEntityEntry In Me.ChangeTracker.Entries()
            Select Case entry.State
                Case EntityState.Modified
                    entry.State = EntityState.Unchanged
                Case EntityState.Added
                    entry.State = EntityState.Detached
                Case EntityState.Deleted
                    entry.Reload()
            End Select
        Next
        CType(Me, IObjectContextAdapter).ObjectContext.Refresh(RefreshMode.StoreWins, itemsToRefresh)
    End Sub

    Public Function CreateEntityObjectSet(Of TEntity As {New, Class, Domain.Base.Entities.IObjectWithChangeTracker})() As IDbSet(Of TEntity) Implements Base.IQueryableContext.CreateEntityObjectSet
        Return TryCast(Me.Set(Of TEntity)(), IDbSet(Of TEntity))
    End Function

    ''' <summary>
    ''' Devuelve el objectSet de la entidad que le enviemos como parametro
    ''' </summary>
    ''' <typeparam name="TEntity">Entidad</typeparam>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function GetObjectSet(Of TEntity As {New, Class, IObjectWithChangeTracker})() As DbSet(Of TEntity) Implements Base.IQueryableContext.GetObjectSet
        Dim typeContext As Type = Me.GetType() 'Obtengo el tipo del contexto
        Dim typeModel As Type = GetType(TEntity) 'Obtengo el tipo de la entidad generica
        Dim properties As PropertyInfo() = typeContext.GetProperties() 'Obtengo las propiedades publicas
        For Each propertyInfo As PropertyInfo In properties
            If propertyInfo.Name = typeModel.Name Then
                Dim objectSet As DbSet(Of TEntity) = CType(propertyInfo.GetValue(Me), DbSet(Of TEntity))
                Return objectSet
            End If
        Next
        Throw New EntityException("La Propiedad " & typeModel.Name & " no existe en el contexto " & typeContext.Name)
    End Function

    Public Sub RollbackAllChanges() Implements IUnitWork.RollbackAllChanges
        Dim itemsToRefresh As IEnumerable(Of Object) = CType(Me, IObjectContextAdapter).ObjectContext _
            .ObjectStateManager.GetObjectStateEntries(EntityState.Added Or EntityState.Deleted _
            Or EntityState.Detached Or EntityState.Modified Or EntityState.Unchanged) _
            .Where(Function(ose) Not ose.IsRelationship AndAlso ose.Entity IsNot Nothing).[Select](Function(ose) ose.Entity)
        CType(Me, IObjectContextAdapter).ObjectContext.Refresh(RefreshMode.StoreWins, itemsToRefresh)
    End Sub
