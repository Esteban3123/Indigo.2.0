  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true"/>
    <add key="defaultIoCContainer" value="RealAppContext"/>
    <add key="Auditoria" value="true"/>
    <add key="UserImpersonation" value="CDq/BrdOwLvocPb5cvx0JA=="/>
    <add key="PwdImpersonation" value="v3+BCe1Xt1vGFSqF/FxO7g=="/>
    <add key="DomainImpersonation" value="7TuXwqgA+JCN9HTzFvlVUA=="/>
    <add key="PersistenciaMSMQ" value="true"/>
