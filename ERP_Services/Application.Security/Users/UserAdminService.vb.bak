    ''' <summary>
    ''' Guarda una permiso de usuario
    ''' </summary>
    ''' <param name="permissionUser"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function SavePermissionUser(permissionCompany As Company, session As SessionValues) As Boolean Implements IUserAdminService.SavePermissionUser
        Try
            Dim conx As New ConectionSQL(ConfigurationManager.AppSettings(Infrastructure.CrossCutting.Base.ConfigurationFile.SECURITY_CONTAINER_PARAMETER_NAME))
            conx.ExecuteCommand("update Security.PermissionCompany set IdOperatingUnitDefault = " & permissionCompany.IdOperatingUnitDefault & " where IdContainer in (select Id from Security.Containers where Code = '" & permissionCompany.Code & "' ) and IdUser = " & session.UserIndigoId)
            Return True
        Catch ex As Exception
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return False
        End Try
    End Function

