    ''' <summary>
    ''' Desbloquea un usuario
    ''' </summary>
    ''' <param name="codeUser">The code user.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function UnlockUser(codeUser As String) As Boolean Implements IUserAdminService.UnlockUser
        If String.IsNullOrEmpty(codeUser) = True Then
            Throw New ArgumentNullException("codeUser Vacio")
        End If
        Try
            'Desbloqueo el usuario en membership
            Dim user = _userRepository.GetUserObjectOnly(codeUser)
            user.IsLockedOut = False
            user.FailedPasswordCount = 0
            _userRepository.SaveEntity(user)
            _userRepository.UnitWork.Commit()
            Return True
            'desbloqueo todos los registros
        Catch ex As Exception
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return Nothing
        End Try
    End Function

    ''' <summary>
    ''' Updates the user.	
    ''' </summary>
    ''' <param name="user">The user.</param>
    ''' <param name="audit">The audit.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function UpdateUser(user As User, audit As AuditMessage) As Boolean Implements IUserAdminService.UpdateUser
        If user Is Nothing Then
            Throw New ArgumentNullException("user Vacio")
        End If
        'creo la unidad de trabajo
        Dim unitOfWork As IUnitWork = TryCast(_userRepository.UnitWork, IUnitWork)
        Try
            'configuro la transaccion
            Dim txSettings As New TransactionOptions()
            txSettings.Timeout = TransactionManager.DefaultTimeout
            txSettings.IsolationLevel = IsolationLevel.ReadCommitted
            'inicio la transaccion
            Using scope As New TransactionScope(TransactionScopeOption.Required, txSettings)
                'modifico el usuario
                _userRepository.UpdateEntity(user)
                'acepto los cambios
                unitOfWork.CommitAndRefreshChanges()
                'confirmo la transaccion
                scope.Complete()
            End Using
            Return True
        Catch ex As Exception
            unitOfWork.RollbackChanges()
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return False
        End Try
    End Function


