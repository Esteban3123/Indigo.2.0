    ''' <summary>
    ''' Funcion para guardar archivo de usaurio
    ''' </summary>
    ''' <param name="_ArchivosProfesionales"></param>
    ''' <param name="audit"></param>
    Public Function SaveFileUserRepository(_ArchivosProfesionales As FilePerson, audit As AuditMessage) As Boolean Implements IUserAdminService.SaveFileUserRepository
        If _ArchivosProfesionales Is Nothing Then
            Throw New ArgumentNullException("Archivo Vacio")
        End If
        'creo la unidad de trabajo
        Dim unitOfWork As IUnitWork = TryCast(_FileUserRepository.UnitWork, IUnitWork)
        Try
            'configuro la transaccion
            Dim txSettings As New TransactionOptions()
            txSettings.Timeout = TransactionManager.DefaultTimeout
            txSettings.IsolationLevel = IsolationLevel.ReadCommitted
            'inicio la transaccion
            Using scope As New TransactionScope(TransactionScopeOption.Required, txSettings)
                'determino si el registro en nuevo o modificado

                'valido que ela persona no tenga ya archivo
                Dim _tmpArchivo As FilePerson
                _tmpArchivo = _FileUserRepository.getFileUser(_ArchivosProfesionales.IdPerson)
                If _tmpArchivo.IdPerson > 0 Then
                    _tmpArchivo.Photo = _ArchivosProfesionales.Photo
                    _FileUserRepository.UpdateEntity(_tmpArchivo)
                Else
                    'grabo
                    _FileUserRepository.AddEntity(_ArchivosProfesionales)
                End If

                'acepto los cambios
                unitOfWork.CommitAndRefreshChanges()
                'confirmo la transaccion
                scope.Complete()
            End Using
            Return True
        Catch ex As Exception
            unitOfWork.RollbackChanges()
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return False
        End Try
    End Function

    ''' <summary>
    ''' Funcion para cambiar el modo de visuzalizacion de los frontales
    ''' True=Busqueda
    ''' False=Edicion
    ''' </summary>
    ''' <param name="ViewMode"></param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function ChangeUserViewMode(UserCode As String, ViewMode As Boolean) As Boolean Implements IUserAdminService.ChangeUserViewMode
        If String.IsNullOrEmpty(UserCode) = True Then
            Throw New ArgumentNullException("User Code Empty")
        End If
        If String.IsNullOrEmpty(ViewMode) = True Then
            Throw New ArgumentNullException("View Mode Empty")
        End If
        'creo la unidad de trabajo
        Dim unitOfWork As IUnitWork = TryCast(_userRepository.UnitWork, IUnitWork)
        Try
            Dim User As User = _userRepository.GetUserObjectOnly(UserCode)
            User.ViewForm = ViewMode
            'modifico el usuario
            _userRepository.SaveEntity(User)
            'acepto los cambios
            unitOfWork.CommitAndRefreshChanges()
            Return True
        Catch ex As Exception
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return False
        End Try
    End Function

