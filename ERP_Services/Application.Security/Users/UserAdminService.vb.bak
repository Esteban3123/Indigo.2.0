''' <summary>
''' Clase con todos los metodos tanto tecnicos como de negocio
''' para tratar la entidad usuarios
''' </summary>
Public Class UserAdminService
    Implements IUserAdminService

    Dim _userRepository As IUserRepository
    Dim _FileUserRepository As IFileUserRepository
    Dim _userMembershipRepository As IUserMembershipRepository
    Dim _permissionCompanyRepository As IPermissionCompanyRepository
    Dim _sEGusuaruRepository As ISEGusuaruRepository
    Dim _ADCENATENRepository As IADCENATENRepository
    Dim _INUNIFUNCRepository As IINUNIFUNCRepository
    Dim _INCUPSSUBRepository As IINCUPSSUBRepository

    ''' <summary>
    ''' Initializa una nueva instancia de la clase <see cref="UserAdminService" />.
    ''' </summary>
    ''' <param name="userRepository">el repositorio para el manejo de los usuarios.</param>
    ''' <param name="userMembershipRepository">el repositorio para el manejo de usuario por medio de membership.</param>
    Public Sub New(ByVal userRepository As IUserRepository, ByVal userMembershipRepository As IUserMembershipRepository, ByVal FileUserRepository As IFileUserRepository,
                    permissionCompanyRepository As IPermissionCompanyRepository, sEGusuaruRepository As ISEGusuaruRepository, ADCENATENRepository As IADCENATENRepository,
                    INUNIFUNCRepository As IINUNIFUNCRepository, INCUPSSUBRepository As IINCUPSSUBRepository)
        If userRepository Is Nothing Then
            Throw New ArgumentNullException("userRepository Vacio")
        End If
        If userMembershipRepository Is Nothing Then
            Throw New ArgumentNullException("userMembershipRepository Vacio")
        End If
        If FileUserRepository Is Nothing Then
            Throw New ArgumentNullException("FileuserRepository Vacio")
        End If

        _userRepository = userRepository
        _userMembershipRepository = userMembershipRepository
        _FileUserRepository = FileUserRepository
        _permissionCompanyRepository = permissionCompanyRepository
        _sEGusuaruRepository = sEGusuaruRepository
        _ADCENATENRepository = ADCENATENRepository
        _INUNIFUNCRepository = INUNIFUNCRepository
        _INCUPSSUBRepository = INCUPSSUBRepository
    End Sub


    ''' <summary>
    ''' Changes the password.	
    ''' </summary>
    ''' <param name="codeUser">se envia id de usario.</param>
    ''' <param name="lastPasswd">The last passwd.</param>
    ''' <param name="newPasswd">The new passwd.</param>
    ''' <returns></returns>
    ''' <remarks></remarks>
    Public Function ChangePassword(codeUser As String, lastPasswd As String, newPasswd As String) As Boolean Implements IUserAdminService.ChangePassword
        If String.IsNullOrEmpty(codeUser) = True Then
            Throw New ArgumentNullException("codeUser Vacio")
        End If
        If String.IsNullOrEmpty(lastPasswd) = True Then
            Throw New ArgumentNullException("lastPasswd Vacio")
        End If
        If String.IsNullOrEmpty(newPasswd) = True Then
            Throw New ArgumentNullException("newPasswd Vacio")
        End If
        'creo la unidad de trabajo
        Dim unitWorkUser As IUnitWork = TryCast(_userRepository.UnitWork, IUnitWork)
        Try
            'configuro la transaccion
            Dim txSettings As New TransactionOptions()
            txSettings.Timeout = TransactionManager.DefaultTimeout
            txSettings.IsolationLevel = IsolationLevel.ReadCommitted
            Dim usuario = _userRepository.GetUserById(codeUser)
            'inicio la transaccion
            Using scope As New TransactionScope(TransactionScopeOption.Required, txSettings)
                'cambio la contraseña de usuarios ERP
                _userRepository.ChangePassword(codeUser, IndigoRijndael.Encrypt(newPasswd))
                'acepto los cambios
                unitWorkUser.CommitAndRefreshChanges()

                'cambio la contraseña de usuarios EHR
                _sEGusuaruRepository.ChangePassword(usuario.UserCode, IndigoEncriptar.EncriptarPassword(newPasswd))
                'acepto los cambios
                _sEGusuaruRepository.UnitWork.Commit()

                'confirmo la transaccion
                scope.Complete()
            End Using
            Return True
        Catch ex As Exception
            'devuelvo cambios usuario
            unitWorkUser.RollbackChanges()
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return False
        End Try
    End Function

