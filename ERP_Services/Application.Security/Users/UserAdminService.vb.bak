    Public Function GetPermissionUserByUserId(userId As Integer) As List(Of PermissionUser) Implements IUserAdminService.GetPermissionUserByUserId
        Try
            Return _userRepository.GetPermissionUserByUserId(userId)
        Catch ex As Exception
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return Nothing
        End Try
    End Function

