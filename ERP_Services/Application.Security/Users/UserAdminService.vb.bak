    Public Function UpdateStatusUser(Code As String, Status As Boolean) As Boolean Implements IUserAdminService.UpdateStatusUser
        Try
            Dim user = GetUser(Code, "")
            user.State = If(Status = True, True, False)
            Return UpdateUser(user, Nothing)

        Catch ex As Exception
            IndigoManagementExceptions.HandleException(ex, "ApplicationPolicy")
            Return False
        End Try
    End Function

