          <EntitySet Name="EmployeeScheduleDetail" EntityType="Self.EmployeeScheduleDetail" store:Type="Tables" store:Schema="Payroll">
            <DefiningQuery>SELECT 
    [EmployeeScheduleDetail].[Id] AS [Id], 
    [EmployeeScheduleDetail].[IdEmployeeScheduleC] AS [IdEmployeeScheduleC], 
    [EmployeeScheduleDetail].[EmployeeId] AS [EmployeeId], 
    [EmployeeScheduleDetail].[InitialContractNumber] AS [InitialContractNumber], 
    [EmployeeScheduleDetail].[ContractId] AS [ContractId], 
    [EmployeeScheduleDetail].[InitialDate] AS [InitialDate], 
    [EmployeeScheduleDetail].[InitialHourDate] AS [InitialHourDate], 
    [EmployeeScheduleDetail].[EndDate] AS [EndDate], 
    [EmployeeScheduleDetail].[EndHourDate] AS [EndHourDate], 
    [EmployeeScheduleDetail].[Hours] AS [Hours], 
    [EmployeeScheduleDetail].[CreationUser] AS [CreationUser], 
    [EmployeeScheduleDetail].[CreationDate] AS [CreationDate]
    FROM [Payroll].[EmployeeScheduleDetail] AS [EmployeeScheduleDetail]</DefiningQuery>
