<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
  </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
  <connectionStrings>
    <add name="Futesh" connectionString="Server=192.168.10.76; User Id=sa; Password=sa"/>
    <add name="CONX_GENESIS" connectionString="{0}data source=192.168.10.15;Initial Catalog={1};User ID=genesis;Password=123" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="Interval" value="5"/>
    <!--==============Contenedor de Seguridad=========================-->
    <add key="containerSecurity" value="VIESECURITY"/>
    <!--==============================================================-->
    <!--Debugging-->
    <add key="Debug" value="False"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
  </appSettings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="v11.0"/>
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer"/>
    </providers>
  </entityFramework>
</configuration>
