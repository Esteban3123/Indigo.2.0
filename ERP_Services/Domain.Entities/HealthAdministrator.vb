    Private Sub FixupThirdParty(ByVal previousValue As ThirdParty)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.HealthAdministrator.Contains(Me) Then
            previousValue.HealthAdministrator.Remove(Me)
        End If

        If ThirdParty IsNot Nothing Then
            ThirdParty.HealthAdministrator.Add(Me)

            ThirdPartyId = ThirdParty.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ThirdParty") AndAlso
                ChangeTracker.OriginalValues("ThirdParty") Is ThirdParty Then
                ChangeTracker.OriginalValues.Remove("ThirdParty")
            Else
                ChangeTracker.RecordOriginalValue("ThirdParty", previousValue)
            End If
            If ThirdParty IsNot Nothing AndAlso Not ThirdParty.ChangeTracker.ChangeTrackingEnabled Then
                ThirdParty.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupPortfolioDeteriorationClassification(ByVal previousValue As PortfolioDeteriorationClassification, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.HealthAdministrator.Contains(Me) Then
            previousValue.HealthAdministrator.Remove(Me)
        End If

        If PortfolioDeteriorationClassification IsNot Nothing Then
            PortfolioDeteriorationClassification.HealthAdministrator.Add(Me)

            PortfolioDeteriorationClassificationId = PortfolioDeteriorationClassification.Id
        ElseIf Not skipKeys Then
            PortfolioDeteriorationClassificationId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("PortfolioDeteriorationClassification") AndAlso
                ChangeTracker.OriginalValues("PortfolioDeteriorationClassification") Is PortfolioDeteriorationClassification Then
                ChangeTracker.OriginalValues.Remove("PortfolioDeteriorationClassification")
            Else
                ChangeTracker.RecordOriginalValue("PortfolioDeteriorationClassification", previousValue)
            End If
            If PortfolioDeteriorationClassification IsNot Nothing AndAlso Not PortfolioDeteriorationClassification.ChangeTracker.ChangeTrackingEnabled Then
                PortfolioDeteriorationClassification.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupInvoice(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As Invoice In e.NewItems
                item.HealthAdministrator = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("Invoice", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As Invoice In e.OldItems
                If item.HealthAdministrator Is Me Then
                    item.HealthAdministrator = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("Invoice", item)
                End If
            Next
        End If
    End Sub

