    Private Sub FixupSettingFixedAssetByLegalBook(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As SettingFixedAssetByLegalBook In e.NewItems
                item.SettingFixedAsset = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("SettingFixedAssetByLegalBook", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As SettingFixedAssetByLegalBook In e.OldItems
                If item.SettingFixedAsset Is Me Then
                    item.SettingFixedAsset = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("SettingFixedAssetByLegalBook", item)
                End If
            Next
        End If
    End Sub

