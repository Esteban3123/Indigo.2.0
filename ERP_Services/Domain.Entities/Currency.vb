    Private Sub FixupISO4217(ByVal previousValue As ISO4217)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Currency.Contains(Me) Then
            previousValue.Currency.Remove(Me)
        End If

        If ISO4217 IsNot Nothing Then
            ISO4217.Currency.Add(Me)

            ISO4217Id = ISO4217.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ISO4217") AndAlso
                ChangeTracker.OriginalValues("ISO4217") Is ISO4217 Then
                ChangeTracker.OriginalValues.Remove("ISO4217")
            Else
                ChangeTracker.RecordOriginalValue("ISO4217", previousValue)
            End If
            If ISO4217 IsNot Nothing AndAlso Not ISO4217.ChangeTracker.ChangeTrackingEnabled Then
                ISO4217.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupCompanySettings(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As CompanySettings In e.NewItems
                item.Currency = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("CompanySettings", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As CompanySettings In e.OldItems
                If item.Currency Is Me Then
                    item.Currency = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("CompanySettings", item)
                End If
            Next
        End If
    End Sub

