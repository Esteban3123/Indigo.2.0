#Region "Association Fixup"

    Private Sub FixupSuppliersDistributionLines(ByVal previousValue As SuppliersDistributionLines)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.InventoryContract.Contains(Me) Then
            previousValue.InventoryContract.Remove(Me)
        End If

        If SuppliersDistributionLines IsNot Nothing Then
            SuppliersDistributionLines.InventoryContract.Add(Me)

            SupplierDistributionLineId = SuppliersDistributionLines.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("SuppliersDistributionLines") AndAlso
                ChangeTracker.OriginalValues("SuppliersDistributionLines") Is SuppliersDistributionLines Then
                ChangeTracker.OriginalValues.Remove("SuppliersDistributionLines")
            Else
                ChangeTracker.RecordOriginalValue("SuppliersDistributionLines", previousValue)
            End If
            If SuppliersDistributionLines IsNot Nothing AndAlso Not SuppliersDistributionLines.ChangeTracker.ChangeTrackingEnabled Then
                SuppliersDistributionLines.StartTracking()
            End If
        End If
    End Sub

