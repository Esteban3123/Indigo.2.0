                    Throw New InvalidOperationException("Cannot set the FixupChangeTrackingCollection when ChangeTracking is enabled")
                End If
                If _inventoryContractModification IsNot Nothing Then
                    RemoveHandler _inventoryContractModification.CollectionChanged, AddressOf FixupInventoryContractModification
                End If
                _inventoryContractModification = value
                If _inventoryContractModification IsNot Nothing Then
                    AddHandler _inventoryContractModification.CollectionChanged, AddressOf FixupInventoryContractModification
                End If
                OnNavigationPropertyChanged("InventoryContractModification")
            End If
        End Set
