            If ChangeTracker.OriginalValues.ContainsKey("ThirdParty") AndAlso
                ChangeTracker.OriginalValues("ThirdParty") Is ThirdParty Then
                ChangeTracker.OriginalValues.Remove("ThirdParty")
            Else
                ChangeTracker.RecordOriginalValue("ThirdParty", previousValue)
            End If
            If ThirdParty IsNot Nothing AndAlso Not ThirdParty.ChangeTracker.ChangeTrackingEnabled Then
                ThirdParty.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupServiceOrderDetail(ByVal previousValue As ServiceOrderDetail)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.MedicalFeesCausation.Contains(Me) Then
            previousValue.MedicalFeesCausation.Remove(Me)
        End If

        If ServiceOrderDetail IsNot Nothing Then
            ServiceOrderDetail.MedicalFeesCausation.Add(Me)

            ServiceOrderDetailId = ServiceOrderDetail.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ServiceOrderDetail") AndAlso
                ChangeTracker.OriginalValues("ServiceOrderDetail") Is ServiceOrderDetail Then
                ChangeTracker.OriginalValues.Remove("ServiceOrderDetail")
            Else
                ChangeTracker.RecordOriginalValue("ServiceOrderDetail", previousValue)
            End If
            If ServiceOrderDetail IsNot Nothing AndAlso Not ServiceOrderDetail.ChangeTracker.ChangeTrackingEnabled Then
                ServiceOrderDetail.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupMedicalFeesLiquidationDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As MedicalFeesLiquidationDetail In e.NewItems
                item.MedicalFeesCausation = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("MedicalFeesLiquidationDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As MedicalFeesLiquidationDetail In e.OldItems
                If item.MedicalFeesCausation Is Me Then
                    item.MedicalFeesCausation = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("MedicalFeesLiquidationDetail", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

