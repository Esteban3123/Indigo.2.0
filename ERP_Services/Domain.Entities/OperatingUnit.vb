#Region "Association Fixup"

    Private Sub FixupOperatingUnit2(ByVal previousValue As OperatingUnit, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.OperatingUnit1.Contains(Me) Then
            previousValue.OperatingUnit1.Remove(Me)
        End If

        If OperatingUnit2 IsNot Nothing Then
            OperatingUnit2.OperatingUnit1.Add(Me)

            IdUnit = OperatingUnit2.Id
        ElseIf Not skipKeys Then
            IdUnit = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("OperatingUnit2") AndAlso
                ChangeTracker.OriginalValues("OperatingUnit2") Is OperatingUnit2 Then
                ChangeTracker.OriginalValues.Remove("OperatingUnit2")
            Else
                ChangeTracker.RecordOriginalValue("OperatingUnit2", previousValue)
            End If
            If OperatingUnit2 IsNot Nothing AndAlso Not OperatingUnit2.ChangeTracker.ChangeTrackingEnabled Then
                OperatingUnit2.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupCity(ByVal previousValue As City, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.OperatingUnit.Contains(Me) Then
            previousValue.OperatingUnit.Remove(Me)
        End If

        If City IsNot Nothing Then
            City.OperatingUnit.Add(Me)

            IdCity = City.Id
        ElseIf Not skipKeys Then
            IdCity = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("City") AndAlso
                ChangeTracker.OriginalValues("City") Is City Then
                ChangeTracker.OriginalValues.Remove("City")
            Else
                ChangeTracker.RecordOriginalValue("City", previousValue)
            End If
            If City IsNot Nothing AndAlso Not City.ChangeTracker.ChangeTrackingEnabled Then
                City.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupBillingSequenceDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As BillingSequenceDetail In e.NewItems
                item.OperatingUnit = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("BillingSequenceDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As BillingSequenceDetail In e.OldItems
                If item.OperatingUnit Is Me Then
                    item.OperatingUnit = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("BillingSequenceDetail", item)
                End If
            Next
        End If
    End Sub

    Private Sub FixupBudgetSequenceDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As BudgetSequenceDetail In e.NewItems
                item.OperatingUnit = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("BudgetSequenceDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As BudgetSequenceDetail In e.OldItems
