                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("TransferOrderDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As TransferOrderDetail In e.OldItems
                If item.TransferOrder Is Me Then
                    item.TransferOrder = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("TransferOrderDetail", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

