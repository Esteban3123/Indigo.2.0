    Private Sub FixupBudgetaryEntity1(ByVal previousValue As BudgetaryEntity)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.BudgetaryValidity1.Contains(Me) Then
            previousValue.BudgetaryValidity1.Remove(Me)
        End If

        If BudgetaryEntity1 IsNot Nothing Then
            BudgetaryEntity1.BudgetaryValidity1.Add(Me)

            BudgetaryEntityId = BudgetaryEntity1.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("BudgetaryEntity1") AndAlso
                ChangeTracker.OriginalValues("BudgetaryEntity1") Is BudgetaryEntity1 Then
                ChangeTracker.OriginalValues.Remove("BudgetaryEntity1")
            Else
                ChangeTracker.RecordOriginalValue("BudgetaryEntity1", previousValue)
            End If
            If BudgetaryEntity1 IsNot Nothing AndAlso Not BudgetaryEntity1.ChangeTracker.ChangeTrackingEnabled Then
                BudgetaryEntity1.StartTracking()
            End If
        End If
    End Sub

