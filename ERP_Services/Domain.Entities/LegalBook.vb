    Private Sub FixupCurrency(ByVal previousValue As Currency)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.LegalBook.Contains(Me) Then
            previousValue.LegalBook.Remove(Me)
        End If

        If Currency IsNot Nothing Then
            Currency.LegalBook.Add(Me)

            OfficialCurrencyId = Currency.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Currency") AndAlso
                ChangeTracker.OriginalValues("Currency") Is Currency Then
                ChangeTracker.OriginalValues.Remove("Currency")
            Else
                ChangeTracker.RecordOriginalValue("Currency", previousValue)
            End If
            If Currency IsNot Nothing AndAlso Not Currency.ChangeTracker.ChangeTrackingEnabled Then
                Currency.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupFixedAssetPhysicalAssetDetailBook(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As FixedAssetPhysicalAssetDetailBook In e.NewItems
                item.LegalBook = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("FixedAssetPhysicalAssetDetailBook", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As FixedAssetPhysicalAssetDetailBook In e.OldItems
                If item.LegalBook Is Me Then
                    item.LegalBook = Nothing
