                    ChangeTracker.RecordAdditionToCollectionProperties("PortfolioProvisionDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PortfolioProvisionDetail In e.OldItems
                If item.LegalBook Is Me Then
                    item.LegalBook = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("PortfolioProvisionDetail", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

