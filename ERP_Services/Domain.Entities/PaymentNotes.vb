    Private Sub FixupAccountPayable(ByVal previousValue As AccountPayable, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.PaymentNotes.Contains(Me) Then
            previousValue.PaymentNotes.Remove(Me)
        End If

        If AccountPayable IsNot Nothing Then
            AccountPayable.PaymentNotes.Add(Me)

            IdAccountPayable = AccountPayable.Id
        ElseIf Not skipKeys Then
            IdAccountPayable = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("AccountPayable") AndAlso
                ChangeTracker.OriginalValues("AccountPayable") Is AccountPayable Then
                ChangeTracker.OriginalValues.Remove("AccountPayable")
            Else
                ChangeTracker.RecordOriginalValue("AccountPayable", previousValue)
            End If
            If AccountPayable IsNot Nothing AndAlso Not AccountPayable.ChangeTracker.ChangeTrackingEnabled Then
                AccountPayable.StartTracking()
            End If
        End If
    End Sub

