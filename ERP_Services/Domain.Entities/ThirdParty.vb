#Region "Association Fixup"

    Private Sub FixupEconomicActivity(ByVal previousValue As EconomicActivity, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.ThirdParty.Contains(Me) Then
            previousValue.ThirdParty.Remove(Me)
        End If

        If EconomicActivity IsNot Nothing Then
            EconomicActivity.ThirdParty.Add(Me)

            EconomicActivityId = EconomicActivity.Id
        ElseIf Not skipKeys Then
            EconomicActivityId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("EconomicActivity") AndAlso
                ChangeTracker.OriginalValues("EconomicActivity") Is EconomicActivity Then
                ChangeTracker.OriginalValues.Remove("EconomicActivity")
            Else
                ChangeTracker.RecordOriginalValue("EconomicActivity", previousValue)
            End If
            If EconomicActivity IsNot Nothing AndAlso Not EconomicActivity.ChangeTracker.ChangeTrackingEnabled Then
                EconomicActivity.StartTracking()
            End If
        End If
    End Sub

