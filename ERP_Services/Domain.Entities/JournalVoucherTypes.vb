    Private Sub FixupGeneralLedgerSettings(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As GeneralLedgerSettings In e.NewItems
                item.JournalVoucherTypes = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("GeneralLedgerSettings", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As GeneralLedgerSettings In e.OldItems
                If item.JournalVoucherTypes Is Me Then
                    item.JournalVoucherTypes = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("GeneralLedgerSettings", item)
                End If
            Next
        End If
    End Sub

