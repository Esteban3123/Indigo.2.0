    Private Sub FixupInvoice(ByVal previousValue As Invoice, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.AccountReceivable.Contains(Me) Then
            previousValue.AccountReceivable.Remove(Me)
        End If

        If Invoice IsNot Nothing Then
            Invoice.AccountReceivable.Add(Me)

            InvoiceId = Invoice.Id
        ElseIf Not skipKeys Then
            InvoiceId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Invoice") AndAlso
                ChangeTracker.OriginalValues("Invoice") Is Invoice Then
                ChangeTracker.OriginalValues.Remove("Invoice")
            Else
                ChangeTracker.RecordOriginalValue("Invoice", previousValue)
            End If
            If Invoice IsNot Nothing AndAlso Not Invoice.ChangeTracker.ChangeTrackingEnabled Then
                Invoice.StartTracking()
            End If
        End If
    End Sub

