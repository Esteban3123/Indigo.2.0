    Private Sub FixupCommitmentDetail(ByVal previousValue As CommitmentDetail, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.AccountPayable.Contains(Me) Then
            previousValue.AccountPayable.Remove(Me)
        End If

        If CommitmentDetail IsNot Nothing Then
            CommitmentDetail.AccountPayable.Add(Me)

            CommitmentDetailId = CommitmentDetail.Id
        ElseIf Not skipKeys Then
            CommitmentDetailId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("CommitmentDetail") AndAlso
                ChangeTracker.OriginalValues("CommitmentDetail") Is CommitmentDetail Then
                ChangeTracker.OriginalValues.Remove("CommitmentDetail")
            Else
                ChangeTracker.RecordOriginalValue("CommitmentDetail", previousValue)
            End If
            If CommitmentDetail IsNot Nothing AndAlso Not CommitmentDetail.ChangeTracker.ChangeTrackingEnabled Then
                CommitmentDetail.StartTracking()
            End If
        End If
    End Sub

