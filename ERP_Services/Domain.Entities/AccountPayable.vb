    Private Sub FixupAccountPayableNumberingAuthorization(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As AccountPayableNumberingAuthorization In e.NewItems
                item.AccountPayable = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("AccountPayableNumberingAuthorization", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As AccountPayableNumberingAuthorization In e.OldItems
                If item.AccountPayable Is Me Then
                    item.AccountPayable = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("AccountPayableNumberingAuthorization", item)
                End If
            Next
        End If
    End Sub

