    Private Sub FixupIPSService2(ByVal previousValue As IPSService, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.IPSService1.Contains(Me) Then
            previousValue.IPSService1.Remove(Me)
        End If

        If IPSService2 IsNot Nothing Then
            IPSService2.IPSService1.Add(Me)

            AssociatedMaterialIPSServiceId = IPSService2.Id
        ElseIf Not skipKeys Then
            AssociatedMaterialIPSServiceId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("IPSService2") AndAlso
                ChangeTracker.OriginalValues("IPSService2") Is IPSService2 Then
                ChangeTracker.OriginalValues.Remove("IPSService2")
            Else
                ChangeTracker.RecordOriginalValue("IPSService2", previousValue)
            End If
            If IPSService2 IsNot Nothing AndAlso Not IPSService2.ChangeTracker.ChangeTrackingEnabled Then
                IPSService2.StartTracking()
            End If
        End If
    End Sub

