    Private Sub FixupFinancialSource(ByVal previousValue As FinancialSource, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.EntityBankAccounts.Contains(Me) Then
            previousValue.EntityBankAccounts.Remove(Me)
        End If

        If FinancialSource IsNot Nothing Then
            FinancialSource.EntityBankAccounts.Add(Me)

            FinancialSourceId = FinancialSource.Id
        ElseIf Not skipKeys Then
            FinancialSourceId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("FinancialSource") AndAlso
                ChangeTracker.OriginalValues("FinancialSource") Is FinancialSource Then
                ChangeTracker.OriginalValues.Remove("FinancialSource")
            Else
                ChangeTracker.RecordOriginalValue("FinancialSource", previousValue)
            End If
            If FinancialSource IsNot Nothing AndAlso Not FinancialSource.ChangeTracker.ChangeTrackingEnabled Then
                FinancialSource.StartTracking()
            End If
        End If
    End Sub

