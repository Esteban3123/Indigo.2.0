#Region "Association Fixup"

    Private Sub FixupOperatingUnit(ByVal previousValue As OperatingUnit)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.SettingInventory.Contains(Me) Then
            previousValue.SettingInventory.Remove(Me)
        End If

        If OperatingUnit IsNot Nothing Then
            OperatingUnit.SettingInventory.Add(Me)

            OperatingUnitId = OperatingUnit.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("OperatingUnit") AndAlso
                ChangeTracker.OriginalValues("OperatingUnit") Is OperatingUnit Then
                ChangeTracker.OriginalValues.Remove("OperatingUnit")
            Else
                ChangeTracker.RecordOriginalValue("OperatingUnit", previousValue)
            End If
            If OperatingUnit IsNot Nothing AndAlso Not OperatingUnit.ChangeTracker.ChangeTrackingEnabled Then
                OperatingUnit.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupThirdParty(ByVal previousValue As ThirdParty)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.SettingInventory.Contains(Me) Then
            previousValue.SettingInventory.Remove(Me)
        End If

        If ThirdParty IsNot Nothing Then
            ThirdParty.SettingInventory.Add(Me)

            TransferOrderThirdPartyId = ThirdParty.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ThirdParty") AndAlso
                ChangeTracker.OriginalValues("ThirdParty") Is ThirdParty Then
                ChangeTracker.OriginalValues.Remove("ThirdParty")
