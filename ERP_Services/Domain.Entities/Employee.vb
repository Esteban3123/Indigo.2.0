        If e.OldItems IsNot Nothing Then
            For Each item As BranchOffice In e.OldItems
                If item.Employee Is Me Then
                    item.Employee = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("BranchOffice", item)
                End If
            Next
        End If
    End Sub

    Private Sub FixupTransportationAssistant(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As TransportationAssistant In e.NewItems
                item.Employee = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("TransportationAssistant", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As TransportationAssistant In e.OldItems
                If item.Employee Is Me Then
                    item.Employee = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("TransportationAssistant", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

