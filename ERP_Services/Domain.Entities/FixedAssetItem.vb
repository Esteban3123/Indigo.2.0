    Private Sub FixupFixedAssetItemType(ByVal previousValue As FixedAssetItemType)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.FixedAssetItem.Contains(Me) Then
            previousValue.FixedAssetItem.Remove(Me)
        End If

        If FixedAssetItemType IsNot Nothing Then
            FixedAssetItemType.FixedAssetItem.Add(Me)

            ItemTypeId = FixedAssetItemType.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("FixedAssetItemType") AndAlso
                ChangeTracker.OriginalValues("FixedAssetItemType") Is FixedAssetItemType Then
                ChangeTracker.OriginalValues.Remove("FixedAssetItemType")
            Else
                ChangeTracker.RecordOriginalValue("FixedAssetItemType", previousValue)
            End If
            If FixedAssetItemType IsNot Nothing AndAlso Not FixedAssetItemType.ChangeTracker.ChangeTrackingEnabled Then
                FixedAssetItemType.StartTracking()
            End If
        End If
    End Sub

