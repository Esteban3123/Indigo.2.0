        PersonStudy.Clear()
        FixedAssetInsurance.Clear()
        PersonDisability.Clear()
        PersonNationality.Clear()
        Phone.Clear()
        PersonProfession.Clear()
        ThirdParty.Clear()
        ADTIPOIDENTIFICA = Nothing
    End Sub

