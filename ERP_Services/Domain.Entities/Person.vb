    Private Sub FixupAddress(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As Address In e.NewItems
                item.Person = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("Address", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As Address In e.OldItems
                If item.Person Is Me Then
                    item.Person = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("Address", item)
                End If
            Next
        End If
    End Sub

