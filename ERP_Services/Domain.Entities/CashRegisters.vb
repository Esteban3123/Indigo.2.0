    Private Sub FixupCashReceipts(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As CashReceipts In e.NewItems
                item.CashRegisters = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("CashReceipts", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As CashReceipts In e.OldItems
                If item.CashRegisters Is Me Then
                    item.CashRegisters = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("CashReceipts", item)
                End If
            Next
        End If
    End Sub

