#Region "Association Fixup"

    Private Sub FixupMainAccounts(ByVal previousValue As MainAccounts, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.GeneralLedgerIVA.Contains(Me) Then
            previousValue.GeneralLedgerIVA.Remove(Me)
        End If

        If MainAccounts IsNot Nothing Then
            MainAccounts.GeneralLedgerIVA.Add(Me)

            IdAccountCreditControlFiscal = MainAccounts.Id
        ElseIf Not skipKeys Then
            IdAccountCreditControlFiscal = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("MainAccounts") AndAlso
                ChangeTracker.OriginalValues("MainAccounts") Is MainAccounts Then
                ChangeTracker.OriginalValues.Remove("MainAccounts")
            Else
                ChangeTracker.RecordOriginalValue("MainAccounts", previousValue)
            End If
            If MainAccounts IsNot Nothing AndAlso Not MainAccounts.ChangeTracker.ChangeTrackingEnabled Then
                MainAccounts.StartTracking()
            End If
        End If
    End Sub

