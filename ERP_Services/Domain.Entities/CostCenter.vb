#Region "Association Fixup"

    Private Sub FixupBranchOffice(ByVal previousValue As BranchOffice, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.CostCenter.Contains(Me) Then
            previousValue.CostCenter.Remove(Me)
        End If

        If BranchOffice IsNot Nothing Then
            BranchOffice.CostCenter.Add(Me)

            BranchOfficeId = BranchOffice.Id
        ElseIf Not skipKeys Then
            BranchOfficeId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("BranchOffice") AndAlso
                ChangeTracker.OriginalValues("BranchOffice") Is BranchOffice Then
                ChangeTracker.OriginalValues.Remove("BranchOffice")
            Else
                ChangeTracker.RecordOriginalValue("BranchOffice", previousValue)
            End If
            If BranchOffice IsNot Nothing AndAlso Not BranchOffice.ChangeTracker.ChangeTrackingEnabled Then
                BranchOffice.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupAdvancePayments(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As AdvancePayments In e.NewItems
                item.CostCenter = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("AdvancePayments", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As AdvancePayments In e.OldItems
                If item.CostCenter Is Me Then
                    item.CostCenter = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("AdvancePayments", item)
                End If
            Next
        End If
    End Sub

