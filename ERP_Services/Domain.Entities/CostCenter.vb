                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("BankAutomaticRecognitionRules", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As BankAutomaticRecognitionRules In e.OldItems
                If item.CostCenter Is Me Then
                    item.CostCenter = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("BankAutomaticRecognitionRules", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

