                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PortfolioNote In e.OldItems
                If item.PortfolioTransfer Is Me Then
                    item.PortfolioTransfer = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("PortfolioNote", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

