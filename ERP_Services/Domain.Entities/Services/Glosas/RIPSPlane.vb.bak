    Public Function AMStructure(data As List(Of SP_GenerateAMFileData_Result), CodificationType As String) As StringBuilder Implements IRIPSPlane.AMStructure
        Dim resultPlane As New StringBuilder()
        For Each item In data
            GlobalCodigoIPS = item.IPSCode

            Dim StrCodigoMedicamento = String.Empty
            Select Case CodificationType
                Case "1"
                    StrCodigoMedicamento = item.CodeCUM
                Case "2"
                    StrCodigoMedicamento = item.Code
                Case "3"
                    StrCodigoMedicamento = item.CodeAlternative
                Case "4"
                    StrCodigoMedicamento = item.CodeAlternativeTwo
            End Select

            Dim NombreMedicamento = item.DrugName
            NombreMedicamento = NombreMedicamento.Replace("á", "a")
            NombreMedicamento = NombreMedicamento.Replace("é", "e")
            NombreMedicamento = NombreMedicamento.Replace("í", "i")
            NombreMedicamento = NombreMedicamento.Replace("ó", "o")
            NombreMedicamento = NombreMedicamento.Replace("ú", "u")
            NombreMedicamento = NombreMedicamento.Replace("ñ", "n")
            NombreMedicamento = NombreMedicamento.Replace(",", ".")
            NombreMedicamento = NombreMedicamento.Replace("*", " ")
            NombreMedicamento = NombreMedicamento.Replace("-", " ")
            NombreMedicamento = NombreMedicamento.Replace("(", "")
            NombreMedicamento = NombreMedicamento.Replace(")", "")
            NombreMedicamento = NombreMedicamento.Replace("'", "")
            NombreMedicamento = NombreMedicamento.Replace("%", " ")
            NombreMedicamento = NombreMedicamento.Replace("+", " ")
            NombreMedicamento = NombreMedicamento.Replace("""", " ")

            Dim FormaFarmaceutica = item.PharmaceuticalForm
            FormaFarmaceutica = FormaFarmaceutica.Replace("á", "a")
            FormaFarmaceutica = FormaFarmaceutica.Replace("é", "e")
            FormaFarmaceutica = FormaFarmaceutica.Replace("í", "i")
            FormaFarmaceutica = FormaFarmaceutica.Replace("ó", "o")
            FormaFarmaceutica = FormaFarmaceutica.Replace("ú", "u")
            FormaFarmaceutica = FormaFarmaceutica.Replace(",", ".")

            Dim lineHead As String = ""
            lineHead &= Utils.StringPad(item.InvoiceNumber, MaxSize(item.InvoiceNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IPSCode, MaxSize(item.IPSCode, 12), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationTypeCode, MaxSize(item.IdentificationTypeCode, 2), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationNumber, MaxSize(item.IdentificationNumber.Trim(), 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.AuthorizationNumber, MaxSize(item.AuthorizationNumber.Trim(), 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(StrCodigoMedicamento, MaxSize(StrCodigoMedicamento, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.MedicationType, MaxSize(item.MedicationType, 1), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(NombreMedicamento, MaxSize(NombreMedicamento, 30), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(FormaFarmaceutica, MaxSize(FormaFarmaceutica, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Concentration.ToString().Replace(",", "."), MaxSize(item.Concentration, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.UnitMeasure, MaxSize(item.UnitMeasure, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.InvoicedQuantity, MaxSize(item.InvoicedQuantity, 5), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.TotalSalesPrice.ToString.Replace(",", "."), MaxSize(item.TotalSalesPrice.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.GrandTotalSalesPrice.ToString.Replace(",", "."), MaxSize(item.GrandTotalSalesPrice.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)

            If resultPlane.Length > 0 Then
                resultPlane.AppendLine("")
            End If
            resultPlane.Append(lineHead)
        Next
        Return resultPlane
    End Function

    Public Function CTFile(ConsecutiveRadicateInvoice As String, ListPlaneRIPS As List(Of ActionMessageResult(Of StringBuilder))) As ActionMessageResult(Of StringBuilder) Implements IRIPSPlane.CTFile
        Dim ActualMonth = Month(Date.Now).ToString()
        Dim ActualYear = Year(Date.Now)
        Dim result As New ActionMessageResult(Of StringBuilder)
        Dim resultPlane As New StringBuilder()
        Dim MonthValid As String
        Try
            If Len(ActualMonth) = 1 Then
                MonthValid = "0" & ActualMonth
            Else
                MonthValid = ActualMonth
            End If
            If ListPlaneRIPS.Count() > 0 Then
                For Each item In ListPlaneRIPS
                    If item.StateResult Then
                        Dim RegisterCount As Integer = 1 + RegularExpressions.Regex.Matches(item.ObjectEmbbeded.ToString(), Environment.NewLine).Count
                        RegisterCount = IIf(RegisterCount = 0, 1, RegisterCount)

                        Dim lineHead As String = ""
                        lineHead &= Utils.StringPad(GlobalCodigoIPS, MaxSize(GlobalCodigoIPS, 12), " ", Utils.PadType.STR_PAD_RIGHT)
                        lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
                        lineHead &= Utils.StringPad(Date.Now.ToString("dd/MM/yyyy"), MaxSize((Date.Now.ToString("dd/MM/yyyy")), 20), " ", Utils.PadType.STR_PAD_RIGHT)
                        lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
                        lineHead &= Utils.StringPad(item.Message, MaxSize(item.Message, 8), " ", Utils.PadType.STR_PAD_RIGHT)
                        lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
                        lineHead &= Utils.StringPad(RegisterCount, MaxSize(RegisterCount, 10), " ", Utils.PadType.STR_PAD_RIGHT)

                        If resultPlane.Length > 0 Then
                            resultPlane.AppendLine("")
                        End If
                        resultPlane.Append(lineHead)
                    End If
                Next
                result.Message = "CT" & ConsecutiveRadicateInvoice
                result.ObjectEmbbeded = resultPlane
                result.StateResult = True
            Else
                result.StateResult = False
            End If
        Catch ex As Exception
            result.StateResult = False
        End Try
        Return result
    End Function

#End Region

#Region "FURIPS"

    Public Function FURIPS1Structure(data As List(Of SP_GenerateFURIPS1FileData_Result)) As StringBuilder Implements IRIPSPlane.FURIPS1Structure
        Dim resultPlane As New StringBuilder()
        For Each item In data
            Dim lineHead As String = ""
            lineHead &= Utils.StringPad(item.NumeroRadicadoAnterior, MaxSize(item.NumeroRadicadoAnterior, 10), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim() ' 1
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.RespuestaGlosa, MaxSize(item.RespuestaGlosa, 1), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim() ' 2
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.NumeroFactura, MaxSize(item.NumeroFactura, 20), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim() ' 3
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ConsecutivoReclamacion, MaxSize(item.ConsecutivoReclamacion, 12), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim() ' 4
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.PrestadorServicioSalud, MaxSize(item.PrestadorServicioSalud, 12), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim() ' 5
