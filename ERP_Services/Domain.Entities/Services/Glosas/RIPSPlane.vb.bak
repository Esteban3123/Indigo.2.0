    End Function

    Public Function FURIPS2Structure(data As List(Of SP_GenerateFURIPS2FileData_Result)) As StringBuilder Implements IRIPSPlane.FURIPS2Structure
        Dim resultPlane As New StringBuilder()
        For Each item In data
            Dim lineHead As String = ""
            lineHead &= Utils.StringPad(item.NumeroFactura, MaxSize(item.NumeroFactura, 20), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Ingreso, MaxSize(item.Ingreso, 20), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Tipo, MaxSize(item.Tipo, 1), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.CodigoCUM, MaxSize(item.CodigoCUM, 15), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Descripcion, MaxSize(item.Descripcion, 40), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Cantidad, MaxSize(item.Cantidad, 15), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ValorUnitario.ToString.Replace(",", "."), MaxSize(item.ValorUnitario.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.SubTotal.ToString.Replace(",", "."), MaxSize(item.SubTotal.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Total.ToString.Replace(",", "."), MaxSize(item.Total.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT).ToString.Trim()

            If resultPlane.Length > 0 Then
                resultPlane.AppendLine("")
            End If
            resultPlane.Append(lineHead)
        Next
        Return resultPlane
    End Function

#End Region

#Region "MegaPlane"

    Public Function MegaPlaneStructure(data As List(Of SP_GenerateMegaPlaneFileData_Result)) As StringBuilder Implements IRIPSPlane.MegaPlaneStructure
        Dim resultPlane As New StringBuilder()

        Dim currentDate = DateTime.Now
        Dim header = data.FirstOrDefault()
        Dim subHeadQuantity = data.Select(Function(d) d.InvoiceId).Distinct().Count()
        Dim detailQuantity = data.Count()

        Dim lineHead As String = ""
        lineHead &= Utils.StringPad(0, 1, 0, Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(detailQuantity, 6, 0, Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(subHeadQuantity, 6, 0, Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(currentDate.ToString("dd/MM/yyyy"), 10, " ", Utils.PadType.STR_PAD_RIGHT)
        lineHead &= Utils.StringPad(header.IPSCode, 3, " ", Utils.PadType.STR_PAD_RIGHT)
        lineHead &= Utils.StringPad(header.IPSDocumentType, 2, " ", Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(header.IPSNit, 15, 0, Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(header.IPSDigitVerification, 1, 0, Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(header.IPSName, 50, " ", Utils.PadType.STR_PAD_RIGHT)
        lineHead &= Utils.StringPad(header.CustomerDocumentType, 2, " ", Utils.PadType.STR_PAD_RIGHT)
        lineHead &= Utils.StringPad(header.CustomerNit, 15, 0, Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(header.CustomerDigitVerification, 1, 0, Utils.PadType.STR_PAD_LEFT)
        lineHead &= Utils.StringPad(header.CustomerName, 50, " ", Utils.PadType.STR_PAD_RIGHT)
        resultPlane.Append(lineHead)

        For Each invoice In data.GroupBy(Function(d) d.InvoiceId).ToList()
            Dim subHeader = data.Where(Function(d) d.InvoiceId = invoice.Key).FirstOrDefault()
            Dim netValueLetters = Utils.Num2Text(subHeader.InvoiceNetValue).ToString()

            Dim lineSubHead As String = ""
            lineSubHead &= Utils.StringPad(1, 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(0, 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(subHeader.InvoiceDate, 10, " ", Utils.PadType.STR_PAD_RIGHT)
            lineSubHead &= Utils.StringPad(subHeader.InvoicePrefix, 6, " ", Utils.PadType.STR_PAD_RIGHT)
            lineSubHead &= Utils.StringPad(subHeader.InvoiceNumber, 10, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(subHeader.InvoiceGrossValue, 12, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(subHeader.InvoiceNetValue, 12, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(netValueLetters, 80, " ", Utils.PadType.STR_PAD_RIGHT)
            lineSubHead &= Utils.StringPad(0, 10, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(subHeader.InvoiceModeratingFee, 10, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(subHeader.InvoiceCopay, 10, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad("SERV", 10, " ", Utils.PadType.STR_PAD_RIGHT)
            lineSubHead &= Utils.StringPad(0, 10, 0, Utils.PadType.STR_PAD_LEFT)
            lineSubHead &= Utils.StringPad(0, 1, 0, Utils.PadType.STR_PAD_LEFT)
            resultPlane.AppendLine("")
            resultPlane.Append(lineSubHead)


            For Each detail In data.Where(Function(d) d.InvoiceId = invoice.Key).ToList()
                Dim lineDetailHead As String = ""
                lineDetailHead &= Utils.StringPad(2, 1, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailInvoiceNumber, 10, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailAuthorizationNumber.Trim(), 15, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailDocumentType, 2, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailDocumentNumber, 16, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailLastName, 25, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailFirstName, 15, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailAdmissionDate, 10, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailOutputDate, 10, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailAttentionType, 2, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailCode, 12, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailDescription, 100, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailQuantity, 6, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(0, 1, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailUnitValue, 12, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailTotalValue, 12, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailDiagnostic, 7, " ", Utils.PadType.STR_PAD_RIGHT)
                lineDetailHead &= Utils.StringPad(detail.DetailModeratingFee, 12, 0, Utils.PadType.STR_PAD_LEFT)
                lineDetailHead &= Utils.StringPad(detail.DetailCopay, 12, 0, Utils.PadType.STR_PAD_LEFT)
                resultPlane.AppendLine("")
                resultPlane.Append(lineDetailHead)
            Next
        Next
        Return resultPlane
    End Function

#End Region

    ''' <summary>
    ''' Función pra calcular el tamaño máximo del campo que utilizará el plano
    ''' </summary>
    ''' <param name="VarField">Campo</param>
    ''' <param name="MaxLength">Tamaño Máximo</param>
    ''' <returns>Integer</returns>
    ''' <remarks></remarks>
    Public Function MaxSize(VarField As String, MaxLength As Integer) As Integer
        Dim Size As Integer = 0
        If Len(VarField) < MaxLength Then
            Size = Len(VarField)
        Else
            Size = MaxLength
        End If
        Return Size
    End Function

#Region "IDisposable Support"

    Private disposedValue As Boolean ' Para detectar llamadas redundantes

    ' IDisposable
    Protected Overridable Sub Dispose(disposing As Boolean)
        If Not disposedValue Then
            If disposing Then
                ' TODO: elimine el estado administrado (objetos administrados).
            End If
            _radicateInvoiceDRepository = Nothing
            IndigoGC.Execute()
        End If
        disposedValue = True
    End Sub

    ' TODO: reemplace Finalize() solo si el anterior Dispose(disposing As Boolean) tiene código para liberar recursos no administrados.
    'Protected Overrides Sub Finalize()
    '    ' No cambie este código. Coloque el código de limpieza en el anterior Dispose(disposing As Boolean).
    '    Dispose(False)
    '    MyBase.Finalize()
    'End Sub

    ' Visual Basic agrega este código para implementar correctamente el patrón descartable.
    Public Sub Dispose() Implements IDisposable.Dispose
        ' No cambie este código. Coloque el código de limpieza en el anterior Dispose(disposing As Boolean).
        Dispose(True)
        ' TODO: quite la marca de comentario de la siguiente línea si Finalize() se ha reemplazado antes.
        GC.SuppressFinalize(Me)
    End Sub

#End Region

End Class