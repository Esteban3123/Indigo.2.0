Imports System.Configuration
Imports System.Data.SqlClient
Imports System.Text
Imports Domain.Base.Entities
Imports Domain.Entities
Imports Infrastructure.CrossCutting.Base

Public Class RIPSPlane
    Implements IRIPSPlane

    Private _radicateInvoiceDRepository As IRadicateInvoiceDRepository

    Public Sub New(radicateInvoiceDRepository As IRadicateInvoiceDRepository)
        _radicateInvoiceDRepository = radicateInvoiceDRepository
    End Sub

#Region "MegaRIPS"

    ''' <summary>
    ''' Obtiene los registros para generar el archivo plano MegaRIPS
    ''' </summary>
    ''' <param name="radicateInvoiceId">Id del radicado de la factura</param>
    ''' <returns>Lista de registros</returns>
    Public Function GetMegaRIPSByRadicateInvoiceId(radicateInvoiceId As Integer, companyCode As String, Optional invoicesList As List(Of RIPSBilling) = Nothing) As String Implements IRIPSPlane.GetMegaRIPSByRadicateInvoiceId
        Dim sBuilder As String
        Dim result As List(Of SP_GenerateMegaRIPS_Result) = Nothing
        If invoicesList IsNot Nothing AndAlso invoicesList.Any() Then
            Dim invoiceListIsStr As String = String.Join("", invoicesList.Select(Function(o) String.Format("<InvoiceIds><Id>{0}</Id></InvoiceIds>", o.InvoiceId)).ToArray())
            Try
                Dim dtResult As New DataTable()
                Using conn As New SqlConnection(String.Format(ConfigurationManager.ConnectionStrings(Infrastructure.CrossCutting.Base.ConfigurationFile.CONX_GENESIS).ConnectionString, "", ServerSessionValues.Current.CurrentContainer))
                    conn.Open()
                    Dim command As New SqlCommand("[Billing].[SP_GenerateMegaRIPSBilling]", conn)
                    command.CommandType = CommandType.StoredProcedure
                    command.Parameters.AddWithValue("InvoiceListIds", invoiceListIsStr)
                    command.Parameters.AddWithValue("companyCode", companyCode)
                    Dim resultado As SqlDataReader = command.ExecuteReader(CommandBehavior.CloseConnection)
                    dtResult.Load(resultado)
                    conn.Close()
                End Using
                'Return dtResult.Rows.Count > 0 AndAlso dtResult.Rows(0)("Resultado").ToString().Equals("1")
                If dtResult.Rows.Count > 0 Then
                    result = New List(Of SP_GenerateMegaRIPS_Result)()
                    For Each rw As DataRow In dtResult.Rows
                        Dim gm As New SP_GenerateMegaRIPS_Result()
                        Try
                            With gm
                                .Apellido = rw("Apellido")
                                .CantidadProcedi = rw("CantidadProcedi")
                                .Clasificacion_Origen = rw("Clasificacion_Origen")
                                .CodAutorizacion = If(rw("CodAutorizacion") Is DBNull.Value, Nothing, rw("CodAutorizacion"))
                                .Codigo_facturacion_principal = rw("Codigo_facturacion_principal")
                                .Cod_Contrato = rw("Cod_Contrato")
                                .Cod_Cuenta = If(rw("Cod_Cuenta") Is DBNull.Value, Nothing, rw("Cod_Cuenta"))
                                .Cod_Eps = rw("Cod_Eps")
                                .Cod_Hab_IPS = rw("Cod_Hab_IPS")
                                .Cod_procedi_Detalle = rw("Cod_procedi_Detalle")
                                .Cod_Regional = rw("Cod_Regional")
                                .Con_Des = rw("Con_Des")
                                .Copago = If(rw("Copago") Is DBNull.Value, Nothing, rw("Copago"))
                                .Descripcion_procedi = rw("Descripcion_procedi")
                                .Descuento = rw("Descuento")
                                .DiagnosticoPrincipal = rw("DiagnosticoPrincipal")
                                .DIAGNOSTICO_SECUNDARIO_1 = rw("DIAGNOSTICO_SECUNDARIO_1")
                                .DIAGNOSTICO_SECUNDARIO_2 = rw("DIAGNOSTICO_SECUNDARIO_2")
                                .Dias_Trat = rw("Dias_Trat")
                                .Discapacidad = rw("Discapacidad")
                                .Edad = If(rw("Edad") Is DBNull.Value, Nothing, rw("Edad"))
                                .Estado_Paciente = rw("Estado_Paciente")
                                .FechaProcedi = rw("FechaProcedi")
                                .FECHA_ENTRADA = rw("FECHA_ENTRADA")
                                .Fecha_Fact = rw("Fecha_Fact")
                                .FECHA_SALIDA = If(rw("FECHA_SALIDA") Is DBNull.Value, Nothing, rw("FECHA_SALIDA"))
                                .Fin_Consulta = rw("Fin_Consulta")
                                .HoraProcedi = rw("HoraProcedi")
                                .HORA_ENTRADA = rw("HORA_ENTRADA")
                                .HORA_SALIDA = rw("HORA_SALIDA")
                                .Ndoc_Paciente = rw("Ndoc_Paciente")
                                .Nombre = rw("Nombre")
                                .Nume_Fac = rw("Nume_Fac")
                                .Num_Cod_IPS = If(rw("Num_Cod_IPS") Is DBNull.Value, Nothing, rw("Num_Cod_IPS"))
                                .Periodo = rw("Periodo")
                                .Prefijo = rw("Prefijo")
                                .SegApellido = rw("SegApellido")
                                .SegNombre = rw("SegNombre")
                                .ServiceDate = rw("ServiceDate")
                                .Sexo = rw("Sexo")
                                .Tdoc_Paciente = rw("Tdoc_Paciente")
                                .TIPO_DIAG = rw("TIPO_DIAG")
                                .Tipo_Doc_IPS = rw("Tipo_Doc_IPS")
                                .Tipo_Paquete = rw("Tipo_Paquete")
                                .Tipo_Prestacion = rw("Tipo_Prestacion")
                                .Tipo_Servicio = rw("Tipo_Servicio")
                                .ValorBruto = rw("ValorBruto")
                                .ValorTotalServicio = If(rw("ValorTotalServicio") Is DBNull.Value, Nothing, rw("ValorTotalServicio"))
                                .ValorUnitario = If(rw("ValorUnitario") Is DBNull.Value, Nothing, rw("ValorUnitario"))
                                .VALOR_COMPARTIDO_PACIENTE = rw("VALOR_COMPARTIDO_PACIENTE")
                                .Valor_Copago_Compartido = rw("Valor_Copago_Compartido")
                                .VALOR_COPAGO_PACIENTE = If(rw("VALOR_COPAGO_PACIENTE") Is DBNull.Value, Nothing, rw("VALOR_COPAGO_PACIENTE"))
                                .Valor_Ico = rw("Valor_Ico")
                                .Valor_Iva = rw("Valor_Iva")
                                .Valor_Moderadora = rw("Valor_Moderadora")
                                .VALOR_MODERADORA_PACIENTE = If(rw("VALOR_MODERADORA_PACIENTE") Is DBNull.Value, Nothing, rw("VALOR_MODERADORA_PACIENTE"))
                                .Valor_Neto = rw("Valor_Neto")
                            End With
                        Catch ex As Exception
                            sBuilder = String.Empty
                        End Try

                        result.Add(gm)
                    Next
                End If
                sBuilder = String.Join(vbCrLf, (From d In result.OrderBy(Function(m) m.Codigo_facturacion_principal) Select d.FieldsToString()).ToArray())
            Catch ex As Exception
                sBuilder = String.Empty
            End Try
        Else
            result = _radicateInvoiceDRepository.GetMegaRIPSByRadicateInvoiceId(radicateInvoiceId, companyCode)
            sBuilder = String.Join(vbCrLf, (From d In result.OrderBy(Function(m) m.Codigo_facturacion_principal) Select d.FieldsToString()).ToArray())
        End If
        Return sBuilder
    End Function

#End Region

#Region "RIPS"

    Dim GlobalCodigoIPS As String

    Public Function AFStructure(data As List(Of SP_GenerateAFFileData_Result), Session As SessionValues) As StringBuilder Implements IRIPSPlane.AFStructure
        Dim NitIPS As String = Session.IndigoCompanyNit
        Dim RazonSocial As String = Session.IndigoCompanyName

        Dim resultPlane As New StringBuilder()
        For Each item In data
            GlobalCodigoIPS = item.IPSCode

            Dim lineHead As String = ""
            lineHead &= Utils.StringPad(item.IPSCode, MaxSize(item.IPSCode, 12), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(RazonSocial, MaxSize(RazonSocial, 60), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationTypeCode, MaxSize(item.IdentificationTypeCode, 2), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(NitIPS, MaxSize(NitIPS, 16), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.InvoiceNumber, MaxSize(item.InvoiceNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.InvoiceDate, MaxSize(item.InvoiceDate, 10), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.AdmissionDate, MaxSize(item.AdmissionDate, 10), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.OutputDate, MaxSize(item.OutputDate, 10), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.HealthEntityCode, MaxSize(item.HealthEntityCode, 6), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ThirdPartyName, MaxSize(item.ThirdPartyName, 30), " ", Utils.PadType.STR_PAD_RIGHT).ToString().Trim()
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ContractNumber, MaxSize(item.ContractNumber, 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.CareGroupName, MaxSize(item.CareGroupName, 30), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.PolicyNumber, MaxSize(item.PolicyNumber, 10), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.TotalPatientSalesPrice.ToString().Replace(",", "."), MaxSize(item.TotalPatientSalesPrice.ToString().Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.CommissionValue.ToString().Replace(",", "."), MaxSize(item.CommissionValue.ToString().Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.PatientDiscount.ToString().Replace(",", "."), MaxSize(item.PatientDiscount.ToString().Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ThirdPartySalesValue.ToString().Replace(",", "."), MaxSize(item.ThirdPartySalesValue.ToString().Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)

            If resultPlane.Length > 0 Then
                resultPlane.AppendLine("")
            End If
            resultPlane.Append(lineHead)
        Next
        Return resultPlane
    End Function

    Public Function USStructure(data As List(Of SP_GenerateUSFileData_Result)) As StringBuilder Implements IRIPSPlane.USStructure
        Dim lineHead As String
        Dim resultPlane As New StringBuilder()
        Dim _userType As String
        For Each item In data
            lineHead = ""
            _userType = ""
            If item.UserType = "1" OrElse item.UserType = "3" Then 'administrador o super administrador
                _userType = "1"
            Else
                _userType = "2"
            End If
            lineHead &= Utils.StringPad(item.IdentificationTypeCode, 2, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationNumber, MaxSize(item.IdentificationNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.HealthEntityCode, MaxSize(item.HealthEntityCode, 6), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(_userType, 1, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.FirstLastName, MaxSize(item.FirstLastName, 30), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.SecondLastName, MaxSize(item.SecondLastName, 30), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.FirstName, MaxSize(item.FirstName, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.SecondName, MaxSize(item.SecondName, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Age, MaxSize(item.Age, 3), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.UnitMeasureAge, 1, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Gender, 1, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Department, 2, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.City, 3, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ResidentialZone, 1, " ", Utils.PadType.STR_PAD_RIGHT)

            If resultPlane.Length > 0 Then
                resultPlane.AppendLine("")
            End If
            resultPlane.Append(lineHead)
        Next
        Return resultPlane
    End Function

    Public Function ACStructure(data As List(Of SP_GenerateACFileData_Result)) As StringBuilder Implements IRIPSPlane.ACStructure
        Dim resultPlane As New StringBuilder()
        For Each item In data
            GlobalCodigoIPS = item.IPSCode

            Dim lineHead As String = ""
            lineHead &= Utils.StringPad(item.InvoiceNumber, MaxSize(item.InvoiceNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IPSCode, MaxSize(item.IPSCode, 12), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationTypeCode, 2, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationNumber, MaxSize(item.IdentificationNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ServiceDate, MaxSize(item.ServiceDate, 10), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.AuthorizationNumber, MaxSize(item.AuthorizationNumber, 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.RIPSCode, MaxSize(item.RIPSCode, 8), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ConsultationPurpose, MaxSize(item.ConsultationPurpose, 2), "", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ExternalCause, MaxSize(item.ExternalCause, 2), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.MainDiagnosticCode, MaxSize(item.MainDiagnosticCode, 4), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.DiagnosticCodeRel1, MaxSize(item.DiagnosticCodeRel1, 4), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.DiagnosticCodeRel2, MaxSize(item.DiagnosticCodeRel2, 4), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.DiagnosticCodeRel3, MaxSize(item.DiagnosticCodeRel3, 4), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.DiagnosticType, 1, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.TotalSalesPrice.ToString().Replace(",", "."), MaxSize(item.TotalSalesPrice.ToString().Replace(",", "."), 15), "", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ModeratorFee.ToString().Replace(",", "."), MaxSize(item.ModeratorFee.ToString().Replace(",", "."), 15), "", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.NetToPay.ToString().Replace(",", "."), MaxSize(item.NetToPay.ToString().Replace(",", "."), 15), "", Utils.PadType.STR_PAD_RIGHT)

            If resultPlane.Length > 0 Then
                resultPlane.AppendLine("")
            End If
            resultPlane.Append(lineHead)
        Next
        Return resultPlane
    End Function

    Public Function APStructure(data As List(Of SP_GenerateAPFileData_Result), ServiceCode As String) As StringBuilder Implements IRIPSPlane.APStructure
        Dim resultPlane As New StringBuilder()
        For Each item In data
            GlobalCodigoIPS = item.IPSCode

            Dim StrCodigoProcedimiento = String.Empty
            Select Case ServiceCode
                Case "1"
                    StrCodigoProcedimiento = item.RIPSCode
                Case "2"
                    StrCodigoProcedimiento = item.RIPSCode
                Case "3"
                    StrCodigoProcedimiento = item.ManualRateCode
            End Select

            Dim lineHead As String = ""
            lineHead &= Utils.StringPad(item.InvoiceNumber, MaxSize(item.InvoiceNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IPSCode, MaxSize(item.IPSCode, 12), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationTypeCode, MaxSize(item.IdentificationTypeCode, 2), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationNumber, MaxSize(item.IdentificationNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ServiceDate, MaxSize(item.ServiceDate, 10), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.AuthorizationNumber, MaxSize(item.AuthorizationNumber, 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(StrCodigoProcedimiento, MaxSize(StrCodigoProcedimiento, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ScopeRealization, MaxSize(item.ScopeRealization, 1), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.ProcedutePurpose, MaxSize(item.ProcedutePurpose, 1), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.PersonalService, MaxSize(item.PersonalService, 1), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.MainDiagnosticCode, MaxSize(item.MainDiagnosticCode, 4), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.MainDiagnosticCode, MaxSize(item.MainDiagnosticCode, 4), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.Complication, MaxSize(item.Complication, 4), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.FormSurgicalAct, MaxSize(item.FormSurgicalAct, 1), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.TotalSalesPrice.ToString.Replace(",", "."), MaxSize(item.TotalSalesPrice.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)

            If resultPlane.Length > 0 Then
                resultPlane.AppendLine("")
            End If
            resultPlane.Append(lineHead)
        Next
        Return resultPlane
    End Function

    Public Function ATStructure(data As List(Of SP_GenerateATFileData_Result), ServiceCode As String) As StringBuilder Implements IRIPSPlane.ATStructure
        Dim resultPlane As New StringBuilder()
        For Each item In data
            Dim StrCodigoProcedimiento As String = ""
            Dim StrNombreServicio As String = ""
            Select Case ServiceCode
                Case "1"
                    StrCodigoProcedimiento = item.RIPSCode.ToString.Trim
                    StrNombreServicio = item.CUPSDescription.ToString.Trim
                Case "2"
                    StrCodigoProcedimiento = item.CUPSCode.ToString.Trim
                    StrNombreServicio = item.CUPSDescription.ToString.Trim
                Case "3"
                    StrCodigoProcedimiento = item.ManualRateCode.ToString.Trim
                    StrNombreServicio = item.ManualRateName.ToString.Trim
                Case "4"
                    StrCodigoProcedimiento = item.CUPSCode.ToString.Trim
                    StrNombreServicio = If(String.IsNullOrEmpty(item.ContractDescriptionName), item.CUPSDescription.ToString.Trim, item.ContractDescriptionName.ToString.Trim)
                Case "5"
                    StrCodigoProcedimiento = item.CUPSCode.ToString.Trim
                    StrNombreServicio = If(String.IsNullOrEmpty(item.ContractDescriptionName), item.CUPSDescription.ToString.Trim, item.CUPSDescription.ToString.Trim + " " + item.ContractDescriptionName.ToString.Trim)
            End Select
            StrNombreServicio = StrNombreServicio.Replace(",", ".")
            StrNombreServicio = StrNombreServicio.Replace("*", " ")
            StrNombreServicio = StrNombreServicio.Replace("-", " ")
            StrNombreServicio = StrNombreServicio.Replace("(", "")
            StrNombreServicio = StrNombreServicio.Replace(")", "")
            StrNombreServicio = StrNombreServicio.Replace("'", "")
            StrNombreServicio = StrNombreServicio.Replace("%", " ")
            StrNombreServicio = StrNombreServicio.Replace("+", " ")
            StrNombreServicio = StrNombreServicio.Replace("""", " ")
            StrNombreServicio = StrNombreServicio.Replace("á", "a")
            StrNombreServicio = StrNombreServicio.Replace("é", "e")
            StrNombreServicio = StrNombreServicio.Replace("í", "i")
            StrNombreServicio = StrNombreServicio.Replace("ó", "o")
            StrNombreServicio = StrNombreServicio.Replace("ú", "u")
            StrNombreServicio = StrNombreServicio.Replace("Á", "A")
            StrNombreServicio = StrNombreServicio.Replace("É", "E")
            StrNombreServicio = StrNombreServicio.Replace("Í", "I")
            StrNombreServicio = StrNombreServicio.Replace("Ó", "O")
            StrNombreServicio = StrNombreServicio.Replace("Ú", "U")
            StrNombreServicio = StrNombreServicio.CleanSpecialChars()

            Dim lineHead As String = ""
            lineHead &= Utils.StringPad(item.InvoiceNumber, MaxSize(item.InvoiceNumber, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IPSCode, MaxSize(item.IPSCode, 12), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationTypeCode, MaxSize(item.IdentificationTypeCode, 2), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.IdentificationNumber, MaxSize(item.IdentificationNumber.Trim(), 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.AuthorizationNumber, MaxSize(item.AuthorizationNumber, 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.TypeService, MaxSize(item.TypeService, 1), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(StrCodigoProcedimiento, MaxSize(StrCodigoProcedimiento, 20), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(StrNombreServicio, MaxSize(StrNombreServicio, 60), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.InvoicedQuantity, item.InvoicedQuantity.ToString.Length, " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.TotalSalesPrice.ToString.Replace(",", "."), MaxSize(item.TotalSalesPrice.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)
            lineHead &= Utils.StringPad(",", 1, 0, Utils.PadType.STR_PAD_LEFT)
            lineHead &= Utils.StringPad(item.GrandTotalSalesPrice.ToString.Replace(",", "."), MaxSize(item.GrandTotalSalesPrice.ToString.Replace(",", "."), 15), " ", Utils.PadType.STR_PAD_RIGHT)

            If resultPlane.Length > 0 Then
                resultPlane.AppendLine("")
            End If
            resultPlane.Append(lineHead)
        Next
        Return resultPlane
    End Function

