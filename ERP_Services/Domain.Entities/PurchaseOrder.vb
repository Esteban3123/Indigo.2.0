    Private Sub FixupWarehouse(ByVal previousValue As Warehouse, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.PurchaseOrder.Contains(Me) Then
            previousValue.PurchaseOrder.Remove(Me)
        End If

        If Warehouse IsNot Nothing Then
            Warehouse.PurchaseOrder.Add(Me)

            WarehouseId = Warehouse.Id
        ElseIf Not skipKeys Then
            WarehouseId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Warehouse") AndAlso
                ChangeTracker.OriginalValues("Warehouse") Is Warehouse Then
                ChangeTracker.OriginalValues.Remove("Warehouse")
            Else
                ChangeTracker.RecordOriginalValue("Warehouse", previousValue)
            End If
            If Warehouse IsNot Nothing AndAlso Not Warehouse.ChangeTracker.ChangeTrackingEnabled Then
                Warehouse.StartTracking()
            End If
        End If
    End Sub

