    Private Sub FixupPurchaseOrderDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As PurchaseOrderDetail In e.NewItems
                item.PurchaseOrder = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("PurchaseOrderDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PurchaseOrderDetail In e.OldItems
                If item.PurchaseOrder Is Me Then
                    item.PurchaseOrder = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("PurchaseOrderDetail", item)
                End If
            Next
        End If
    End Sub

