    Private Sub FixupCity(ByVal previousValue As City)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Supplier.Contains(Me) Then
            previousValue.Supplier.Remove(Me)
        End If

        If City IsNot Nothing Then
            City.Supplier.Add(Me)

            IdCity = City.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("City") AndAlso
                ChangeTracker.OriginalValues("City") Is City Then
                ChangeTracker.OriginalValues.Remove("City")
            Else
                ChangeTracker.RecordOriginalValue("City", previousValue)
            End If
            If City IsNot Nothing AndAlso Not City.ChangeTracker.ChangeTrackingEnabled Then
                City.StartTracking()
            End If
        End If
    End Sub

