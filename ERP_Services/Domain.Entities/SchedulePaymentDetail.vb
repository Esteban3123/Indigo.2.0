        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.SchedulePaymentDetail.Contains(Me) Then
            previousValue.SchedulePaymentDetail.Remove(Me)
        End If

        If AccountPayable IsNot Nothing Then
            AccountPayable.SchedulePaymentDetail.Add(Me)

            AccountPayableId = AccountPayable.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("AccountPayable") AndAlso
                ChangeTracker.OriginalValues("AccountPayable") Is AccountPayable Then
                ChangeTracker.OriginalValues.Remove("AccountPayable")
            Else
                ChangeTracker.RecordOriginalValue("AccountPayable", previousValue)
            End If
            If AccountPayable IsNot Nothing AndAlso Not AccountPayable.ChangeTracker.ChangeTrackingEnabled Then
                AccountPayable.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupSchedulePaymentDetailBudget(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As SchedulePaymentDetailBudget In e.NewItems
                item.SchedulePaymentDetail = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("SchedulePaymentDetailBudget", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As SchedulePaymentDetailBudget In e.OldItems
                If item.SchedulePaymentDetail Is Me Then
                    item.SchedulePaymentDetail = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("SchedulePaymentDetailBudget", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

