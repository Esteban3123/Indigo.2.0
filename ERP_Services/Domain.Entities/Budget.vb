    Private Sub FixupBudgetHeader(ByVal previousValue As BudgetHeader)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Budget.Contains(Me) Then
            previousValue.Budget.Remove(Me)
        End If

        If BudgetHeader IsNot Nothing Then
            BudgetHeader.Budget.Add(Me)

            BudgetHeaderId = BudgetHeader.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("BudgetHeader") AndAlso
                ChangeTracker.OriginalValues("BudgetHeader") Is BudgetHeader Then
                ChangeTracker.OriginalValues.Remove("BudgetHeader")
            Else
                ChangeTracker.RecordOriginalValue("BudgetHeader", previousValue)
            End If
            If BudgetHeader IsNot Nothing AndAlso Not BudgetHeader.ChangeTracker.ChangeTrackingEnabled Then
                BudgetHeader.StartTracking()
            End If
        End If
    End Sub

