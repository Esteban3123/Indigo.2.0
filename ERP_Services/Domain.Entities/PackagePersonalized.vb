    Private Sub FixupInventoryMeasurementUnit(ByVal previousValue As InventoryMeasurementUnit, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.PackagePersonalized.Contains(Me) Then
            previousValue.PackagePersonalized.Remove(Me)
        End If

        If InventoryMeasurementUnit IsNot Nothing Then
            InventoryMeasurementUnit.PackagePersonalized.Add(Me)

            ConcentrationMeasurementUnitId = InventoryMeasurementUnit.Id
        ElseIf Not skipKeys Then
            ConcentrationMeasurementUnitId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("InventoryMeasurementUnit") AndAlso
                ChangeTracker.OriginalValues("InventoryMeasurementUnit") Is InventoryMeasurementUnit Then
                ChangeTracker.OriginalValues.Remove("InventoryMeasurementUnit")
            Else
                ChangeTracker.RecordOriginalValue("InventoryMeasurementUnit", previousValue)
            End If
            If InventoryMeasurementUnit IsNot Nothing AndAlso Not InventoryMeasurementUnit.ChangeTracker.ChangeTrackingEnabled Then
                InventoryMeasurementUnit.StartTracking()
            End If
        End If
    End Sub

