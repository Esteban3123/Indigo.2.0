    Private Sub FixupPackagePersonalizedDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As PackagePersonalizedDetail In e.NewItems
                item.PackagePersonalized = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("PackagePersonalizedDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PackagePersonalizedDetail In e.OldItems
                If item.PackagePersonalized Is Me Then
                    item.PackagePersonalized = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("PackagePersonalizedDetail", item)
                End If
            Next
        End If
    End Sub

