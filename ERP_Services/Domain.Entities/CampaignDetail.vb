    Private Sub FixupCampaign(ByVal previousValue As Campaign)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.CampaignDetail.Contains(Me) Then
            previousValue.CampaignDetail.Remove(Me)
        End If

        If Campaign IsNot Nothing Then
            Campaign.CampaignDetail.Add(Me)

            CampaignId = Campaign.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Campaign") AndAlso
                ChangeTracker.OriginalValues("Campaign") Is Campaign Then
                ChangeTracker.OriginalValues.Remove("Campaign")
            Else
                ChangeTracker.RecordOriginalValue("Campaign", previousValue)
            End If
            If Campaign IsNot Nothing AndAlso Not Campaign.ChangeTracker.ChangeTrackingEnabled Then
                Campaign.StartTracking()
            End If
        End If
    End Sub

