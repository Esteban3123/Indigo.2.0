    Private Sub FixupPharmaceuticalDispensingDetailBatchSerial(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As PharmaceuticalDispensingDetailBatchSerial In e.NewItems
                item.PharmaceuticalDispensingDetail = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("PharmaceuticalDispensingDetailBatchSerial", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PharmaceuticalDispensingDetailBatchSerial In e.OldItems
                If item.PharmaceuticalDispensingDetail Is Me Then
                    item.PharmaceuticalDispensingDetail = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("PharmaceuticalDispensingDetailBatchSerial", item)
                End If
            Next
        End If
    End Sub

