    Private Sub FixupInvoiceDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As InvoiceDetail In e.NewItems
                item.Invoice = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("InvoiceDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As InvoiceDetail In e.OldItems
                If item.Invoice Is Me Then
                    item.Invoice = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("InvoiceDetail", item)
                End If
            Next
        End If
    End Sub

