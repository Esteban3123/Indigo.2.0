                    ChangeTracker.RecordRemovalFromCollectionProperties("BillingConcept1", item)
                End If
            Next
        End If
    End Sub

    Private Sub FixupCostDistributionDirectCostDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As CostDistributionDirectCostDetail In e.NewItems
                item.RetentionConcepts = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("CostDistributionDirectCostDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As CostDistributionDirectCostDetail In e.OldItems
                If item.RetentionConcepts Is Me Then
                    item.RetentionConcepts = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("CostDistributionDirectCostDetail", item)
                End If
            Next
        End If
    End Sub

