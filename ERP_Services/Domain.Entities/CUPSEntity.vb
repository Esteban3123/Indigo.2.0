    Private Sub FixupCupsHomologation(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As CupsHomologation In e.NewItems
                item.CUPSEntity = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("CupsHomologation", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As CupsHomologation In e.OldItems
                If item.CUPSEntity Is Me Then
                    item.CUPSEntity = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("CupsHomologation", item)
                End If
            Next
        End If
    End Sub

