    Private Sub FixupBillingGroup(ByVal previousValue As BillingGroup)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.CUPSEntity.Contains(Me) Then
            previousValue.CUPSEntity.Remove(Me)
        End If

        If BillingGroup IsNot Nothing Then
            BillingGroup.CUPSEntity.Add(Me)

            BillingGroupId = BillingGroup.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("BillingGroup") AndAlso
                ChangeTracker.OriginalValues("BillingGroup") Is BillingGroup Then
                ChangeTracker.OriginalValues.Remove("BillingGroup")
            Else
                ChangeTracker.RecordOriginalValue("BillingGroup", previousValue)
            End If
            If BillingGroup IsNot Nothing AndAlso Not BillingGroup.ChangeTracker.ChangeTrackingEnabled Then
                BillingGroup.StartTracking()
            End If
        End If
    End Sub

