    Private Sub FixupResponsible(ByVal previousValue As Responsible, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.GlosaPortfolioGlosada.Contains(Me) Then
            previousValue.GlosaPortfolioGlosada.Remove(Me)
        End If

        If Responsible IsNot Nothing Then
            Responsible.GlosaPortfolioGlosada.Add(Me)

            ResponsibleCoordinationGlosa = Responsible.Id
        ElseIf Not skipKeys Then
            ResponsibleCoordinationGlosa = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Responsible") AndAlso
                ChangeTracker.OriginalValues("Responsible") Is Responsible Then
                ChangeTracker.OriginalValues.Remove("Responsible")
            Else
                ChangeTracker.RecordOriginalValue("Responsible", previousValue)
            End If
            If Responsible IsNot Nothing AndAlso Not Responsible.ChangeTracker.ChangeTrackingEnabled Then
                Responsible.StartTracking()
            End If
        End If
    End Sub

