    Private Sub FixupGlosaObjectionsReceptionD(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As GlosaObjectionsReceptionD In e.NewItems
                item.GlosaPortfolioGlosada = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("GlosaObjectionsReceptionD", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As GlosaObjectionsReceptionD In e.OldItems
                If item.GlosaPortfolioGlosada Is Me Then
                    item.GlosaPortfolioGlosada = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("GlosaObjectionsReceptionD", item)
                End If
            Next
        End If
