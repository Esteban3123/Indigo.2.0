    Private Sub FixupJournalVoucherTypes(ByVal previousValue As JournalVoucherTypes)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.GeneralLedgerSettings.Contains(Me) Then
            previousValue.GeneralLedgerSettings.Remove(Me)
        End If

        If JournalVoucherTypes IsNot Nothing Then
            JournalVoucherTypes.GeneralLedgerSettings.Add(Me)

            IdApprovalDocument = JournalVoucherTypes.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("JournalVoucherTypes") AndAlso
                ChangeTracker.OriginalValues("JournalVoucherTypes") Is JournalVoucherTypes Then
                ChangeTracker.OriginalValues.Remove("JournalVoucherTypes")
            Else
                ChangeTracker.RecordOriginalValue("JournalVoucherTypes", previousValue)
            End If
            If JournalVoucherTypes IsNot Nothing AndAlso Not JournalVoucherTypes.ChangeTracker.ChangeTrackingEnabled Then
                JournalVoucherTypes.StartTracking()
            End If
        End If
    End Sub

