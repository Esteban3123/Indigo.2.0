                item.Customer = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("BasicBilling", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As BasicBilling In e.OldItems
                If item.Customer Is Me Then
                    item.Customer = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("BasicBilling", item)
                End If
            Next
