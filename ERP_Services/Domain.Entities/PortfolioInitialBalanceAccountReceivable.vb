    Private Sub FixupPortfolioInitialBalanceAccountReceivableAccounting(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As PortfolioInitialBalanceAccountReceivableAccounting In e.NewItems
                item.PortfolioInitialBalanceAccountReceivable = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("PortfolioInitialBalanceAccountReceivableAccounting", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PortfolioInitialBalanceAccountReceivableAccounting In e.OldItems
                If item.PortfolioInitialBalanceAccountReceivable Is Me Then
                    item.PortfolioInitialBalanceAccountReceivable = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("PortfolioInitialBalanceAccountReceivableAccounting", item)
                End If
            Next
        End If
    End Sub

