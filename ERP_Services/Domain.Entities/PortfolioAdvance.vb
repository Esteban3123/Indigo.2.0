    Private Sub FixupInvoicePortfolioAdvance(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As InvoicePortfolioAdvance In e.NewItems
                item.PortfolioAdvance = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("InvoicePortfolioAdvance", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As InvoicePortfolioAdvance In e.OldItems
                If item.PortfolioAdvance Is Me Then
                    item.PortfolioAdvance = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("InvoicePortfolioAdvance", item)
                End If
            Next
        End If
    End Sub

