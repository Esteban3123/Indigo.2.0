    Private Sub FixupSeller(ByVal previousValue As Seller, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.PortfolioAdvance.Contains(Me) Then
            previousValue.PortfolioAdvance.Remove(Me)
        End If

        If Seller IsNot Nothing Then
            Seller.PortfolioAdvance.Add(Me)

            SellerId = Seller.Id
        ElseIf Not skipKeys Then
            SellerId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Seller") AndAlso
                ChangeTracker.OriginalValues("Seller") Is Seller Then
                ChangeTracker.OriginalValues.Remove("Seller")
            Else
                ChangeTracker.RecordOriginalValue("Seller", previousValue)
            End If
            If Seller IsNot Nothing AndAlso Not Seller.ChangeTracker.ChangeTrackingEnabled Then
                Seller.StartTracking()
            End If
        End If
    End Sub

