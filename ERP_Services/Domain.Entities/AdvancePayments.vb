                item.AdvancePayments = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("PaymentNotesAccountPayableAdvance", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PaymentNotesAccountPayableAdvance In e.OldItems
                If item.AdvancePayments Is Me Then
