            previousValue.Category1.Remove(Me)
        End If

        If Category2 IsNot Nothing Then
            Category2.Category1.Add(Me)

            CategoryOwnerId = Category2.Id
        ElseIf Not skipKeys Then
            CategoryOwnerId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Category2") AndAlso
                ChangeTracker.OriginalValues("Category2") Is Category2 Then
                ChangeTracker.OriginalValues.Remove("Category2")
