    Private Sub FixupCategory1(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As Category In e.NewItems
                item.Category2 = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("Category1", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As Category In e.OldItems
                If item.Category2 Is Me Then
                    item.Category2 = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("Category1", item)
                End If
            Next
        End If
    End Sub

