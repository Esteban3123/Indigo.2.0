    Private Sub FixupInventoryContract(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As InventoryContract In e.NewItems
                item.SuppliersDistributionLines = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("InventoryContract", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As InventoryContract In e.OldItems
                If item.SuppliersDistributionLines Is Me Then
                    item.SuppliersDistributionLines = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("InventoryContract", item)
                End If
            Next
        End If
    End Sub

