    Private Sub FixupDistributionLines(ByVal previousValue As DistributionLines)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.SuppliersDistributionLines.Contains(Me) Then
            previousValue.SuppliersDistributionLines.Remove(Me)
        End If

        If DistributionLines IsNot Nothing Then
            DistributionLines.SuppliersDistributionLines.Add(Me)

            IdDistributionLine = DistributionLines.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("DistributionLines") AndAlso
                ChangeTracker.OriginalValues("DistributionLines") Is DistributionLines Then
                ChangeTracker.OriginalValues.Remove("DistributionLines")
            Else
                ChangeTracker.RecordOriginalValue("DistributionLines", previousValue)
            End If
            If DistributionLines IsNot Nothing AndAlso Not DistributionLines.ChangeTracker.ChangeTrackingEnabled Then
                DistributionLines.StartTracking()
            End If
        End If
    End Sub

