    Private Sub FixupAgesPortfolio(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As AgesPortfolio In e.NewItems
                item.SettingPortfolio = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("AgesPortfolio", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As AgesPortfolio In e.OldItems
                If item.SettingPortfolio Is Me Then
                    item.SettingPortfolio = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("AgesPortfolio", item)
                End If
            Next
        End If
    End Sub

