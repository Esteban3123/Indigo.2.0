    Private Sub FixupBillingAuthorization(ByVal previousValue As BillingAuthorization, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.RevenueControlDetail.Contains(Me) Then
            previousValue.RevenueControlDetail.Remove(Me)
        End If

        If BillingAuthorization IsNot Nothing Then
            BillingAuthorization.RevenueControlDetail.Add(Me)

            BillingAuthorizationId = BillingAuthorization.Id
        ElseIf Not skipKeys Then
            BillingAuthorizationId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("BillingAuthorization") AndAlso
                ChangeTracker.OriginalValues("BillingAuthorization") Is BillingAuthorization Then
                ChangeTracker.OriginalValues.Remove("BillingAuthorization")
            Else
                ChangeTracker.RecordOriginalValue("BillingAuthorization", previousValue)
            End If
            If BillingAuthorization IsNot Nothing AndAlso Not BillingAuthorization.ChangeTracker.ChangeTrackingEnabled Then
                BillingAuthorization.StartTracking()
            End If
        End If
    End Sub

