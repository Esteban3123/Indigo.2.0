    Private Sub FixupInvoice(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As Invoice In e.NewItems
                item.RevenueControlDetail = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("Invoice", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As Invoice In e.OldItems
                If item.RevenueControlDetail Is Me Then
                    item.RevenueControlDetail = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("Invoice", item)
                End If
            Next
        End If
    End Sub

