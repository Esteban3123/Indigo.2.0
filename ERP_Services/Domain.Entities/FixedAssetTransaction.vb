    Private Sub FixupFixedAssetTransactionDetail(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As FixedAssetTransactionDetail In e.NewItems
                item.FixedAssetTransaction = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("FixedAssetTransactionDetail", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As FixedAssetTransactionDetail In e.OldItems
                If item.FixedAssetTransaction Is Me Then
                    item.FixedAssetTransaction = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("FixedAssetTransactionDetail", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

