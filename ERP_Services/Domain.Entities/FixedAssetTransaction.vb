            End If
            If ThirdParty IsNot Nothing AndAlso Not ThirdParty.ChangeTracker.ChangeTrackingEnabled Then
                ThirdParty.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupSupplier(ByVal previousValue As Supplier, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.FixedAssetTransaction.Contains(Me) Then
            previousValue.FixedAssetTransaction.Remove(Me)
        End If

        If Supplier IsNot Nothing Then
            Supplier.FixedAssetTransaction.Add(Me)

            SupplierId = Supplier.Id
        ElseIf Not skipKeys Then
            SupplierId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Supplier") AndAlso
                ChangeTracker.OriginalValues("Supplier") Is Supplier Then
                ChangeTracker.OriginalValues.Remove("Supplier")
            Else
                ChangeTracker.RecordOriginalValue("Supplier", previousValue)
            End If
            If Supplier IsNot Nothing AndAlso Not Supplier.ChangeTracker.ChangeTrackingEnabled Then
                Supplier.StartTracking()
            End If
        End If
    End Sub

