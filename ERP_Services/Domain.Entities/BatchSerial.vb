#Region "Association Fixup"

    Private Sub FixupInventoryProduct(ByVal previousValue As InventoryProduct)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.BatchSerial.Contains(Me) Then
            previousValue.BatchSerial.Remove(Me)
        End If

        If InventoryProduct IsNot Nothing Then
            InventoryProduct.BatchSerial.Add(Me)

            ProductId = InventoryProduct.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("InventoryProduct") AndAlso
                ChangeTracker.OriginalValues("InventoryProduct") Is InventoryProduct Then
                ChangeTracker.OriginalValues.Remove("InventoryProduct")
            Else
                ChangeTracker.RecordOriginalValue("InventoryProduct", previousValue)
            End If
            If InventoryProduct IsNot Nothing AndAlso Not InventoryProduct.ChangeTracker.ChangeTrackingEnabled Then
                InventoryProduct.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupEntranceVoucherDetailBatchSerial(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As EntranceVoucherDetailBatchSerial In e.NewItems
                item.BatchSerial = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("EntranceVoucherDetailBatchSerial", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As EntranceVoucherDetailBatchSerial In e.OldItems
                If item.BatchSerial Is Me Then
                    item.BatchSerial = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("EntranceVoucherDetailBatchSerial", item)
                End If
            Next
        End If
    End Sub

