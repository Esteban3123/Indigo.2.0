    Private Sub FixupVoucherTransactionDetails1(ByVal previousValue As VoucherTransactionDetails)
        If previousValue IsNot Nothing Then
            RemoveHandler ChangeTracker.ObjectStateChanging, AddressOf previousValue.HandleCascadeDelete
        End If

        If VoucherTransactionDetails1 IsNot Nothing Then
            AddHandler ChangeTracker.ObjectStateChanging, AddressOf VoucherTransactionDetails1.HandleCascadeDelete
        End If
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.VoucherTransactionDetails2 Is Me Then
            previousValue.VoucherTransactionDetails2 = Nothing
        End If

        If VoucherTransactionDetails1 IsNot Nothing Then
            VoucherTransactionDetails1.VoucherTransactionDetails2 = Me
        End If

        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("VoucherTransactionDetails1") AndAlso
                ChangeTracker.OriginalValues("VoucherTransactionDetails1") Is VoucherTransactionDetails1 Then
                ChangeTracker.OriginalValues.Remove("VoucherTransactionDetails1")
            Else
                ChangeTracker.RecordOriginalValue("VoucherTransactionDetails1", previousValue)
                ' Delete the dependent end of this identifying association. If the current state is Added,
                ' allow the relationship to be changed without causing the dependent to be deleted.
                If previousValue IsNot Nothing AndAlso previousValue.ChangeTracker.State <> ObjectState.Added Then
                    previousValue.MarkAsDeleted()
                End If
            End If
            If VoucherTransactionDetails1 IsNot Nothing AndAlso Not VoucherTransactionDetails1.ChangeTracker.ChangeTrackingEnabled Then
                VoucherTransactionDetails1.StartTracking()
            End If
        End If
    End Sub

