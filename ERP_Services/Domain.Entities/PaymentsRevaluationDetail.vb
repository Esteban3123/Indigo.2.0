                ChangeTracker.OriginalValues.Remove("AccountPayable")
            Else
                ChangeTracker.RecordOriginalValue("AccountPayable", previousValue)
            End If
            If AccountPayable IsNot Nothing AndAlso Not AccountPayable.ChangeTracker.ChangeTrackingEnabled Then
                AccountPayable.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupDeferredCausation(ByVal previousValue As DeferredCausation, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.PaymentsRevaluationDetail.Contains(Me) Then
            previousValue.PaymentsRevaluationDetail.Remove(Me)
        End If

        If DeferredCausation IsNot Nothing Then
            DeferredCausation.PaymentsRevaluationDetail.Add(Me)

            DeferredCausationId = DeferredCausation.Id
        ElseIf Not skipKeys Then
            DeferredCausationId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("DeferredCausation") AndAlso
                ChangeTracker.OriginalValues("DeferredCausation") Is DeferredCausation Then
                ChangeTracker.OriginalValues.Remove("DeferredCausation")
            Else
                ChangeTracker.RecordOriginalValue("DeferredCausation", previousValue)
            End If
            If DeferredCausation IsNot Nothing AndAlso Not DeferredCausation.ChangeTracker.ChangeTrackingEnabled Then
                DeferredCausation.StartTracking()
            End If
        End If
    End Sub

#End Region

End Class

