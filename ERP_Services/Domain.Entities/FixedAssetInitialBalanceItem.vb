            If Supplier IsNot Nothing AndAlso Not Supplier.ChangeTracker.ChangeTrackingEnabled Then
                Supplier.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupFixedAssetResponsible(ByVal previousValue As FixedAssetResponsible)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.FixedAssetInitialBalanceItem.Contains(Me) Then
            previousValue.FixedAssetInitialBalanceItem.Remove(Me)
        End If

        If FixedAssetResponsible IsNot Nothing Then
            FixedAssetResponsible.FixedAssetInitialBalanceItem.Add(Me)

            ResponsibleId = FixedAssetResponsible.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("FixedAssetResponsible") AndAlso
                ChangeTracker.OriginalValues("FixedAssetResponsible") Is FixedAssetResponsible Then
                ChangeTracker.OriginalValues.Remove("FixedAssetResponsible")
            Else
                ChangeTracker.RecordOriginalValue("FixedAssetResponsible", previousValue)
            End If
            If FixedAssetResponsible IsNot Nothing AndAlso Not FixedAssetResponsible.ChangeTracker.ChangeTrackingEnabled Then
                FixedAssetResponsible.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupFixedAssetInitialBalanceItemDetailBook(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As FixedAssetInitialBalanceItemDetailBook In e.NewItems
                item.FixedAssetInitialBalanceItem = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("FixedAssetInitialBalanceItemDetailBook", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As FixedAssetInitialBalanceItemDetailBook In e.OldItems
                If item.FixedAssetInitialBalanceItem Is Me Then
                    item.FixedAssetInitialBalanceItem = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("FixedAssetInitialBalanceItemDetailBook", item)
                End If
            Next
        End If
    End Sub

