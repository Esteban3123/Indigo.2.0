    Private Sub FixupCostOrganizationalStructureOfCosts(ByVal previousValue As CostOrganizationalStructureOfCosts)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.CostProductionCenter.Contains(Me) Then
            previousValue.CostProductionCenter.Remove(Me)
        End If

        If CostOrganizationalStructureOfCosts IsNot Nothing Then
            CostOrganizationalStructureOfCosts.CostProductionCenter.Add(Me)

            OrganizationalStructureOfCostId = CostOrganizationalStructureOfCosts.Id
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("CostOrganizationalStructureOfCosts") AndAlso
                ChangeTracker.OriginalValues("CostOrganizationalStructureOfCosts") Is CostOrganizationalStructureOfCosts Then
                ChangeTracker.OriginalValues.Remove("CostOrganizationalStructureOfCosts")
            Else
                ChangeTracker.RecordOriginalValue("CostOrganizationalStructureOfCosts", previousValue)
            End If
            If CostOrganizationalStructureOfCosts IsNot Nothing AndAlso Not CostOrganizationalStructureOfCosts.ChangeTracker.ChangeTrackingEnabled Then
                CostOrganizationalStructureOfCosts.StartTracking()
            End If
        End If
    End Sub

