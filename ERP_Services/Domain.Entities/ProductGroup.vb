#Region "Association Fixup"

    Private Sub FixupBudget(ByVal previousValue As Budget, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.ProductGroup.Contains(Me) Then
            previousValue.ProductGroup.Remove(Me)
        End If

        If Budget IsNot Nothing Then
            Budget.ProductGroup.Add(Me)

            BudgetId = Budget.Id
        ElseIf Not skipKeys Then
            BudgetId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("Budget") AndAlso
                ChangeTracker.OriginalValues("Budget") Is Budget Then
                ChangeTracker.OriginalValues.Remove("Budget")
            Else
                ChangeTracker.RecordOriginalValue("Budget", previousValue)
            End If
            If Budget IsNot Nothing AndAlso Not Budget.ChangeTracker.ChangeTrackingEnabled Then
                Budget.StartTracking()
            End If
        End If
    End Sub

