    Private Sub FixupFixedAssetRemissionEntranceItem(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As FixedAssetRemissionEntranceItem In e.NewItems
                item.FixedAssetPurchaseOrderItem = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("FixedAssetRemissionEntranceItem", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As FixedAssetRemissionEntranceItem In e.OldItems
                If item.FixedAssetPurchaseOrderItem Is Me Then
                    item.FixedAssetPurchaseOrderItem = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("FixedAssetRemissionEntranceItem", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

