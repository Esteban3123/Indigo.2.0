                ChangeTracker.OriginalValues.Remove("ADINGRESO")
            Else
                ChangeTracker.RecordOriginalValue("ADINGRESO", previousValue)
            End If
            If ADINGRESO IsNot Nothing AndAlso Not ADINGRESO.ChangeTracker.ChangeTrackingEnabled Then
                ADINGRESO.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupINPACIENT(ByVal previousValue As INPACIENT)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.HCJUNOPMH.Contains(Me) Then
            previousValue.HCJUNOPMH.Remove(Me)
        End If

        If INPACIENT IsNot Nothing Then
            INPACIENT.HCJUNOPMH.Add(Me)

            IPCODPACI = INPACIENT.IPCODPACI
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("INPACIENT") AndAlso
                ChangeTracker.OriginalValues("INPACIENT") Is INPACIENT Then
                ChangeTracker.OriginalValues.Remove("INPACIENT")
            Else
                ChangeTracker.RecordOriginalValue("INPACIENT", previousValue)
            End If
            If INPACIENT IsNot Nothing AndAlso Not INPACIENT.ChangeTracker.ChangeTrackingEnabled Then
                INPACIENT.StartTracking()
            End If
        End If
    End Sub

