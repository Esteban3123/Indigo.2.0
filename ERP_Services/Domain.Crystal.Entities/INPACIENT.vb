    Private Sub FixupADACTIVID(ByVal previousValue As ADACTIVID)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.INPACIENT.Contains(Me) Then
            previousValue.INPACIENT.Remove(Me)
        End If

        If ADACTIVID IsNot Nothing Then
            ADACTIVID.INPACIENT.Add(Me)

            CODACTIVI = ADACTIVID.codactivi
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ADACTIVID") AndAlso
                ChangeTracker.OriginalValues("ADACTIVID") Is ADACTIVID Then
                ChangeTracker.OriginalValues.Remove("ADACTIVID")
            Else
                ChangeTracker.RecordOriginalValue("ADACTIVID", previousValue)
            End If
            If ADACTIVID IsNot Nothing AndAlso Not ADACTIVID.ChangeTracker.ChangeTrackingEnabled Then
                ADACTIVID.StartTracking()
            End If
        End If
