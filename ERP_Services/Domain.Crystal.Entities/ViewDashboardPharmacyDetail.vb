            End If
        End Set
    End Property

	Private _observation As String
	<DataMember()>
	Public Property Observation() As String
        Get
            Return _observation
        End Get
        Set(ByVal value As String)
            If Not Equals(_observation, value) Then
                ChangeTracker.RecordOriginalValue("Observation", _observation)
                _observation = value
                OnPropertyChanged("Observation")
            End If
        End Set
    End Property

