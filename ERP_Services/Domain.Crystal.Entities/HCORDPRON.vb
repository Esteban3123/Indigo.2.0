    Private Sub FixupHCFARMEPC(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As HCFARMEPC In e.NewItems
                item.HCORDPRON = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("HCFARMEPC", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As HCFARMEPC In e.OldItems
                If item.HCORDPRON Is Me Then
                    item.HCORDPRON = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("HCFARMEPC", item)
                End If
            Next
        End If
    End Sub

