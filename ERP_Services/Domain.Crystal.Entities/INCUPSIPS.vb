    Private Sub FixupINCUPSSUB(ByVal previousValue As INCUPSSUB)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.INCUPSIPS.Contains(Me) Then
            previousValue.INCUPSIPS.Remove(Me)
        End If

        If INCUPSSUB IsNot Nothing Then
            INCUPSSUB.INCUPSIPS.Add(Me)

            CODGRUSUB = INCUPSSUB.CODGRUSUB
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("INCUPSSUB") AndAlso
                ChangeTracker.OriginalValues("INCUPSSUB") Is INCUPSSUB Then
                ChangeTracker.OriginalValues.Remove("INCUPSSUB")
            Else
                ChangeTracker.RecordOriginalValue("INCUPSSUB", previousValue)
            End If
            If INCUPSSUB IsNot Nothing AndAlso Not INCUPSSUB.ChangeTracker.ChangeTrackingEnabled Then
                INCUPSSUB.StartTracking()
            End If
        End If
    End Sub

