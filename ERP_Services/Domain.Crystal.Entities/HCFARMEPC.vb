    Private Sub FixupHCFARMEPD(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As HCFARMEPD In e.NewItems
                item.HCFARMEPC = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("HCFARMEPD", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As HCFARMEPD In e.OldItems
                If item.HCFARMEPC Is Me Then
                    item.HCFARMEPC = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("HCFARMEPD", item)
                End If
            Next
        End If
    End Sub

