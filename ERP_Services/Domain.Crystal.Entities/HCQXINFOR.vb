        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.HCQXINFOR.Contains(Me) Then
            previousValue.HCQXINFOR.Remove(Me)
        End If

        If ADCENATEN IsNot Nothing Then
            ADCENATEN.HCQXINFOR.Add(Me)

            CODCENATE = ADCENATEN.CODCENATE
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ADCENATEN") AndAlso
                ChangeTracker.OriginalValues("ADCENATEN") Is ADCENATEN Then
                ChangeTracker.OriginalValues.Remove("ADCENATEN")
            Else
                ChangeTracker.RecordOriginalValue("ADCENATEN", previousValue)
            End If
            If ADCENATEN IsNot Nothing AndAlso Not ADCENATEN.ChangeTracker.ChangeTrackingEnabled Then
                ADCENATEN.StartTracking()
            End If
        End If
    End Sub

