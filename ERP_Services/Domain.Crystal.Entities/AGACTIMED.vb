    End Sub

#End Region

#Region "Association Fixup"

    Private Sub FixupINCUPSIPS(ByVal previousValue As INCUPSIPS, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.AGACTIMED.Contains(Me) Then
            previousValue.AGACTIMED.Remove(Me)
        End If

        If INCUPSIPS IsNot Nothing Then
            INCUPSIPS.AGACTIMED.Add(Me)

            CODSERIPS = INCUPSIPS.CODSERIPS
        ElseIf Not skipKeys Then
            CODSERIPS = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("INCUPSIPS") AndAlso
                ChangeTracker.OriginalValues("INCUPSIPS") Is INCUPSIPS Then
                ChangeTracker.OriginalValues.Remove("INCUPSIPS")
            Else
                ChangeTracker.RecordOriginalValue("INCUPSIPS", previousValue)
            End If
            If INCUPSIPS IsNot Nothing AndAlso Not INCUPSIPS.ChangeTracker.ChangeTrackingEnabled Then
                INCUPSIPS.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupAGASICITA(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As AGASICITA In e.NewItems
                item.AGACTIMED = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("AGASICITA", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As AGASICITA In e.OldItems
                If item.AGACTIMED Is Me Then
                    item.AGACTIMED = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("AGASICITA", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class

