        MyBase.SaveChanges()
        Dim itemsToRefresh As IEnumerable(Of Object) = CType(Me, IObjectContextAdapter).ObjectContext.ObjectStateManager.GetObjectStateEntries(EntityState.Modified).Where(Function(ose) Not ose.IsRelationship AndAlso ose.Entity IsNot Nothing).[Select](Function(ose) ose.Entity)
        CType(Me, IObjectContextAdapter).ObjectContext.Refresh(RefreshMode.StoreWins, itemsToRefresh)
    End Sub

    <Obsolete("Este metodo ya esta obsoleto, por favor use el metodo GetFieldsNULL que se encuentra implementada en todos los repositorios")>
    Public Overloads Function ExecuteQueryDataSet(sqlQuery As String, nameTable As String) As DataSet Implements Domain.Base.IUnitWork.ExecuteQueryDataSet
        Dim dtDatos As New DataTable("CamposNULL")
        Dim conexion As New SqlConnection(ConfigurationManager.ConnectionStrings("EFConnection").ConnectionString)
        Dim query As String = "SELECT SC.NAME,SC.isnullable FROM sysobjects SO INNER JOIN syscolumns SC ON SO.ID = SC.ID WHERE so.name = '" & nameTable & "' and SCHEMA_NAME(uid) = 'Payroll' and SC.isnullable='1'"
        Dim da As SqlDataAdapter = New SqlDataAdapter(query, conexion)
        'establezco tiempos
        da.SelectCommand.CommandTimeout = 90
        Dim ds As New DataSet
        da.Fill(ds, "NULL")
        dtDatos = ds.Tables("NULL")
        conexion.Close()
        Return ds
    End Function

