    Private Sub ConfigureContainer(ByVal container As IUnityContainer, ByVal company As String)

        If company Is Nothing OrElse company.Trim().Equals(String.Empty) Then
            Throw New ArgumentNullException("company", "El argumento no puede ser nulo ni vacío en el metrodo de inyección ConfigureContainerSeguridad")
        End If

        'Registra el mapeo de los Repositorios

        ' container.RegisterType(Of IGlosasUnitOfWork, GENESISEntitiesGlosas)(New InjectionConstructor(company))
