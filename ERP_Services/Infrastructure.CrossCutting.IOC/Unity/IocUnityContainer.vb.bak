        container.RegisterType(Of IPayrollUnitOfWork, PayrollUnitOfWork)(New InjectionConstructor(company))
        container.RegisterType(Of IQueryableContext, PayrollUnitOfWork)(New InjectionConstructor(company))


        container.RegisterType(Of IDocumentalSystemUnitOfWork, GENESISDOCUMENTALEntities)(New InjectionConstructor(company))
