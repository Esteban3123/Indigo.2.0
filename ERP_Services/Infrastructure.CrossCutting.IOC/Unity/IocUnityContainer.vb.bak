''' <summary>
''' Clase con los Metodos Necesarios para la configuracion y mapeo del contenedro IoC
''' </summary>
Partial Public NotInheritable Class IocUnityContainer
    Implements IContainer

#Region "Fields"

    Private _containersDictionary As IDictionary(Of String, IUnityContainer)

#End Region

#Region "Builders"

    ''' <summary>
    ''' Crea una nueva instancia de la clase <see cref="IoCUnityContainer" />.
    ''' </summary>
    Public Sub New(Optional ByVal company As String = "")
        _containersDictionary = New Dictionary(Of String, IUnityContainer)()

        'Crea el contenedor root (raiz)
        Dim rootContainer As IUnityContainer = New UnityContainer()
        _containersDictionary.Add("RootContext", rootContainer)

        'Crea un contenedor para el contexto 'real', hijo del contenedor raiz
        Dim realAppContainer As IUnityContainer = rootContainer.CreateChildContainer()
        _containersDictionary.Add("RealAppContext", realAppContainer)

        'Crea un contenedor para pruebas, hijo del contenedor raiz
        Dim fakeAppContainer As IUnityContainer = rootContainer.CreateChildContainer()
        _containersDictionary.Add("FakeAppContext", fakeAppContainer)

        ConfigureRootContainer(rootContainer, company)
    End Sub

#End Region

#Region "Private Methods"

