    Private Sub ConfigureEHRDependencies(container As IUnityContainer)
        'Inyectamos el contexto de Crystal
        container.RegisterType(Of ICrystalModelUnitOfWork, CrystalModelUnitOfWork)(New InjectionConstructor(ServerSessionValues.Current.CurrentHISContainer))

        container.RegisterType(Of ISEGrolesuRepository, SEGrolesuRepository)(New TransientLifetimeManager)
        container.RegisterType(Of ISEGgruusuRepository, SEGgruusuRepository)(New TransientLifetimeManager)
        container.RegisterType(Of ISEGusuaruRepository, SegusuaruRepository)(New TransientLifetimeManager)
        container.RegisterType(Of IINUNIFUNCRepository, INUNIFUNCRepository)(New TransientLifetimeManager)
        container.RegisterType(Of IADCENATENRepository, ADCENATENRepository)(New TransientLifetimeManager)
        container.RegisterType(Of ISEGPermiuRepository, SEGpermiuRepository)(New TransientLifetimeManager)
        container.RegisterType(Of ISEGpermirRepository, SEGpermirRepository)(New TransientLifetimeManager)
        container.RegisterType(Of IINCUPSSUBRepository, INCUPSSUBRepository)(New TransientLifetimeManager)
    End Sub

    ''' <summary>
    ''' Configura el contenedor raiz.
    ''' Registra tipos y administradores del tiempo de vida para unity
    ''' </summary>
    ''' <param name="container">Contenedor a configurar</param>
    Private Sub ConfigureRootContainer(ByVal container As IUnityContainer, ByVal company As String)

        'Se pone para eliminar la advertencia 
        'por estar declarado y no usado
        container.ToString()

        ''configuro el contenedor de contratos
        'ConfigureContainerContratos(container)

        ''configuro el contenedor de seguridad
        'If company IsNot Nothing And company <> String.Empty Then
        '    ConfigureContainerSeguridad(container, company)
        'Else
        '    ConfigureContainerSeguridad(container)
        'End If

        ConfigureContainerSecurity(container)
        ConfigureContainer(container, If(company Is Nothing OrElse company.Trim().Equals(String.Empty), "#", company))
        ConfigureDependencies(container, If(company Is Nothing OrElse company.Trim().Equals(String.Empty), "#", company))
        ConfigureEHRDependencies(container)

        ''configuro el contenedor de transversales
        'ConfigureContainerTransversal(container)


        ''configuro el contenedor de agendamiento
        'ConfigureContainerAgendamiento(container)

        ''configuro el contenedor de admisiones
        'ConfigureContainerAdmisiones(container)

        'ConfigureContainerEnterpriseLibrary(container)

    End Sub

#End Region

#Region "IServiceFactory Members"

    ''' <summary>
    ''' Resuelve la dependencia TService
    ''' </summary>
    ''' <typeparam name="TService">Tipo de la Dependencia</typeparam>
    ''' <returns>Instancia de TService</returns>
    Public Function Resolve(Of TService)() As TService Implements IContainer.Resolve
        'We use the default container specified in AppSettings
        Dim containerName As String = ConfigurationManager.AppSettings("defaultIoCContainer")

        If [String].IsNullOrEmpty(containerName) OrElse [String].IsNullOrWhiteSpace(containerName) Then
            Throw New ArgumentNullException(Messages.exception_DefaultIOCSettings)
        End If

        If Not _containersDictionary.ContainsKey(containerName) Then
            Throw New InvalidOperationException(Messages.exception_ContainerNotFound)
        End If

        Dim container As IUnityContainer = _containersDictionary(containerName)

        Return container.Resolve(Of TService)()
    End Function

    ''' <summary>
    ''' Resuelve el Tipo del Constructor y retorna el objeto como una instancia de TService
    ''' </summary>
    ''' <param name="type"></param>
    ''' <returns>instancia del tipo pasado</returns>
    Public Function Resolve(ByVal type As Type) As Object Implements IContainer.Resolve
        'Nosotros usamos lel contenedor por defecto especificado en AppSettings del sitio WEB
        Dim containerName As String = ConfigurationManager.AppSettings("defaultIoCContainer")

        If [String].IsNullOrEmpty(containerName) OrElse [String].IsNullOrWhiteSpace(containerName) Then
            Throw New ArgumentNullException(Messages.exception_DefaultIOCSettings)
        End If

        If Not _containersDictionary.ContainsKey(containerName) Then
            Throw New InvalidOperationException(Messages.exception_ContainerNotFound)
        End If

        Dim container As IUnityContainer = _containersDictionary(containerName)

        Return container.Resolve(type, Nothing)
    End Function


    ''' <summary>
    ''' Registra un Tipo en el Localizador
    ''' </summary>
    ''' <param name="type">Tipo a registrar</param>
    Public Sub RegisterType(ByVal type As Type) Implements IContainer.RegisterType
        Dim container As IUnityContainer = Me._containersDictionary("RootContext")

        If container IsNot Nothing Then
            container.RegisterType(type, New TransientLifetimeManager())
        End If
    End Sub

    Public Shared Widening Operator CType(v As UnityContainer) As IocUnityContainer
        Throw New NotImplementedException()
    End Operator

#End Region

End Class
