        End If

        If e.OldItems IsNot Nothing Then
            For Each item As UserConfiguration In e.OldItems
                If item.Containers Is Me Then
                    item.Containers = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("UserConfiguration", item)
                End If
            Next
        End If
    End Sub

#End Region

End Class
