#Region "Association Fixup"

    Private Sub FixupServiceConfiguration(ByVal previousValue As ServiceConfiguration, Optional ByVal skipKeys As Boolean = False)
        If IsDeserializing Then
            Return
        End If

        If previousValue IsNot Nothing AndAlso previousValue.Containers.Contains(Me) Then
            previousValue.Containers.Remove(Me)
        End If

        If ServiceConfiguration IsNot Nothing Then
            ServiceConfiguration.Containers.Add(Me)

            ServiceConfigurationId = ServiceConfiguration.Id
        ElseIf Not skipKeys Then
            ServiceConfigurationId = Nothing
        End If
        If ChangeTracker.ChangeTrackingEnabled Then
            If ChangeTracker.OriginalValues.ContainsKey("ServiceConfiguration") AndAlso
                ChangeTracker.OriginalValues("ServiceConfiguration") Is ServiceConfiguration Then
                ChangeTracker.OriginalValues.Remove("ServiceConfiguration")
            Else
                ChangeTracker.RecordOriginalValue("ServiceConfiguration", previousValue)
            End If
            If ServiceConfiguration IsNot Nothing AndAlso Not ServiceConfiguration.ChangeTracker.ChangeTrackingEnabled Then
                ServiceConfiguration.StartTracking()
            End If
        End If
    End Sub

    Private Sub FixupPermissionCompany(ByVal sender As Object, ByVal e As NotifyCollectionChangedEventArgs)
        If IsDeserializing Then
            Return
        End If

        If e.NewItems IsNot Nothing Then
            For Each item As PermissionCompany In e.NewItems
                item.Containers = Me
                If ChangeTracker.ChangeTrackingEnabled Then
                    If Not item.ChangeTracker.ChangeTrackingEnabled Then
                        item.StartTracking()
                    End If
                    ChangeTracker.RecordAdditionToCollectionProperties("PermissionCompany", item)
                End If
            Next
        End If

        If e.OldItems IsNot Nothing Then
            For Each item As PermissionCompany In e.OldItems
                If item.Containers Is Me Then
                    item.Containers = Nothing
                End If
                If ChangeTracker.ChangeTrackingEnabled Then
                    ChangeTracker.RecordRemovalFromCollectionProperties("PermissionCompany", item)
                End If
            Next
        End If
    End Sub

